{
  "surah_number": 83,
  "name_arabic": "سُورَةُ المُطَفِّفِينَ",
  "name_english": "Al-Mutaffifin",
  "name_urdu": "Defrauding",
  "revelation_type": "Meccan",
  "total_ayahs": 36,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5849,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّلْمُطَفِّفِينَ",
      "urdu_text": "ناپ اور تول میں کمی کرنے والوں کے لیے خرابی ہے",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5849.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5850,
      "arabic_text": "ٱلَّذِينَ إِذَا ٱكْتَالُوا۟ عَلَى ٱلنَّاسِ يَسْتَوْفُونَ",
      "urdu_text": "جو لوگوں سے ناپ کر لیں تو پورا لیں",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5850.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5851,
      "arabic_text": "وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ",
      "urdu_text": "اور جب ان کو ناپ کر یا تول کر دیں تو کم کر دیں",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5851.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5852,
      "arabic_text": "أَلَا يَظُنُّ أُو۟لَٰٓئِكَ أَنَّهُم مَّبْعُوثُونَ",
      "urdu_text": "کیا یہ لوگ نہیں جانتے کہ اٹھائے بھی جائیں گے",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5852.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5853,
      "arabic_text": "لِيَوْمٍ عَظِيمٍۢ",
      "urdu_text": "(یعنی) ایک بڑے (سخت) دن میں",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5853.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5854,
      "arabic_text": "يَوْمَ يَقُومُ ٱلنَّاسُ لِرَبِّ ٱلْعَٰلَمِينَ",
      "urdu_text": "جس دن (تمام) لوگ رب العالمین کے سامنے کھڑے ہوں گے",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5854.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5855,
      "arabic_text": "كَلَّآ إِنَّ كِتَٰبَ ٱلْفُجَّارِ لَفِى سِجِّينٍۢ",
      "urdu_text": "سن رکھو کہ بدکارروں کے اعمال سجّین میں ہیں",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5855.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5856,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا سِجِّينٌۭ",
      "urdu_text": "اور تم کیا جانتے ہوں کہ سجّین کیا چیز ہے؟",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5856.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5857,
      "arabic_text": "كِتَٰبٌۭ مَّرْقُومٌۭ",
      "urdu_text": "ایک دفتر ہے لکھا ہوا",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5857.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5858,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "urdu_text": "اس دن جھٹلانے والوں کی خرابی ہے",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5858.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5859,
      "arabic_text": "ٱلَّذِينَ يُكَذِّبُونَ بِيَوْمِ ٱلدِّينِ",
      "urdu_text": "(یعنی) جو انصاف کے دن کو جھٹلاتے ہیں",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5859.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5860,
      "arabic_text": "وَمَا يُكَذِّبُ بِهِۦٓ إِلَّا كُلُّ مُعْتَدٍ أَثِيمٍ",
      "urdu_text": "اور اس کو جھٹلاتا وہی ہے جو حد سے نکل جانے والا گنہگار ہے",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5860.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5861,
      "arabic_text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ",
      "urdu_text": "جب اس کو ہماری آیتیں سنائی جاتی ہیں تو کہتا ہے کہ یہ تو اگلے لوگوں کے افسانے ہیں",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5861.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5862,
      "arabic_text": "كَلَّا ۖ بَلْ ۜ رَانَ عَلَىٰ قُلُوبِهِم مَّا كَانُوا۟ يَكْسِبُونَ",
      "urdu_text": "دیکھو یہ جو (اعمال بد) کرتے ہیں ان کا ان کے دلوں پر زنگ بیٹھ گیا ہے",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5862.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5863,
      "arabic_text": "كَلَّآ إِنَّهُمْ عَن رَّبِّهِمْ يَوْمَئِذٍۢ لَّمَحْجُوبُونَ",
      "urdu_text": "بےشک یہ لوگ اس روز اپنے پروردگار (کے دیدار) سے اوٹ میں ہوں گے",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5863.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5864,
      "arabic_text": "ثُمَّ إِنَّهُمْ لَصَالُوا۟ ٱلْجَحِيمِ",
      "urdu_text": "پھر دوزخ میں جا داخل ہوں گے",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5864.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5865,
      "arabic_text": "ثُمَّ يُقَالُ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ",
      "urdu_text": "پھر ان سے کہا جائے گا کہ یہ وہی چیز ہے جس کو تم جھٹلاتے تھے",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5865.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5866,
      "arabic_text": "كَلَّآ إِنَّ كِتَٰبَ ٱلْأَبْرَارِ لَفِى عِلِّيِّينَ",
      "urdu_text": "(یہ بھی) سن رکھو کہ نیکوکاروں کے اعمال علیین میں ہیں",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5866.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5867,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا عِلِّيُّونَ",
      "urdu_text": "اور تم کو کیا معلوم کہ علیین کیا چیز ہے؟",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5867.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5868,
      "arabic_text": "كِتَٰبٌۭ مَّرْقُومٌۭ",
      "urdu_text": "ایک دفتر ہے لکھا ہوا",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5868.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5869,
      "arabic_text": "يَشْهَدُهُ ٱلْمُقَرَّبُونَ",
      "urdu_text": "جس کے پاس مقرب (فرشتے) حاضر رہتے ہیں",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5869.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5870,
      "arabic_text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍ",
      "urdu_text": "بےشک نیک لوگ چین میں ہوں گے",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5870.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5871,
      "arabic_text": "عَلَى ٱلْأَرَآئِكِ يَنظُرُونَ",
      "urdu_text": "تختوں پر بیٹھے ہوئے نظارے کریں گے",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5871.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5872,
      "arabic_text": "تَعْرِفُ فِى وُجُوهِهِمْ نَضْرَةَ ٱلنَّعِيمِ",
      "urdu_text": "تم ان کے چہروں ہی سے راحت کی تازگی معلوم کر لو گے",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5872.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5873,
      "arabic_text": "يُسْقَوْنَ مِن رَّحِيقٍۢ مَّخْتُومٍ",
      "urdu_text": "ان کو خالص شراب سربمہر پلائی جائے گی",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5873.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 5874,
      "arabic_text": "خِتَٰمُهُۥ مِسْكٌۭ ۚ وَفِى ذَٰلِكَ فَلْيَتَنَافَسِ ٱلْمُتَنَٰفِسُونَ",
      "urdu_text": "جس کی مہر مشک کی ہو گی تو (نعمتوں کے) شائقین کو چاہیے کہ اسی سے رغبت کریں",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5874.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 5875,
      "arabic_text": "وَمِزَاجُهُۥ مِن تَسْنِيمٍ",
      "urdu_text": "اور اس میں تسنیم (کے پانی) کی آمیزش ہو گی",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5875.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 5876,
      "arabic_text": "عَيْنًۭا يَشْرَبُ بِهَا ٱلْمُقَرَّبُونَ",
      "urdu_text": "وہ ایک چشمہ ہے جس میں سے (خدا کے) مقرب پیئیں گے",
      "juz": 30,
      "page": 588,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5876.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/083028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/083028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 5877,
      "arabic_text": "إِنَّ ٱلَّذِينَ أَجْرَمُوا۟ كَانُوا۟ مِنَ ٱلَّذِينَ ءَامَنُوا۟ يَضْحَكُونَ",
      "urdu_text": "جو گنہگار (یعنی کفار) ہیں وہ (دنیا میں) مومنوں سے ہنسی کیا کرتے تھے",
      "juz": 30,
      "page": 588,
