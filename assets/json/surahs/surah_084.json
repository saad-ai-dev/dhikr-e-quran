{
  "surah_number": 84,
  "name_arabic": "سُورَةُ الانشِقَاقِ",
  "name_english": "Al-Inshiqaaq",
  "name_urdu": "The Splitting Open",
  "revelation_type": "Meccan",
  "total_ayahs": 25,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5885,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ",
      "urdu_text": "جب آسمان پھٹ جائے گا",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5885.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5886,
      "arabic_text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "urdu_text": "اور اپنے پروردگار کا فرمان بجا لائے گا اور اسے واجب بھی یہ ہی ہے",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5886.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5887,
      "arabic_text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ",
      "urdu_text": "اور جب زمین ہموار کر دی جائے گی",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5887.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5888,
      "arabic_text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ",
      "urdu_text": "جو کچھ اس میں ہے اسے نکال کر باہر ڈال دے گی اور (بالکل) خالی ہو جائے گی",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5888.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5889,
      "arabic_text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ",
      "urdu_text": "اور اپنے پروردگار کے ارشاد کی تعمیل کرے گی اور اس کو لازم بھی یہی ہے (تو قیامت قائم ہو جائے گی)",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5889.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5890,
      "arabic_text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًۭا فَمُلَٰقِيهِ",
      "urdu_text": "اے انسان! تو اپنے پروردگار کی طرف (پہنچنے میں) خوب کوشِش کرتا ہے سو اس سے جا ملے گا",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5890.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5891,
      "arabic_text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ",
      "urdu_text": "تو جس کا نامہٴ (اعمال) اس کے داہنے ہاتھ میں دیا جائے گا",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5891.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5892,
      "arabic_text": "فَسَوْفَ يُحَاسَبُ حِسَابًۭا يَسِيرًۭا",
      "urdu_text": "اس سے حساب آسان لیا جائے گا",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5892.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5893,
      "arabic_text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًۭا",
      "urdu_text": "اور وہ اپنے گھر والوں میں خوش خوش آئے گا",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5893.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5894,
      "arabic_text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ",
      "urdu_text": "اور جس کا نامہٴ (اعمال) اس کی پیٹھ کے پیچھے سے دیا جائے گا",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5894.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5895,
      "arabic_text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًۭا",
      "urdu_text": "وہ موت کو پکارے گا",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5895.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5896,
      "arabic_text": "وَيَصْلَىٰ سَعِيرًا",
      "urdu_text": "اور وہ دوزخ میں داخل ہو گا",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5896.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5897,
      "arabic_text": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا",
      "urdu_text": "یہ اپنے اہل (و عیال) میں مست رہتا تھا",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5897.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5898,
      "arabic_text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ",
      "urdu_text": "اور خیال کرتا تھا کہ (خدا کی طرف) پھر کر نہ جائے گا",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5898.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5899,
      "arabic_text": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًۭا",
      "urdu_text": "ہاں ہاں۔ اس کا پروردگار اس کو دیکھ رہا تھا",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5899.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5900,
      "arabic_text": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ",
      "urdu_text": "ہمیں شام کی سرخی کی قسم",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5900.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5901,
      "arabic_text": "وَٱلَّيْلِ وَمَا وَسَقَ",
      "urdu_text": "اور رات کی اور جن چیزوں کو وہ اکٹھا کر لیتی ہے ان کی",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5901.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5902,
      "arabic_text": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ",
      "urdu_text": "اور چاند کی جب کامل ہو جائے",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5902.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5903,
      "arabic_text": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍۢ",
      "urdu_text": "کہ تم درجہ بدرجہ (رتبہٴ اعلیٰ پر) چڑھو گے",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5903.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5904,
      "arabic_text": "فَمَا لَهُمْ لَا يُؤْمِنُونَ",
      "urdu_text": "تو ان لوگوں کو کیا ہوا ہے کہ ایمان نہیں لاتے",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5904.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5905,
      "arabic_text": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ ۩",
      "urdu_text": "اور جب ان کے سامنے قرآن پڑھا جاتا ہے تو سجدہ نہیں کرتے",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5905.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5906,
      "arabic_text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ",
      "urdu_text": "بلکہ کافر جھٹلاتے ہیں",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5906.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5907,
      "arabic_text": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ",
      "urdu_text": "اور خدا ان باتوں کو جو یہ اپنے دلوں میں چھپاتے ہیں خوب جانتا ہے",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5907.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5908,
      "arabic_text": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ",
      "urdu_text": "تو ان کو دکھ دینے والے عذاب کی خبر سنا دو",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5908.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5909,
      "arabic_text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ",
      "urdu_text": "ہاں جو لوگ ایمان لائے اور نیک عمل کرتے رہے ان کے لیے بےانتہا اجر ہے",
      "juz": 30,
      "page": 589,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5909.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/084025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/084025.mp3"
    }
  ]
}