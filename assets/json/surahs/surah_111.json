    },
    {
      "ayah_number": 4,
      "global_number": 6220,
      "arabic_text": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ",
      "urdu_text": "اور اس کی جورو بھی جو ایندھن سر پر اٹھائے پھرتی ہے",
