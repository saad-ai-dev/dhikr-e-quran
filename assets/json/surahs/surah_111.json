      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/111001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 6218,
      "arabic_text": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ",
      "urdu_text": "نہ تو اس کا مال ہی اس کے کچھ کام آیا اور نہ وہ جو اس نے کمایا",
      "juz": 30,
      "page": 603,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6218.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/111002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/111002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 6219,
      "arabic_text": "سَيَصْلَىٰ نَارًۭا ذَاتَ لَهَبٍۢ",
      "urdu_text": "وہ جلد بھڑکتی ہوئی آگ میں داخل ہو گا",
      "juz": 30,
      "page": 603,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6219.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/111003.mp3",
