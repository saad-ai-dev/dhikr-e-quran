{
  "surah_number": 75,
  "name_arabic": "سُورَةُ القِيَامَةِ",
  "name_english": "Al-Qiyaama",
  "name_urdu": "The Resurrection",
  "revelation_type": "Meccan",
  "total_ayahs": 40,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5552,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِيَوْمِ ٱلْقِيَٰمَةِ",
      "urdu_text": "ہم کو روز قیامت کی قسم",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5552.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5553,
      "arabic_text": "وَلَآ أُقْسِمُ بِٱلنَّفْسِ ٱللَّوَّامَةِ",
      "urdu_text": "اور نفس لوامہ کی (کہ سب لوگ اٹھا کر) کھڑے کئے جائیں گے",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5553.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5554,
      "arabic_text": "أَيَحْسَبُ ٱلْإِنسَٰنُ أَلَّن نَّجْمَعَ عِظَامَهُۥ",
      "urdu_text": "کیا انسان یہ خیال کرتا ہے کہ ہم اس کی (بکھری ہوئی) ہڈیاں اکٹھی نہیں کریں گے؟",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5554.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5555,
      "arabic_text": "بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّىَ بَنَانَهُۥ",
      "urdu_text": "ضرور کریں گے (اور) ہم اس بات پر قادر ہیں کہ اس کی پور پور درست کردیں",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5555.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5556,
      "arabic_text": "بَلْ يُرِيدُ ٱلْإِنسَٰنُ لِيَفْجُرَ أَمَامَهُۥ",
      "urdu_text": "مگر انسان چاہتا ہے کہ آگے کو خود سری کرتا جائے",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5556.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5557,
      "arabic_text": "يَسْـَٔلُ أَيَّانَ يَوْمُ ٱلْقِيَٰمَةِ",
      "urdu_text": "پوچھتا ہے کہ قیامت کا دن کب ہوگا؟",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5557.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5558,
      "arabic_text": "فَإِذَا بَرِقَ ٱلْبَصَرُ",
      "urdu_text": "جب آنکھیں چندھیا جائیں",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5558.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5559,
      "arabic_text": "وَخَسَفَ ٱلْقَمَرُ",
      "urdu_text": "اور چاند گہنا جائے",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5559.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5560,
      "arabic_text": "وَجُمِعَ ٱلشَّمْسُ وَٱلْقَمَرُ",
      "urdu_text": "اور سورج اور چاند جمع کردیئے جائیں",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5560.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5561,
      "arabic_text": "يَقُولُ ٱلْإِنسَٰنُ يَوْمَئِذٍ أَيْنَ ٱلْمَفَرُّ",
      "urdu_text": "اس دن انسان کہے گا کہ (اب) کہاں بھاگ جاؤں؟",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5561.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5562,
      "arabic_text": "كَلَّا لَا وَزَرَ",
      "urdu_text": "بےشک کہیں پناہ نہیں",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5562.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5563,
      "arabic_text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمُسْتَقَرُّ",
      "urdu_text": "اس روز پروردگار ہی کے پاس ٹھکانا ہے",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5563.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5564,
      "arabic_text": "يُنَبَّؤُا۟ ٱلْإِنسَٰنُ يَوْمَئِذٍۭ بِمَا قَدَّمَ وَأَخَّرَ",
      "urdu_text": "اس دن انسان کو جو (عمل) اس نے آگے بھیجے اور پیچھے چھوڑے ہوں گے سب بتا دیئے جائیں گے",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5564.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5565,
      "arabic_text": "بَلِ ٱلْإِنسَٰنُ عَلَىٰ نَفْسِهِۦ بَصِيرَةٌۭ",
      "urdu_text": "بلکہ انسان آپ اپنا گواہ ہے",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5565.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5566,
      "arabic_text": "وَلَوْ أَلْقَىٰ مَعَاذِيرَهُۥ",
      "urdu_text": "اگرچہ عذر ومعذرت کرتا رہے",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5566.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5567,
      "arabic_text": "لَا تُحَرِّكْ بِهِۦ لِسَانَكَ لِتَعْجَلَ بِهِۦٓ",
      "urdu_text": "اور (اے محمدﷺ) وحی کے پڑھنے کے لئے اپنی زبان نہ چلایا کرو کہ اس کو جلد یاد کرلو",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5567.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5568,
      "arabic_text": "إِنَّ عَلَيْنَا جَمْعَهُۥ وَقُرْءَانَهُۥ",
      "urdu_text": "اس کا جمع کرنا اور پڑھانا ہمارے ذمے ہے",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5568.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5569,
      "arabic_text": "فَإِذَا قَرَأْنَٰهُ فَٱتَّبِعْ قُرْءَانَهُۥ",
      "urdu_text": "جب ہم وحی پڑھا کریں تو تم (اس کو سنا کرو اور) پھر اسی طرح پڑھا کرو",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5569.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5570,
      "arabic_text": "ثُمَّ إِنَّ عَلَيْنَا بَيَانَهُۥ",
      "urdu_text": "پھر اس (کے معانی) کا بیان بھی ہمارے ذمے ہے",
      "juz": 29,
      "page": 577,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5570.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5571,
      "arabic_text": "كَلَّا بَلْ تُحِبُّونَ ٱلْعَاجِلَةَ",
      "urdu_text": "مگر (لوگو) تم دنیا کو دوست رکھتے ہو",
      "juz": 29,
      "page": 578,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5571.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5572,
      "arabic_text": "وَتَذَرُونَ ٱلْءَاخِرَةَ",
      "urdu_text": "اور آخرت کو ترک کئے دیتے ہو",
      "juz": 29,
      "page": 578,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5572.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5573,
      "arabic_text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاضِرَةٌ",
      "urdu_text": "اس روز بہت سے منہ رونق دار ہوں گے",
      "juz": 29,
      "page": 578,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5573.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5574,
      "arabic_text": "إِلَىٰ رَبِّهَا نَاظِرَةٌۭ",
      "urdu_text": "اور) اپنے پروردگار کے محو دیدار ہوں گے",
      "juz": 29,
      "page": 578,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5574.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5575,
      "arabic_text": "وَوُجُوهٌۭ يَوْمَئِذٍۭ بَاسِرَةٌۭ",
      "urdu_text": "اور بہت سے منہ اس دن اداس ہوں گے",
      "juz": 29,
      "page": 578,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5575.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5576,
      "arabic_text": "تَظُنُّ أَن يُفْعَلَ بِهَا فَاقِرَةٌۭ",
      "urdu_text": "خیال کریں گے کہ ان پر مصیبت واقع ہونے کو ہے",
      "juz": 29,
      "page": 578,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5576.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 5577,
      "arabic_text": "كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِىَ",
      "urdu_text": "دیکھو جب جان گلے تک پہنچ جائے",
      "juz": 29,
      "page": 578,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5577.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 5578,
      "arabic_text": "وَقِيلَ مَنْ ۜ رَاقٍۢ",
      "urdu_text": "اور لوگ کہنے لگیں (اس وقت) کون جھاڑ پھونک کرنے والا ہے",
      "juz": 29,
      "page": 578,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5578.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 5579,
      "arabic_text": "وَظَنَّ أَنَّهُ ٱلْفِرَاقُ",
      "urdu_text": "اور اس (جان بلب) نے سمجھا کہ اب سب سے جدائی ہے",
      "juz": 29,
      "page": 578,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5579.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 5580,
      "arabic_text": "وَٱلْتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ",
      "urdu_text": "اور پنڈلی سے پنڈلی لپٹ جائے",
      "juz": 29,
      "page": 578,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5580.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/075029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/075029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 5581,
      "arabic_text": "إِلَىٰ رَبِّكَ يَوْمَئِذٍ ٱلْمَسَاقُ",
      "urdu_text": "اس دن تجھ کو اپنے پروردگار کی طرف چلنا ہے",
      "juz": 29,
