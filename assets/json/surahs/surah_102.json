      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6172.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/102004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/102004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 6173,
