{
  "surah_number": 81,
  "name_arabic": "سُورَةُ التَّكۡوِيرِ",
  "name_english": "At-Takwir",
  "name_urdu": "The Overthrowing",
  "revelation_type": "Meccan",
  "total_ayahs": 29,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5801,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلشَّمْسُ كُوِّرَتْ",
      "urdu_text": "جب سورج لپیٹ لیا جائے گا",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5801.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5802,
      "arabic_text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ",
      "urdu_text": "جب تارے بےنور ہو جائیں گے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5802.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5803,
      "arabic_text": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ",
      "urdu_text": "اور جب پہاڑ چلائے جائیں گے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5803.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5804,
      "arabic_text": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ",
      "urdu_text": "اور جب بیانے والی اونٹنیاں بےکار ہو جائیں گی",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5804.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5805,
      "arabic_text": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ",
      "urdu_text": "اور جب وحشی جانور جمع اکٹھے ہو جائیں گے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5805.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5806,
      "arabic_text": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ",
      "urdu_text": "اور جب دریا آگ ہو جائیں گے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5806.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5807,
      "arabic_text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ",
      "urdu_text": "اور جب روحیں (بدنوں سے) ملا دی جائیں گی",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5807.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5808,
      "arabic_text": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ",
      "urdu_text": "اور جب لڑکی سے جو زندہ دفنا دی گئی ہو پوچھا جائے گا",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5808.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5809,
      "arabic_text": "بِأَىِّ ذَنۢبٍۢ قُتِلَتْ",
      "urdu_text": "کہ وہ کس گناہ پرماری گئی",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5809.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5810,
      "arabic_text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ",
      "urdu_text": "اور جب (عملوں کے) دفتر کھولے جائیں گے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5810.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5811,
      "arabic_text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ",
      "urdu_text": "اور جب آسمانوں کی کھال کھینچ لی جائے گی",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5811.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5812,
      "arabic_text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ",
      "urdu_text": "اور جب دوزخ (کی آگ) بھڑکائی جائے گی",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5812.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5813,
      "arabic_text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ",
      "urdu_text": "اور بہشت جب قریب لائی جائے گی",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5813.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5814,
      "arabic_text": "عَلِمَتْ نَفْسٌۭ مَّآ أَحْضَرَتْ",
      "urdu_text": "تب ہر شخص معلوم کر لے گا کہ وہ کیا لے کر آیا ہے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5814.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5815,
      "arabic_text": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ",
      "urdu_text": "ہم کو ان ستاروں کی قسم جو پیچھے ہٹ جاتے ہیں",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5815.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5816,
      "arabic_text": "ٱلْجَوَارِ ٱلْكُنَّسِ",
      "urdu_text": "(اور) جو سیر کرتے اور غائب ہو جاتے ہیں",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5816.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5817,
      "arabic_text": "وَٱلَّيْلِ إِذَا عَسْعَسَ",
      "urdu_text": "اور رات کی قسم جب ختم ہونے لگتی ہے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5817.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5818,
      "arabic_text": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ",
      "urdu_text": "اور صبح کی قسم جب نمودار ہوتی ہے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5818.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5819,
      "arabic_text": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ",
      "urdu_text": "کہ بےشک یہ (قرآن) فرشتہٴ عالی مقام کی زبان کا پیغام ہے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5819.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5820,
      "arabic_text": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍۢ",
      "urdu_text": "جو صاحب قوت مالک عرش کے ہاں اونچے درجے والا ہے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5820.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5821,
      "arabic_text": "مُّطَاعٍۢ ثَمَّ أَمِينٍۢ",
      "urdu_text": "سردار (اور) امانت دار ہے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5821.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5822,
      "arabic_text": "وَمَا صَاحِبُكُم بِمَجْنُونٍۢ",
      "urdu_text": "اور (مکے والو) تمہارے رفیق (یعنی محمدﷺ) دیوانے نہیں ہیں",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5822.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5823,
      "arabic_text": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ",
      "urdu_text": "بےشک انہوں نے اس (فرشتے) کو (آسمان کے کھلے یعنی) مشرقی کنارے پر دیکھا ہے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5823.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5824,
      "arabic_text": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍۢ",
      "urdu_text": "اور وہ پوشیدہ باتوں (کے ظاہر کرنے) میں بخیل نہیں",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5824.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5825,
      "arabic_text": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍۢ رَّجِيمٍۢ",
      "urdu_text": "اور یہ شیطان مردود کا کلام نہیں",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5825.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 5826,
      "arabic_text": "فَأَيْنَ تَذْهَبُونَ",
      "urdu_text": "پھر تم کدھر جا رہے ہو",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5826.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 5827,
      "arabic_text": "إِنْ هُوَ إِلَّا ذِكْرٌۭ لِّلْعَٰلَمِينَ",
      "urdu_text": "یہ تو جہان کے لوگوں کے لیے نصیحت ہے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5827.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 5828,
      "arabic_text": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ",
      "urdu_text": "(یعنی) اس کے لیے جو تم میں سے سیدھی چال چلنا چاہے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5828.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 5829,
      "arabic_text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ",
      "urdu_text": "اور تم کچھ بھی نہیں چاہ سکتے مگر وہی جو خدائے رب العالمین چاہے",
      "juz": 30,
      "page": 586,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5829.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/081029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/081029.mp3"
    }
  ]
}