{
  "surah_number": 91,
  "name_arabic": "سُورَةُ الشَّمۡسِ",
  "name_english": "Ash-Shams",
  "name_urdu": "The Sun",
  "revelation_type": "Meccan",
  "total_ayahs": 15,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 6044,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا",
      "urdu_text": "سورج کی قسم اور اس کی روشنی کی",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6044.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 6045,
      "arabic_text": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
      "urdu_text": "اور چاند کی جب اس کے پیچھے نکلے",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6045.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 6046,
      "arabic_text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
      "urdu_text": "اور دن کی جب اُسے چمکا دے",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6046.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 6047,
      "arabic_text": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
      "urdu_text": "اور رات کی جب اُسے چھپا لے",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6047.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 6048,
      "arabic_text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
      "urdu_text": "اور آسمان کی اور اس ذات کی جس نے اسے بنایا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6048.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 6049,
      "arabic_text": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
      "urdu_text": "اور زمین کی اور اس کی جس نے اسے پھیلایا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6049.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 6050,
      "arabic_text": "وَنَفْسٍۢ وَمَا سَوَّىٰهَا",
      "urdu_text": "اور انسان کی اور اس کی جس نے اس (کے اعضا) کو برابر کیا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6050.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 6051,
      "arabic_text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
      "urdu_text": "پھر اس کو بدکاری (سے بچنے) اور پرہیزگاری کرنے کی سمجھ دی",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6051.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 6052,
      "arabic_text": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
      "urdu_text": "کہ جس نے (اپنے) نفس (یعنی روح) کو پاک رکھا وہ مراد کو پہنچا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6052.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 6053,
      "arabic_text": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
      "urdu_text": "اور جس نے اسے خاک میں ملایا وہ خسارے میں رہا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6053.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 6054,
      "arabic_text": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
      "urdu_text": "(قوم) ثمود نے اپنی سرکشی کے سبب (پیغمبر کو) جھٹلایا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6054.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 6055,
      "arabic_text": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
      "urdu_text": "جب ان میں سے ایک نہایت بدبخت اٹھا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6055.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 6056,
      "arabic_text": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا",
      "urdu_text": "تو خدا کے پیغمبر (صالح) نے ان سے کہا کہ خدا کی اونٹنی اور اس کے پانی پینے کی باری سے عذر کرو",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6056.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 6057,
      "arabic_text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
      "urdu_text": "مگر انہوں نے پیغمبر کو جھٹلایا اور اونٹنی کی کونچیں کاٹ دیں تو خدا نے ان کےگناہ کے سبب ان پر عذاب نازل کیا اور سب کو (ہلاک کر کے) برابر کر دیا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6057.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 6058,
      "arabic_text": "وَلَا يَخَافُ عُقْبَٰهَا",
      "urdu_text": "اور اس کو ان کے بدلہ لینے کا کچھ بھی ڈر نہیں",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6058.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/091015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/091015.mp3"
    }
  ]
}