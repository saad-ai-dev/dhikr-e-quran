{
  "surah_number": 54,
  "name_arabic": "سُورَةُ القَمَرِ",
  "name_english": "Al-Qamar",
  "name_urdu": "The Moon",
  "revelation_type": "Meccan",
  "total_ayahs": 55,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 4847,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ",
      "urdu_text": "قیامت قریب آ پہنچی اور چاند شق ہوگیا",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4847.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 4848,
      "arabic_text": "وَإِن يَرَوْا۟ ءَايَةًۭ يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌۭ مُّسْتَمِرٌّۭ",
      "urdu_text": "اور اگر (کافر) کوئی نشانی دیکھتے ہیں تو منہ پھیر لیتے ہیں اور کہتے ہیں کہ یہ ایک ہمیشہ کا جادو ہے",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4848.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 4849,
      "arabic_text": "وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ۚ وَكُلُّ أَمْرٍۢ مُّسْتَقِرٌّۭ",
      "urdu_text": "اور انہوں نے جھٹلایا اور اپنی خواہشوں کی پیروی کی اور ہر کام کا وقت مقرر ہے",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4849.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 4850,
      "arabic_text": "وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ مَا فِيهِ مُزْدَجَرٌ",
      "urdu_text": "اور ان کو ایسے حالات (سابقین) پہنچ چکے ہیں جن میں عبرت ہے",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4850.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 4851,
      "arabic_text": "حِكْمَةٌۢ بَٰلِغَةٌۭ ۖ فَمَا تُغْنِ ٱلنُّذُرُ",
      "urdu_text": "اور کامل دانائی (کی کتاب بھی) لیکن ڈرانا ان کو کچھ فائدہ نہیں دیتا",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4851.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 4852,
      "arabic_text": "فَتَوَلَّ عَنْهُمْ ۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍۢ نُّكُرٍ",
      "urdu_text": "تو تم بھی ان کی کچھ پروا نہ کرو۔ جس دن بلانے والا ان کو ایک ناخوش چیز کی طرف بلائے گا",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4852.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 4853,
      "arabic_text": "خُشَّعًا أَبْصَٰرُهُمْ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ كَأَنَّهُمْ جَرَادٌۭ مُّنتَشِرٌۭ",
      "urdu_text": "تو آنکھیں نیچی کئے ہوئے قبروں سے نکل پڑیں گے گویا بکھری ہوئی ٹڈیاں",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4853.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 4854,
      "arabic_text": "مُّهْطِعِينَ إِلَى ٱلدَّاعِ ۖ يَقُولُ ٱلْكَٰفِرُونَ هَٰذَا يَوْمٌ عَسِرٌۭ",
      "urdu_text": "اس بلانے والے کی طرف دوڑتے جاتے ہوں گے۔ کافر کہیں گے یہ دن بڑا سخت ہے",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4854.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 4855,
      "arabic_text": "۞ كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍۢ فَكَذَّبُوا۟ عَبْدَنَا وَقَالُوا۟ مَجْنُونٌۭ وَٱزْدُجِرَ",
      "urdu_text": "ان سے پہلے نوحؑ کی قوم نے بھی تکذیب کی تھی تو انہوں نے ہمارے بندے کو جھٹلایا اور کہا کہ دیوانہ ہے اور انہیں ڈانٹا بھی",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4855.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 4856,
      "arabic_text": "فَدَعَا رَبَّهُۥٓ أَنِّى مَغْلُوبٌۭ فَٱنتَصِرْ",
      "urdu_text": "تو انہوں نے اپنے پروردگار سے دعا کی کہ (بار الٓہا) میں (ان کے مقابلے میں) کمزور ہوں تو (ان سے) بدلہ لے",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4856.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 4857,
      "arabic_text": "فَفَتَحْنَآ أَبْوَٰبَ ٱلسَّمَآءِ بِمَآءٍۢ مُّنْهَمِرٍۢ",
      "urdu_text": "پس ہم نے زور کے مینہ سے آسمان کے دہانے کھول دیئے",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4857.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 4858,
      "arabic_text": "وَفَجَّرْنَا ٱلْأَرْضَ عُيُونًۭا فَٱلْتَقَى ٱلْمَآءُ عَلَىٰٓ أَمْرٍۢ قَدْ قُدِرَ",
      "urdu_text": "اور زمین میں چشمے جاری کردیئے تو پانی ایک کام کے لئے جو مقدر ہوچکا تھا جمع ہوگیا",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4858.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 4859,
      "arabic_text": "وَحَمَلْنَٰهُ عَلَىٰ ذَاتِ أَلْوَٰحٍۢ وَدُسُرٍۢ",
      "urdu_text": "اور ہم نے نوحؑ کو ایک کشتی پر جو تختوں اور میخوں سے تیار کی گئی تھی سوار کرلیا",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4859.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 4860,
      "arabic_text": "تَجْرِى بِأَعْيُنِنَا جَزَآءًۭ لِّمَن كَانَ كُفِرَ",
      "urdu_text": "وہ ہماری آنکھوں کے سامنے چلتی تھی۔ (یہ سب کچھ) اس شخص کے انتقام کے لئے (کیا گیا) جس کو کافر مانتے نہ تھے",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4860.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 4861,
      "arabic_text": "وَلَقَد تَّرَكْنَٰهَآ ءَايَةًۭ فَهَلْ مِن مُّدَّكِرٍۢ",
      "urdu_text": "اور ہم نے اس کو ایک عبرت بنا چھوڑا تو کوئی ہے کہ سوچے سمجھے؟",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4861.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 4862,
      "arabic_text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ",
      "urdu_text": "سو (دیکھ لو کہ) میرا عذاب اور ڈرانا کیسا ہوا؟",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4862.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 4863,
      "arabic_text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ",
      "urdu_text": "اور ہم نے قرآن کو سمجھنے کے لئے آسان کردیا ہے تو کوئی ہے کہ سوچے سمجھے؟",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4863.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 4864,
      "arabic_text": "كَذَّبَتْ عَادٌۭ فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ",
      "urdu_text": "عاد نے بھی تکذیب کی تھی سو (دیکھ لو کہ) میرا عذاب اور ڈرانا کیسا ہوا",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4864.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 4865,
      "arabic_text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ رِيحًۭا صَرْصَرًۭا فِى يَوْمِ نَحْسٍۢ مُّسْتَمِرٍّۢ",
      "urdu_text": "ہم نے ان پر سخت منحوس دن میں آندھی چلائی",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4865.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 4866,
      "arabic_text": "تَنزِعُ ٱلنَّاسَ كَأَنَّهُمْ أَعْجَازُ نَخْلٍۢ مُّنقَعِرٍۢ",
      "urdu_text": "وہ لوگوں کو (اس طرح) اکھیڑے ڈالتی تھی گویا اکھڑی ہوئی کھجوروں کے تنے ہیں",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4866.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 4867,
      "arabic_text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ",
      "urdu_text": "سو (دیکھ لو کہ) میرا عذاب اور ڈرانا کیسا ہوا",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4867.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 4868,
      "arabic_text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ",
      "urdu_text": "اور ہم نے قرآن کو سمجھنے کے لئے آسان کردیا ہے تو کوئی ہے کہ سوچے سمجھے؟",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4868.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 4869,
      "arabic_text": "كَذَّبَتْ ثَمُودُ بِٱلنُّذُرِ",
      "urdu_text": "ثمود نے بھی ہدایت کرنے والوں کو جھٹلایا",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4869.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 4870,
      "arabic_text": "فَقَالُوٓا۟ أَبَشَرًۭا مِّنَّا وَٰحِدًۭا نَّتَّبِعُهُۥٓ إِنَّآ إِذًۭا لَّفِى ضَلَٰلٍۢ وَسُعُرٍ",
      "urdu_text": "اور کہا کہ بھلا ایک آدمی جو ہم ہی میں سے ہے ہم اس کی پیروی کریں؟ یوں ہو تو ہم گمراہی اور دیوانگی میں پڑ گئے",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4870.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 4871,
      "arabic_text": "أَءُلْقِىَ ٱلذِّكْرُ عَلَيْهِ مِنۢ بَيْنِنَا بَلْ هُوَ كَذَّابٌ أَشِرٌۭ",
      "urdu_text": "کیا ہم سب میں سے اسی پر وحی نازل ہوئی ہے؟ (نہیں) بلکہ یہ جھوٹا خود پسند ہے",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4871.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 4872,
      "arabic_text": "سَيَعْلَمُونَ غَدًۭا مَّنِ ٱلْكَذَّابُ ٱلْأَشِرُ",
      "urdu_text": "ان کو کل ہی معلوم ہوجائے گا کہ کون جھوٹا خود پسند ہے",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4872.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 4873,
      "arabic_text": "إِنَّا مُرْسِلُوا۟ ٱلنَّاقَةِ فِتْنَةًۭ لَّهُمْ فَٱرْتَقِبْهُمْ وَٱصْطَبِرْ",
      "urdu_text": "(اے صالح) ہم ان کی آزمائش کے لئے اونٹنی بھیجنے والے ہیں تو تم ان کو دیکھتے رہو اور صبر کرو",
      "juz": 27,
      "page": 529,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4873.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 4874,
      "arabic_text": "وَنَبِّئْهُمْ أَنَّ ٱلْمَآءَ قِسْمَةٌۢ بَيْنَهُمْ ۖ كُلُّ شِرْبٍۢ مُّحْتَضَرٌۭ",
      "urdu_text": "اور ان کو آگاہ کردو کہ ان میں پانی کی باری مقرر کر دی گئی ہے۔ ہر (باری والے کو اپنی) باری پر آنا چاہیئے",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4874.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 4875,
      "arabic_text": "فَنَادَوْا۟ صَاحِبَهُمْ فَتَعَاطَىٰ فَعَقَرَ",
      "urdu_text": "تو ان لوگوں نے اپنے رفیق کو بلایا اور اس نے (اونٹنی کو پکڑ کر اس کی) کونچیں کاٹ ڈالیں",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4875.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 4876,
      "arabic_text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ",
      "urdu_text": "سو (دیکھ لو کہ) میرا عذاب اور ڈرانا کیسا ہوا",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4876.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054030.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054030.mp3"
    },
    {
      "ayah_number": 31,
      "global_number": 4877,
      "arabic_text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ صَيْحَةًۭ وَٰحِدَةًۭ فَكَانُوا۟ كَهَشِيمِ ٱلْمُحْتَظِرِ",
      "urdu_text": "ہم نے ان پر (عذاب کے لئے) ایک چیخ بھیجی تو وہ ایسے ہوگئے جیسے باڑ والے کی سوکھی اور ٹوٹی ہوئی باڑ",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4877.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054031.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054031.mp3"
    },
    {
      "ayah_number": 32,
      "global_number": 4878,
      "arabic_text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ",
      "urdu_text": "اور ہم نے قرآن کو سمجھنے کے لئے آسان کردیا ہے تو کوئی ہے کہ سوچے سمجھے؟",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4878.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054032.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054032.mp3"
    },
    {
      "ayah_number": 33,
      "global_number": 4879,
      "arabic_text": "كَذَّبَتْ قَوْمُ لُوطٍۭ بِٱلنُّذُرِ",
      "urdu_text": "لوط کی قوم نے بھی ڈر سنانے والوں کو جھٹلایا تھا",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4879.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054033.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054033.mp3"
    },
    {
      "ayah_number": 34,
      "global_number": 4880,
      "arabic_text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ حَاصِبًا إِلَّآ ءَالَ لُوطٍۢ ۖ نَّجَّيْنَٰهُم بِسَحَرٍۢ",
      "urdu_text": "تو ہم نے ان پر کنکر بھری ہوا چلائی مگر لوط کے گھر والے کہ ہم نے ان کو پچھلی رات ہی سے بچا لیا",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4880.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054034.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054034.mp3"
    },
    {
      "ayah_number": 35,
      "global_number": 4881,
      "arabic_text": "نِّعْمَةًۭ مِّنْ عِندِنَا ۚ كَذَٰلِكَ نَجْزِى مَن شَكَرَ",
      "urdu_text": "اپنے فضل سے۔ شکر کرنے والوں کو ہم ایسا ہی بدلہ دیا کرتے ہیں",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4881.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054035.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054035.mp3"
    },
    {
      "ayah_number": 36,
      "global_number": 4882,
      "arabic_text": "وَلَقَدْ أَنذَرَهُم بَطْشَتَنَا فَتَمَارَوْا۟ بِٱلنُّذُرِ",
      "urdu_text": "اور لوطؑ نے ان کو ہماری پکڑ سے ڈرایا بھی تھا مگر انہوں نے ڈرانے میں شک کیا",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4882.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054036.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054036.mp3"
    },
    {
      "ayah_number": 37,
      "global_number": 4883,
      "arabic_text": "وَلَقَدْ رَٰوَدُوهُ عَن ضَيْفِهِۦ فَطَمَسْنَآ أَعْيُنَهُمْ فَذُوقُوا۟ عَذَابِى وَنُذُرِ",
      "urdu_text": "اور ان سے ان کے مہمانوں کو لے لینا چاہا تو ہم نے ان کی آنکھیں مٹا دیں سو (اب) میرے عذاب اور ڈرانے کے مزے چکھو",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4883.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054037.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054037.mp3"
    },
    {
      "ayah_number": 38,
      "global_number": 4884,
      "arabic_text": "وَلَقَدْ صَبَّحَهُم بُكْرَةً عَذَابٌۭ مُّسْتَقِرٌّۭ",
      "urdu_text": "اور ان پر صبح سویرے ہی اٹل عذاب آ نازل ہوا",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4884.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054038.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054038.mp3"
    },
    {
      "ayah_number": 39,
      "global_number": 4885,
      "arabic_text": "فَذُوقُوا۟ عَذَابِى وَنُذُرِ",
      "urdu_text": "تو اب میرے عذاب اور ڈرانے کے مزے چکھو",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4885.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054039.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054039.mp3"
    },
    {
      "ayah_number": 40,
      "global_number": 4886,
      "arabic_text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍۢ",
      "urdu_text": "اور ہم نے قرآن کو سمجھنے کے لئے آسان کردیا ہے تو کوئی ہے کہ سوچے سمجھے؟",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4886.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054040.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054040.mp3"
    },
    {
      "ayah_number": 41,
      "global_number": 4887,
      "arabic_text": "وَلَقَدْ جَآءَ ءَالَ فِرْعَوْنَ ٱلنُّذُرُ",
      "urdu_text": "اور قوم فرعون کے پاس بھی ڈر سنانے والے آئے",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4887.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054041.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054041.mp3"
    },
    {
      "ayah_number": 42,
      "global_number": 4888,
      "arabic_text": "كَذَّبُوا۟ بِـَٔايَٰتِنَا كُلِّهَا فَأَخَذْنَٰهُمْ أَخْذَ عَزِيزٍۢ مُّقْتَدِرٍ",
      "urdu_text": "انہوں نے ہماری تمام نشانیوں کو جھٹلایا تو ہم نے ان کو اس طرح پکڑ لیا جس طرح ایک قوی اور غالب شخص پکڑ لیتا ہے",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4888.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054042.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054042.mp3"
    },
    {
      "ayah_number": 43,
      "global_number": 4889,
      "arabic_text": "أَكُفَّارُكُمْ خَيْرٌۭ مِّنْ أُو۟لَٰٓئِكُمْ أَمْ لَكُم بَرَآءَةٌۭ فِى ٱلزُّبُرِ",
      "urdu_text": "(اے اہل عرب) کیا تمہارے کافر ان لوگوں سے بہتر ہیں یا تمہارے لئے (پہلی) کتابوں میں کوئی فارغ خطی لکھ دی گئی ہے",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4889.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054043.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054043.mp3"
    },
    {
      "ayah_number": 44,
      "global_number": 4890,
      "arabic_text": "أَمْ يَقُولُونَ نَحْنُ جَمِيعٌۭ مُّنتَصِرٌۭ",
      "urdu_text": "کیا یہ لوگ کہتے ہیں کہ ہماری جماعت بڑی مضبوط ہے",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4890.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054044.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054044.mp3"
    },
    {
      "ayah_number": 45,
      "global_number": 4891,
      "arabic_text": "سَيُهْزَمُ ٱلْجَمْعُ وَيُوَلُّونَ ٱلدُّبُرَ",
      "urdu_text": "عنقریب یہ جماعت شکست کھائے گی اور یہ لوگ پیٹھ پھیر کر بھاگ جائیں گے",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4891.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054045.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054045.mp3"
    },
    {
      "ayah_number": 46,
      "global_number": 4892,
      "arabic_text": "بَلِ ٱلسَّاعَةُ مَوْعِدُهُمْ وَٱلسَّاعَةُ أَدْهَىٰ وَأَمَرُّ",
      "urdu_text": "ان کے وعدے کا وقت تو قیامت ہے اور قیامت بڑی سخت اور بہت تلخ ہے",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4892.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054046.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054046.mp3"
    },
    {
      "ayah_number": 47,
      "global_number": 4893,
      "arabic_text": "إِنَّ ٱلْمُجْرِمِينَ فِى ضَلَٰلٍۢ وَسُعُرٍۢ",
      "urdu_text": "بےشک گنہگار لوگ گمراہی اور دیوانگی میں (مبتلا) ہیں",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4893.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054047.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054047.mp3"
    },
    {
      "ayah_number": 48,
      "global_number": 4894,
      "arabic_text": "يَوْمَ يُسْحَبُونَ فِى ٱلنَّارِ عَلَىٰ وُجُوهِهِمْ ذُوقُوا۟ مَسَّ سَقَرَ",
      "urdu_text": "اس روز منہ کے بل دوزخ میں گھسیٹے جائیں گے اب آگ کا مزہ چکھو",
      "juz": 27,
      "page": 530,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4894.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/054048.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/054048.mp3"
    },
    {
      "ayah_number": 49,
      "global_number": 4895,
      "arabic_text": "إِنَّا كُلَّ شَىْءٍ خَلَقْنَٰهُ بِقَدَرٍۢ",
      "urdu_text": "ہم نے ہر چیز اندازہٴ مقرر کے ساتھ پیدا کی ہے",
      "juz": 27,
      "page": 530,
