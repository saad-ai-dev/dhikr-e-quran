{
  "surah_number": 93,
  "name_arabic": "سُورَةُ الضُّحَىٰ",
  "name_english": "Ad-Dhuhaa",
  "name_urdu": "The Morning Hours",
  "revelation_type": "Meccan",
  "total_ayahs": 11,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 6080,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ",
      "urdu_text": "آفتاب کی روشنی کی قسم",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6080.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/093001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/093001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 6081,
      "arabic_text": "وَٱلَّيْلِ إِذَا سَجَىٰ",
      "urdu_text": "اور رات (کی تاریکی) کی جب چھا جائے",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6081.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/093002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/093002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 6082,
      "arabic_text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ",
      "urdu_text": "کہ (اے محمدﷺ) تمہارے پروردگار نے نہ تو تم کو چھوڑا اور نہ (تم سے) ناراض ہوا",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6082.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/093003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/093003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 6083,
      "arabic_text": "وَلَلْءَاخِرَةُ خَيْرٌۭ لَّكَ مِنَ ٱلْأُولَىٰ",
      "urdu_text": "اور آخرت تمہارے لیے پہلی (حالت یعنی دنیا) سے کہیں بہتر ہے",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6083.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/093004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/093004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 6084,
      "arabic_text": "وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ",
      "urdu_text": "اور تمہیں پروردگار عنقریب وہ کچھ عطا فرمائے گا کہ تم خوش ہو جاؤ گے",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6084.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/093005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/093005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 6085,
      "arabic_text": "أَلَمْ يَجِدْكَ يَتِيمًۭا فَـَٔاوَىٰ",
      "urdu_text": "بھلا اس نے تمہیں یتیم پا کر جگہ نہیں دی؟ (بےشک دی)",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6085.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/093006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/093006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 6086,
      "arabic_text": "وَوَجَدَكَ ضَآلًّۭا فَهَدَىٰ",
      "urdu_text": "اور رستے سے ناواقف دیکھا تو رستہ دکھایا",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6086.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/093007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/093007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 6087,
      "arabic_text": "وَوَجَدَكَ عَآئِلًۭا فَأَغْنَىٰ",
      "urdu_text": "اور تنگ دست پایا تو غنی کر دیا",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6087.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/093008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/093008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 6088,
      "arabic_text": "فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ",
      "urdu_text": "تو تم بھی یتیم پر ستم نہ کرنا",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6088.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/093009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/093009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 6089,
      "arabic_text": "وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ",
      "urdu_text": "اور مانگنے والے کو جھڑکی نہ دینا",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6089.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/093010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/093010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 6090,
      "arabic_text": "وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ",
      "urdu_text": "اور اپنے پروردگار کی نعمتوں کا بیان کرتے رہنا",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6090.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/093011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/093011.mp3"
    }
  ]
}