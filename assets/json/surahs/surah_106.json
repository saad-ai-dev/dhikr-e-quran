    },
    {
      "ayah_number": 4,
      "global_number": 6197,
      "arabic_text": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍۢ وَءَامَنَهُم مِّنْ خَوْفٍۭ",
      "urdu_text": "جس نے ان کو بھوک میں کھانا کھلایا اور خوف سے امن بخشا",
