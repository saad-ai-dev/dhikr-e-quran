{
  "surah_number": 53,
  "name_arabic": "سُورَةُ النَّجۡمِ",
  "name_english": "An-Najm",
  "name_urdu": "The Star",
  "revelation_type": "Meccan",
  "total_ayahs": 62,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 4785,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّجْمِ إِذَا هَوَىٰ",
      "urdu_text": "تارے کی قسم جب غائب ہونے لگے",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4785.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 4786,
      "arabic_text": "مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوَىٰ",
      "urdu_text": "کہ تمہارے رفیق (محمدﷺ) نہ رستہ بھولے ہیں نہ بھٹکے ہیں",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4786.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 4787,
      "arabic_text": "وَمَا يَنطِقُ عَنِ ٱلْهَوَىٰٓ",
      "urdu_text": "اور نہ خواہش نفس سے منہ سے بات نکالتے ہیں",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4787.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 4788,
      "arabic_text": "إِنْ هُوَ إِلَّا وَحْىٌۭ يُوحَىٰ",
      "urdu_text": "یہ (قرآن) تو حکم خدا ہے جو (ان کی طرف) بھیجا جاتا ہے",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4788.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 4789,
      "arabic_text": "عَلَّمَهُۥ شَدِيدُ ٱلْقُوَىٰ",
      "urdu_text": "ان کو نہایت قوت والے نے سکھایا",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4789.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 4790,
      "arabic_text": "ذُو مِرَّةٍۢ فَٱسْتَوَىٰ",
      "urdu_text": "(یعنی جبرائیل) طاقتور نے پھر وہ پورے نظر آئے",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4790.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 4791,
      "arabic_text": "وَهُوَ بِٱلْأُفُقِ ٱلْأَعْلَىٰ",
      "urdu_text": "اور وہ (آسمان کے) اونچے کنارے میں تھے",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4791.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 4792,
      "arabic_text": "ثُمَّ دَنَا فَتَدَلَّىٰ",
      "urdu_text": "پھر قریب ہوئے اوراَور آگے بڑھے",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4792.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 4793,
      "arabic_text": "فَكَانَ قَابَ قَوْسَيْنِ أَوْ أَدْنَىٰ",
      "urdu_text": "تو دو کمان کے فاصلے پر یا اس سے بھی کم",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4793.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 4794,
      "arabic_text": "فَأَوْحَىٰٓ إِلَىٰ عَبْدِهِۦ مَآ أَوْحَىٰ",
      "urdu_text": "پھر خدا نے اپنے بندے کی طرف جو بھیجا سو بھیجا",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4794.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 4795,
      "arabic_text": "مَا كَذَبَ ٱلْفُؤَادُ مَا رَأَىٰٓ",
      "urdu_text": "جو کچھ انہوں نے دیکھا ان کے دل نے اس کو جھوٹ نہ مانا",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4795.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 4796,
      "arabic_text": "أَفَتُمَٰرُونَهُۥ عَلَىٰ مَا يَرَىٰ",
      "urdu_text": "کیا جو کچھ وہ دیکھتے ہیں تم اس میں ان سے جھگڑتے ہو؟",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4796.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 4797,
      "arabic_text": "وَلَقَدْ رَءَاهُ نَزْلَةً أُخْرَىٰ",
      "urdu_text": "اور انہوں نے اس کو ایک بار بھی دیکھا ہے",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4797.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 4798,
      "arabic_text": "عِندَ سِدْرَةِ ٱلْمُنتَهَىٰ",
      "urdu_text": "پرلی حد کی بیری کے پاس",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4798.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 4799,
      "arabic_text": "عِندَهَا جَنَّةُ ٱلْمَأْوَىٰٓ",
      "urdu_text": "اسی کے پاس رہنے کی جنت ہے",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4799.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 4800,
      "arabic_text": "إِذْ يَغْشَى ٱلسِّدْرَةَ مَا يَغْشَىٰ",
      "urdu_text": "جب کہ اس بیری پر چھا رہا تھا جو چھا رہا تھا",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4800.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 4801,
      "arabic_text": "مَا زَاغَ ٱلْبَصَرُ وَمَا طَغَىٰ",
      "urdu_text": "ان کی آنکھ نہ تو اور طرف مائل ہوئی اور نہ (حد سے) آگے بڑھی",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4801.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 4802,
      "arabic_text": "لَقَدْ رَأَىٰ مِنْ ءَايَٰتِ رَبِّهِ ٱلْكُبْرَىٰٓ",
      "urdu_text": "انہوں نے اپنے پروردگار (کی قدرت) کی کتنی ہی بڑی بڑی نشانیاں دیکھیں",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4802.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 4803,
      "arabic_text": "أَفَرَءَيْتُمُ ٱللَّٰتَ وَٱلْعُزَّىٰ",
      "urdu_text": "بھلا تم لوگوں نے لات اور عزیٰ کو دیکھا",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4803.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 4804,
      "arabic_text": "وَمَنَوٰةَ ٱلثَّالِثَةَ ٱلْأُخْرَىٰٓ",
      "urdu_text": "اور تیسرے منات کو (کہ یہ بت کہیں خدا ہوسکتے ہیں)",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4804.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 4805,
      "arabic_text": "أَلَكُمُ ٱلذَّكَرُ وَلَهُ ٱلْأُنثَىٰ",
      "urdu_text": "(مشرکو!) کیا تمہارے لئے تو بیٹے اور خدا کے لئے بیٹیاں",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4805.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 4806,
      "arabic_text": "تِلْكَ إِذًۭا قِسْمَةٌۭ ضِيزَىٰٓ",
      "urdu_text": "یہ تقسیم تو بہت بےانصافی کی ہے",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4806.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 4807,
      "arabic_text": "إِنْ هِىَ إِلَّآ أَسْمَآءٌۭ سَمَّيْتُمُوهَآ أَنتُمْ وَءَابَآؤُكُم مَّآ أَنزَلَ ٱللَّهُ بِهَا مِن سُلْطَٰنٍ ۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَمَا تَهْوَى ٱلْأَنفُسُ ۖ وَلَقَدْ جَآءَهُم مِّن رَّبِّهِمُ ٱلْهُدَىٰٓ",
      "urdu_text": "وہ تو صرف نام ہی نام ہیں جو تم نے اور تمہارے باپ دادا نے گھڑ لئے ہیں۔ خدا نے تو ان کی کوئی سند نازل نہیں کی۔ یہ لوگ محض ظن (فاسد) اور خواہشات نفس کے پیچھے چل رہے ہیں۔ حالانکہ ان کے پروردگار کی طرف سے ان کے پاس ہدایت آچکی ہے",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4807.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 4808,
      "arabic_text": "أَمْ لِلْإِنسَٰنِ مَا تَمَنَّىٰ",
      "urdu_text": "کیا جس چیز کی انسان آرزو کرتا ہے وہ اسے ضرور ملتی ہے",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4808.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 4809,
      "arabic_text": "فَلِلَّهِ ٱلْءَاخِرَةُ وَٱلْأُولَىٰ",
      "urdu_text": "آخرت اور دنیا تو الله ہی کے ہاتھ میں ہے",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4809.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 4810,
      "arabic_text": "۞ وَكَم مِّن مَّلَكٍۢ فِى ٱلسَّمَٰوَٰتِ لَا تُغْنِى شَفَٰعَتُهُمْ شَيْـًٔا إِلَّا مِنۢ بَعْدِ أَن يَأْذَنَ ٱللَّهُ لِمَن يَشَآءُ وَيَرْضَىٰٓ",
      "urdu_text": "اور آسمانوں میں بہت سے فرشتے ہیں جن کی سفارش کچھ بھی فائدہ نہیں دیتی مگر اس وقت کہ خدا جس کے لئے چاہے اجازت بخشے اور (سفارش) پسند کرے",
      "juz": 27,
      "page": 526,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4810.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 4811,
      "arabic_text": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ لَيُسَمُّونَ ٱلْمَلَٰٓئِكَةَ تَسْمِيَةَ ٱلْأُنثَىٰ",
      "urdu_text": "جو لوگ آخرت پر ایمان نہیں لاتے وہ فرشتوں کو (خدا کی) لڑکیوں کے نام سے موسوم کرتے ہیں",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4811.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 4812,
      "arabic_text": "وَمَا لَهُم بِهِۦ مِنْ عِلْمٍ ۖ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ ۖ وَإِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًۭٔا",
      "urdu_text": "حالانکہ ان کو اس کی کچھ خبر نہیں۔ وہ صرف ظن پر چلتے ہیں۔ اور ظن یقین کے مقابلے میں کچھ کام نہیں آتا",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4812.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 4813,
      "arabic_text": "فَأَعْرِضْ عَن مَّن تَوَلَّىٰ عَن ذِكْرِنَا وَلَمْ يُرِدْ إِلَّا ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "urdu_text": "تو جو ہماری یاد سے روگردانی اور صرف دنیا ہی کی زندگی کا خواہاں ہو اس سے تم بھی منہ پھیر لو",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4813.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 4814,
      "arabic_text": "ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ ۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ",
      "urdu_text": "ان کے علم کی انتہا یہی ہے۔ تمہارا پروردگار اس کو بھی خوب جانتا ہے جو اس کے رستے سے بھٹک گیا اور اس سے بھی خوب واقف ہے جو رستے پر چلا",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4814.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053030.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053030.mp3"
    },
    {
      "ayah_number": 31,
      "global_number": 4815,
      "arabic_text": "وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَٰٓـُٔوا۟ بِمَا عَمِلُوا۟ وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا۟ بِٱلْحُسْنَى",
      "urdu_text": "اور جو کچھ آسمانوں میں ہے اور جو کچھ زمین میں ہے سب خدا ہی کا ہے (اور اس نے خلقت کو) اس لئے (پیدا کیا ہے) کہ جن لوگوں نے برے کام کئے ان کو ان کے اعمال کا (برا) بدلا دے اور جنہوں نے نیکیاں کیں ان کو نیک بدلہ دے",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4815.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053031.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053031.mp3"
    },
    {
      "ayah_number": 32,
      "global_number": 4816,
      "arabic_text": "ٱلَّذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ إِلَّا ٱللَّمَمَ ۚ إِنَّ رَبَّكَ وَٰسِعُ ٱلْمَغْفِرَةِ ۚ هُوَ أَعْلَمُ بِكُمْ إِذْ أَنشَأَكُم مِّنَ ٱلْأَرْضِ وَإِذْ أَنتُمْ أَجِنَّةٌۭ فِى بُطُونِ أُمَّهَٰتِكُمْ ۖ فَلَا تُزَكُّوٓا۟ أَنفُسَكُمْ ۖ هُوَ أَعْلَمُ بِمَنِ ٱتَّقَىٰٓ",
      "urdu_text": "جو صغیرہ گناہوں کے سوا بڑے بڑے گناہوں اور بےحیائی کی باتوں سے اجتناب کرتے ہیں۔ بےشک تمہارا پروردگار بڑی بخشش والا ہے۔ وہ تم کو خوب جانتا ہے۔ جب اس نے تم کو مٹی سے پیدا کیا اور جب تم اپنی ماؤں کے پیٹ میں بچّے تھے۔ تو اپنے آپ کو پاک صاف نہ جتاؤ۔ جو پرہیزگار ہے وہ اس سے خوب واقف ہے",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4816.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053032.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053032.mp3"
    },
    {
      "ayah_number": 33,
      "global_number": 4817,
      "arabic_text": "أَفَرَءَيْتَ ٱلَّذِى تَوَلَّىٰ",
      "urdu_text": "بھلا تم نے اس شخص کو دیکھا جس نے منہ پھیر لیا",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4817.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053033.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053033.mp3"
    },
    {
      "ayah_number": 34,
      "global_number": 4818,
      "arabic_text": "وَأَعْطَىٰ قَلِيلًۭا وَأَكْدَىٰٓ",
      "urdu_text": "اور تھوڑا سا دیا (پھر) ہاتھ روک لیا",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4818.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053034.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053034.mp3"
    },
    {
      "ayah_number": 35,
      "global_number": 4819,
      "arabic_text": "أَعِندَهُۥ عِلْمُ ٱلْغَيْبِ فَهُوَ يَرَىٰٓ",
      "urdu_text": "کیا اس کے پاس غیب کا علم ہے کہ وہ اس کو دیکھ رہا ہے",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4819.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053035.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053035.mp3"
    },
    {
      "ayah_number": 36,
      "global_number": 4820,
      "arabic_text": "أَمْ لَمْ يُنَبَّأْ بِمَا فِى صُحُفِ مُوسَىٰ",
      "urdu_text": "کیا جو باتیں موسیٰ کے صحیفوں میں ہیں ان کی اس کو خبر نہیں پہنچی",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4820.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053036.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053036.mp3"
    },
    {
      "ayah_number": 37,
      "global_number": 4821,
      "arabic_text": "وَإِبْرَٰهِيمَ ٱلَّذِى وَفَّىٰٓ",
      "urdu_text": "اور ابراہیمؑ کی جنہوں نے (حق طاعت ورسالت) پورا کیا",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4821.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053037.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053037.mp3"
    },
    {
      "ayah_number": 38,
      "global_number": 4822,
      "arabic_text": "أَلَّا تَزِرُ وَازِرَةٌۭ وِزْرَ أُخْرَىٰ",
      "urdu_text": "یہ کہ کوئی شخص دوسرے (کے گناہ) کا بوجھ نہیں اٹھائے گا",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4822.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053038.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053038.mp3"
    },
    {
      "ayah_number": 39,
      "global_number": 4823,
      "arabic_text": "وَأَن لَّيْسَ لِلْإِنسَٰنِ إِلَّا مَا سَعَىٰ",
      "urdu_text": "اور یہ کہ انسان کو وہی ملتا ہے جس کی وہ کوشش کرتا ہے",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4823.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053039.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053039.mp3"
    },
    {
      "ayah_number": 40,
      "global_number": 4824,
      "arabic_text": "وَأَنَّ سَعْيَهُۥ سَوْفَ يُرَىٰ",
      "urdu_text": "اور یہ کہ اس کی کوشش دیکھی جائے گی",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4824.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053040.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053040.mp3"
    },
    {
      "ayah_number": 41,
      "global_number": 4825,
      "arabic_text": "ثُمَّ يُجْزَىٰهُ ٱلْجَزَآءَ ٱلْأَوْفَىٰ",
      "urdu_text": "پھر اس کو اس کا پورا پورا بدلا دیا جائے گا",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4825.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053041.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053041.mp3"
    },
    {
      "ayah_number": 42,
      "global_number": 4826,
      "arabic_text": "وَأَنَّ إِلَىٰ رَبِّكَ ٱلْمُنتَهَىٰ",
      "urdu_text": "اور یہ کہ تمہارے پروردگار ہی کے پاس پہنچنا ہے",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4826.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053042.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053042.mp3"
    },
    {
      "ayah_number": 43,
      "global_number": 4827,
      "arabic_text": "وَأَنَّهُۥ هُوَ أَضْحَكَ وَأَبْكَىٰ",
      "urdu_text": "اور یہ کہ وہ ہنساتا اور رلاتا ہے",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4827.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053043.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053043.mp3"
    },
    {
      "ayah_number": 44,
      "global_number": 4828,
      "arabic_text": "وَأَنَّهُۥ هُوَ أَمَاتَ وَأَحْيَا",
      "urdu_text": "اور یہ کہ وہی مارتا اور جلاتا ہے",
      "juz": 27,
      "page": 527,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4828.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053044.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053044.mp3"
    },
    {
      "ayah_number": 45,
      "global_number": 4829,
      "arabic_text": "وَأَنَّهُۥ خَلَقَ ٱلزَّوْجَيْنِ ٱلذَّكَرَ وَٱلْأُنثَىٰ",
      "urdu_text": "اور یہ کہ وہی نر اور مادہ دو قسم (کے حیوان) پیدا کرتا ہے",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4829.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053045.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053045.mp3"
    },
    {
      "ayah_number": 46,
      "global_number": 4830,
      "arabic_text": "مِن نُّطْفَةٍ إِذَا تُمْنَىٰ",
      "urdu_text": "(یعنی) نطفے سے جو (رحم میں) ڈالا جاتا ہے",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4830.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053046.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053046.mp3"
    },
    {
      "ayah_number": 47,
      "global_number": 4831,
      "arabic_text": "وَأَنَّ عَلَيْهِ ٱلنَّشْأَةَ ٱلْأُخْرَىٰ",
      "urdu_text": "اور یہ کہ (قیامت کو) اسی پر دوبارہ اٹھانا لازم ہے",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4831.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053047.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053047.mp3"
    },
    {
      "ayah_number": 48,
      "global_number": 4832,
      "arabic_text": "وَأَنَّهُۥ هُوَ أَغْنَىٰ وَأَقْنَىٰ",
      "urdu_text": "اور یہ کہ وہی دولت مند بناتا اور مفلس کرتا ہے",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4832.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053048.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053048.mp3"
    },
    {
      "ayah_number": 49,
      "global_number": 4833,
      "arabic_text": "وَأَنَّهُۥ هُوَ رَبُّ ٱلشِّعْرَىٰ",
      "urdu_text": "اور یہ کہ وہی شعریٰ کا مالک ہے",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4833.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053049.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053049.mp3"
    },
    {
      "ayah_number": 50,
      "global_number": 4834,
      "arabic_text": "وَأَنَّهُۥٓ أَهْلَكَ عَادًا ٱلْأُولَىٰ",
      "urdu_text": "اور یہ کہ اسی نے عاد اول کو ہلاک کر ڈالا",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4834.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053050.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053050.mp3"
    },
    {
      "ayah_number": 51,
      "global_number": 4835,
      "arabic_text": "وَثَمُودَا۟ فَمَآ أَبْقَىٰ",
      "urdu_text": "اور ثمود کو بھی۔ غرض کسی کو باقی نہ چھوڑا",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4835.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053051.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/053051.mp3"
    },
    {
      "ayah_number": 52,
      "global_number": 4836,
      "arabic_text": "وَقَوْمَ نُوحٍۢ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ هُمْ أَظْلَمَ وَأَطْغَىٰ",
      "urdu_text": "اور ان سے پہلے قوم نوحؑ کو بھی۔ کچھ شک نہیں کہ وہ لوگ بڑے ہی ظالم اور بڑے ہی سرکش تھے",
      "juz": 27,
      "page": 528,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4836.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/053052.mp3",
