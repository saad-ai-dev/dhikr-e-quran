{
  "surah_number": 51,
  "name_arabic": "سُورَةُ الذَّارِيَاتِ",
  "name_english": "Adh-Dhaariyat",
  "name_urdu": "The Winnowing Winds",
  "revelation_type": "Meccan",
  "total_ayahs": 60,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 4676,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلذَّٰرِيَٰتِ ذَرْوًۭا",
      "urdu_text": "بکھیرنے والیوں کی قسم جو اُڑا کر بکھیر دیتی ہیں",
      "juz": 26,
      "page": 520,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4676.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 4677,
      "arabic_text": "فَٱلْحَٰمِلَٰتِ وِقْرًۭا",
      "urdu_text": "پھر (پانی کا) بوجھ اٹھاتی ہیں",
      "juz": 26,
      "page": 520,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4677.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 4678,
      "arabic_text": "فَٱلْجَٰرِيَٰتِ يُسْرًۭا",
      "urdu_text": "پھر آہستہ آہستہ چلتی ہیں",
      "juz": 26,
      "page": 520,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4678.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 4679,
      "arabic_text": "فَٱلْمُقَسِّمَٰتِ أَمْرًا",
      "urdu_text": "پھر چیزیں تقسیم کرتی ہیں",
      "juz": 26,
      "page": 520,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4679.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 4680,
      "arabic_text": "إِنَّمَا تُوعَدُونَ لَصَادِقٌۭ",
      "urdu_text": "کہ جس چیز کا تم سے وعدہ کیا جاتا ہے وہ سچا ہے",
      "juz": 26,
      "page": 520,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4680.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 4681,
      "arabic_text": "وَإِنَّ ٱلدِّينَ لَوَٰقِعٌۭ",
      "urdu_text": "اور انصاف (کا دن) ضرور واقع ہوگا",
      "juz": 26,
      "page": 520,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4681.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 4682,
      "arabic_text": "وَٱلسَّمَآءِ ذَاتِ ٱلْحُبُكِ",
      "urdu_text": "اور آسمان کی قسم جس میں رسے ہیں",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4682.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 4683,
      "arabic_text": "إِنَّكُمْ لَفِى قَوْلٍۢ مُّخْتَلِفٍۢ",
      "urdu_text": "کہ (اے اہل مکہ) تم ایک متناقض بات میں (پڑے ہوئے) ہو",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4683.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 4684,
      "arabic_text": "يُؤْفَكُ عَنْهُ مَنْ أُفِكَ",
      "urdu_text": "اس سے وہی پھرتا ہے جو (خدا کی طرف سے) پھیرا جائے",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4684.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 4685,
      "arabic_text": "قُتِلَ ٱلْخَرَّٰصُونَ",
      "urdu_text": "اٹکل دوڑانے والے ہلاک ہوں",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4685.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 4686,
      "arabic_text": "ٱلَّذِينَ هُمْ فِى غَمْرَةٍۢ سَاهُونَ",
      "urdu_text": "جو بےخبری میں بھولے ہوئے ہیں",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4686.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 4687,
      "arabic_text": "يَسْـَٔلُونَ أَيَّانَ يَوْمُ ٱلدِّينِ",
      "urdu_text": "پوچھتے ہیں کہ جزا کا دن کب ہوگا؟",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4687.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 4688,
      "arabic_text": "يَوْمَ هُمْ عَلَى ٱلنَّارِ يُفْتَنُونَ",
      "urdu_text": "اُس دن (ہوگا) جب ان کو آگ میں عذاب دیا جائے گا",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4688.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 4689,
      "arabic_text": "ذُوقُوا۟ فِتْنَتَكُمْ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تَسْتَعْجِلُونَ",
      "urdu_text": "اب اپنی شرارت کا مزہ چکھو۔ یہ وہی ہے جس کے لئے تم جلدی مچایا کرتے تھے",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4689.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 4690,
      "arabic_text": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَعُيُونٍ",
      "urdu_text": "بےشک پرہیزگار بہشتوں اور چشموں میں (عیش کر رہے) ہوں گے",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4690.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 4691,
      "arabic_text": "ءَاخِذِينَ مَآ ءَاتَىٰهُمْ رَبُّهُمْ ۚ إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُحْسِنِينَ",
      "urdu_text": "اور) جو جو (نعمتیں) ان کا پروردگار انہیں دیتا ہوگا ان کو لے رہے ہوں گے۔ بےشک وہ اس سے پہلے نیکیاں کرتے تھے",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4691.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 4692,
      "arabic_text": "كَانُوا۟ قَلِيلًۭا مِّنَ ٱلَّيْلِ مَا يَهْجَعُونَ",
      "urdu_text": "رات کے تھوڑے سے حصے میں سوتے تھے",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4692.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 4693,
      "arabic_text": "وَبِٱلْأَسْحَارِ هُمْ يَسْتَغْفِرُونَ",
      "urdu_text": "اور اوقات سحر میں بخشش مانگا کرتے تھے",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4693.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 4694,
      "arabic_text": "وَفِىٓ أَمْوَٰلِهِمْ حَقٌّۭ لِّلسَّآئِلِ وَٱلْمَحْرُومِ",
      "urdu_text": "اور ان کے مال میں مانگنے والے اور نہ مانگنے والے (دونوں) کا حق ہوتا تھا",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4694.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 4695,
      "arabic_text": "وَفِى ٱلْأَرْضِ ءَايَٰتٌۭ لِّلْمُوقِنِينَ",
      "urdu_text": "اور یقین کرنے والوں کے لئے زمین میں (بہت سی) نشانیاں ہیں",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4695.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 4696,
      "arabic_text": "وَفِىٓ أَنفُسِكُمْ ۚ أَفَلَا تُبْصِرُونَ",
      "urdu_text": "اور خود تمہارے نفوس میں تو کیا تم دیکھتے نہیں؟",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4696.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 4697,
      "arabic_text": "وَفِى ٱلسَّمَآءِ رِزْقُكُمْ وَمَا تُوعَدُونَ",
      "urdu_text": "اور تمہارا رزق اور جس چیز کا تم سے وعدہ کیا جاتا ہے آسمان میں ہے",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4697.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 4698,
      "arabic_text": "فَوَرَبِّ ٱلسَّمَآءِ وَٱلْأَرْضِ إِنَّهُۥ لَحَقٌّۭ مِّثْلَ مَآ أَنَّكُمْ تَنطِقُونَ",
      "urdu_text": "تو آسمانوں اور زمین کے مالک کی قسم! یہ (اسی طرح) قابل یقین ہے جس طرح تم بات کرتے ہو",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4698.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 4699,
      "arabic_text": "هَلْ أَتَىٰكَ حَدِيثُ ضَيْفِ إِبْرَٰهِيمَ ٱلْمُكْرَمِينَ",
      "urdu_text": "بھلا تمہارے پاس ابراہیمؑ کے معزز مہمانوں کی خبر پہنچی ہے؟",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4699.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 4700,
      "arabic_text": "إِذْ دَخَلُوا۟ عَلَيْهِ فَقَالُوا۟ سَلَٰمًۭا ۖ قَالَ سَلَٰمٌۭ قَوْمٌۭ مُّنكَرُونَ",
      "urdu_text": "جب وہ ان کے پاس آئے تو سلام کہا۔ انہوں نے بھی (جواب میں) سلام کہا (دیکھا تو) ایسے لوگ کہ نہ جان نہ پہچان",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4700.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 4701,
      "arabic_text": "فَرَاغَ إِلَىٰٓ أَهْلِهِۦ فَجَآءَ بِعِجْلٍۢ سَمِينٍۢ",
      "urdu_text": "تو اپنے گھر جا کر ایک (بھنا ہوا) موٹا بچھڑا لائے",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4701.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 4702,
      "arabic_text": "فَقَرَّبَهُۥٓ إِلَيْهِمْ قَالَ أَلَا تَأْكُلُونَ",
      "urdu_text": "(اور کھانے کے لئے) ان کے آگے رکھ دیا۔ کہنے لگے کہ آپ تناول کیوں نہیں کرتے؟",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4702.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 4703,
      "arabic_text": "فَأَوْجَسَ مِنْهُمْ خِيفَةًۭ ۖ قَالُوا۟ لَا تَخَفْ ۖ وَبَشَّرُوهُ بِغُلَٰمٍ عَلِيمٍۢ",
      "urdu_text": "اور دل میں ان سے خوف معلوم کیا۔ (انہوں نے) کہا کہ خوف نہ کیجیئے۔ اور ان کو ایک دانشمند لڑکے کی بشارت بھی سنائی",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4703.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 4704,
      "arabic_text": "فَأَقْبَلَتِ ٱمْرَأَتُهُۥ فِى صَرَّةٍۢ فَصَكَّتْ وَجْهَهَا وَقَالَتْ عَجُوزٌ عَقِيمٌۭ",
      "urdu_text": "تو ابراہیمؑ کی بیوی چلاّتی آئی اور اپنا منہ پیٹ کر کہنے لگی کہ (اے ہے ایک تو) بڑھیا اور (دوسرے) بانجھ",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4704.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 4705,
      "arabic_text": "قَالُوا۟ كَذَٰلِكِ قَالَ رَبُّكِ ۖ إِنَّهُۥ هُوَ ٱلْحَكِيمُ ٱلْعَلِيمُ",
      "urdu_text": "(انہوں نے) کہا (ہاں) تمہارے پروردگار نے یوں ہی فرمایا ہے۔ وہ بےشک صاحبِ حکمت (اور) خبردار ہے",
      "juz": 26,
      "page": 521,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4705.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051030.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051030.mp3"
    },
    {
      "ayah_number": 31,
      "global_number": 4706,
      "arabic_text": "۞ قَالَ فَمَا خَطْبُكُمْ أَيُّهَا ٱلْمُرْسَلُونَ",
      "urdu_text": "ابراہیمؑ نے کہا کہ فرشتو! تمہارا مدعا کیا ہے؟",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4706.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051031.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051031.mp3"
    },
    {
      "ayah_number": 32,
      "global_number": 4707,
      "arabic_text": "قَالُوٓا۟ إِنَّآ أُرْسِلْنَآ إِلَىٰ قَوْمٍۢ مُّجْرِمِينَ",
      "urdu_text": "انہوں نے کہا کہ ہم گنہگار لوگوں کی طرف بھیجے گئے ہیں",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4707.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051032.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051032.mp3"
    },
    {
      "ayah_number": 33,
      "global_number": 4708,
      "arabic_text": "لِنُرْسِلَ عَلَيْهِمْ حِجَارَةًۭ مِّن طِينٍۢ",
      "urdu_text": "تاکہ ان پر کھنگر برسائیں",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4708.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051033.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051033.mp3"
    },
    {
      "ayah_number": 34,
      "global_number": 4709,
      "arabic_text": "مُّسَوَّمَةً عِندَ رَبِّكَ لِلْمُسْرِفِينَ",
      "urdu_text": "جن پر حد سے بڑھ جانے والوں کے لئے تمہارے پروردگار کے ہاں سے نشان کردیئے گئے ہیں",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4709.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051034.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051034.mp3"
    },
    {
      "ayah_number": 35,
      "global_number": 4710,
      "arabic_text": "فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ ٱلْمُؤْمِنِينَ",
      "urdu_text": "تو وہاں جتنے مومن تھے ان کو ہم نے نکال لیا",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4710.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051035.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051035.mp3"
    },
    {
      "ayah_number": 36,
      "global_number": 4711,
      "arabic_text": "فَمَا وَجَدْنَا فِيهَا غَيْرَ بَيْتٍۢ مِّنَ ٱلْمُسْلِمِينَ",
      "urdu_text": "اور اس میں ایک گھر کے سوا مسلمانوں کا کوئی گھر نہ پایا",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4711.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051036.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051036.mp3"
    },
    {
      "ayah_number": 37,
      "global_number": 4712,
      "arabic_text": "وَتَرَكْنَا فِيهَآ ءَايَةًۭ لِّلَّذِينَ يَخَافُونَ ٱلْعَذَابَ ٱلْأَلِيمَ",
      "urdu_text": "اور جو لوگ عذاب الیم سے ڈرتے ہیں ان کے لئے وہاں نشانی چھوڑ دی",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4712.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051037.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051037.mp3"
    },
    {
      "ayah_number": 38,
      "global_number": 4713,
      "arabic_text": "وَفِى مُوسَىٰٓ إِذْ أَرْسَلْنَٰهُ إِلَىٰ فِرْعَوْنَ بِسُلْطَٰنٍۢ مُّبِينٍۢ",
      "urdu_text": "اور موسیٰ (کے حال) میں (بھی نشانی ہے) جب ہم نے ان کو فرعون کی طرف کھلا ہوا معجزہ دے کر بھیجا",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4713.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051038.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051038.mp3"
    },
    {
      "ayah_number": 39,
      "global_number": 4714,
      "arabic_text": "فَتَوَلَّىٰ بِرُكْنِهِۦ وَقَالَ سَٰحِرٌ أَوْ مَجْنُونٌۭ",
      "urdu_text": "تو اس نے اپنی جماعت (کے گھمنڈ) پر منہ موڑ لیا اور کہنے لگا یہ تو جادوگر ہے یا دیوانہ",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4714.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051039.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051039.mp3"
    },
    {
      "ayah_number": 40,
      "global_number": 4715,
      "arabic_text": "فَأَخَذْنَٰهُ وَجُنُودَهُۥ فَنَبَذْنَٰهُمْ فِى ٱلْيَمِّ وَهُوَ مُلِيمٌۭ",
      "urdu_text": "تو ہم نے اس کو اور اس کے لشکروں کو پکڑ لیا اور ان کو دریا میں پھینک دیا اور وہ کام ہی قابل ملامت کرتا تھا",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4715.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051040.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051040.mp3"
    },
    {
      "ayah_number": 41,
      "global_number": 4716,
      "arabic_text": "وَفِى عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ ٱلرِّيحَ ٱلْعَقِيمَ",
      "urdu_text": "اور عاد (کی قوم کے حال) میں بھی (نشانی ہے) جب ہم نے ان پر نامبارک ہوا چلائی",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4716.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051041.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051041.mp3"
    },
    {
      "ayah_number": 42,
      "global_number": 4717,
      "arabic_text": "مَا تَذَرُ مِن شَىْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَٱلرَّمِيمِ",
      "urdu_text": "وہ جس چیز پر چلتی اس کو ریزہ ریزہ کئے بغیر نہ چھوڑتی",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4717.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051042.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051042.mp3"
    },
    {
      "ayah_number": 43,
      "global_number": 4718,
      "arabic_text": "وَفِى ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُوا۟ حَتَّىٰ حِينٍۢ",
      "urdu_text": "اور (قوم) ثمود (کے حال) میں (نشانی ہے) جب ان سے کہا گیا کہ ایک وقت تک فائدہ اٹھالو",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4718.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051043.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051043.mp3"
    },
    {
      "ayah_number": 44,
      "global_number": 4719,
      "arabic_text": "فَعَتَوْا۟ عَنْ أَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ ٱلصَّٰعِقَةُ وَهُمْ يَنظُرُونَ",
      "urdu_text": "تو انہوں نے اپنے پروردگار کے حکم سے سرکشی کی۔ سو ان کو کڑک نے آ پکڑا اور وہ دیکھ رہے تھے",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4719.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051044.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051044.mp3"
    },
    {
      "ayah_number": 45,
      "global_number": 4720,
      "arabic_text": "فَمَا ٱسْتَطَٰعُوا۟ مِن قِيَامٍۢ وَمَا كَانُوا۟ مُنتَصِرِينَ",
      "urdu_text": "پھر وہ نہ تو اُٹھنے کی طاقت رکھتے تھے اور نہ مقابلہ ہی کرسکتے تھے",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4720.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051045.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051045.mp3"
    },
    {
      "ayah_number": 46,
      "global_number": 4721,
      "arabic_text": "وَقَوْمَ نُوحٍۢ مِّن قَبْلُ ۖ إِنَّهُمْ كَانُوا۟ قَوْمًۭا فَٰسِقِينَ",
      "urdu_text": "اور اس سے پہلے (ہم) نوح کی قوم کو (ہلاک کرچکے تھے) بےشک وہ نافرمان لوگ تھے",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4721.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051046.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051046.mp3"
    },
    {
      "ayah_number": 47,
      "global_number": 4722,
      "arabic_text": "وَٱلسَّمَآءَ بَنَيْنَٰهَا بِأَيْي۟دٍۢ وَإِنَّا لَمُوسِعُونَ",
      "urdu_text": "اور آسمانوں کو ہم ہی نے ہاتھوں سے بنایا اور ہم کو سب مقدور ہے",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4722.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051047.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051047.mp3"
    },
    {
      "ayah_number": 48,
      "global_number": 4723,
      "arabic_text": "وَٱلْأَرْضَ فَرَشْنَٰهَا فَنِعْمَ ٱلْمَٰهِدُونَ",
      "urdu_text": "اور زمین کو ہم ہی نے بچھایا تو (دیکھو) ہم کیا خوب بچھانے والے ہیں",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4723.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051048.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051048.mp3"
    },
    {
      "ayah_number": 49,
      "global_number": 4724,
      "arabic_text": "وَمِن كُلِّ شَىْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَكَّرُونَ",
      "urdu_text": "اور ہر چیز کی ہم نے دو قسمیں بنائیں تاکہ تم نصیحت پکڑو",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4724.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051049.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051049.mp3"
    },
    {
      "ayah_number": 50,
      "global_number": 4725,
      "arabic_text": "فَفِرُّوٓا۟ إِلَى ٱللَّهِ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌۭ مُّبِينٌۭ",
      "urdu_text": "تو تم لوگ خدا کی طرف بھاگ چلو میں اس کی طرف سے تم کو صریح رستہ بتانے والا ہوں",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4725.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051050.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051050.mp3"
    },
    {
      "ayah_number": 51,
      "global_number": 4726,
      "arabic_text": "وَلَا تَجْعَلُوا۟ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ ۖ إِنِّى لَكُم مِّنْهُ نَذِيرٌۭ مُّبِينٌۭ",
      "urdu_text": "اور خدا کے ساتھ کسی اَور کو معبود نہ بناؤ۔ میں اس کی طرف سے تم کو صریح رستہ بتانے والا ہوں",
      "juz": 27,
      "page": 522,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4726.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051051.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051051.mp3"
    },
    {
      "ayah_number": 52,
      "global_number": 4727,
      "arabic_text": "كَذَٰلِكَ مَآ أَتَى ٱلَّذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ إِلَّا قَالُوا۟ سَاحِرٌ أَوْ مَجْنُونٌ",
      "urdu_text": "اسی طرح ان سے پہلے لوگوں کے پاس جو پیغمبر آتا وہ اس کو جادوگر یا دیوانہ کہتے",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4727.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051052.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051052.mp3"
    },
    {
      "ayah_number": 53,
      "global_number": 4728,
      "arabic_text": "أَتَوَاصَوْا۟ بِهِۦ ۚ بَلْ هُمْ قَوْمٌۭ طَاغُونَ",
      "urdu_text": "کیا یہ کہ ایک دوسرے کو اسی بات کی وصیت کرتے آئے ہیں بلکہ یہ شریر لوگ ہیں",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4728.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051053.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051053.mp3"
    },
    {
      "ayah_number": 54,
      "global_number": 4729,
      "arabic_text": "فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومٍۢ",
      "urdu_text": "تو ان سے اعراض کرو۔ تم کو (ہماری) طرف سے ملامت نہ ہوگی",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4729.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051054.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051054.mp3"
    },
    {
      "ayah_number": 55,
      "global_number": 4730,
      "arabic_text": "وَذَكِّرْ فَإِنَّ ٱلذِّكْرَىٰ تَنفَعُ ٱلْمُؤْمِنِينَ",
      "urdu_text": "اور نصیحت کرتے رہو کہ نصیحت مومنوں کو نفع دیتی ہے",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4730.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051055.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051055.mp3"
    },
    {
      "ayah_number": 56,
      "global_number": 4731,
      "arabic_text": "وَمَا خَلَقْتُ ٱلْجِنَّ وَٱلْإِنسَ إِلَّا لِيَعْبُدُونِ",
      "urdu_text": "اور میں نے جنوں اور انسانوں کو اس لئے پیدا کیا ہے کہ میری عبادت کریں",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4731.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051056.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051056.mp3"
    },
    {
      "ayah_number": 57,
      "global_number": 4732,
      "arabic_text": "مَآ أُرِيدُ مِنْهُم مِّن رِّزْقٍۢ وَمَآ أُرِيدُ أَن يُطْعِمُونِ",
      "urdu_text": "میں ان سے طالب رزق نہیں اور نہ یہ چاہتا ہوں کہ مجھے (کھانا) کھلائیں",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4732.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051057.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051057.mp3"
    },
    {
      "ayah_number": 58,
      "global_number": 4733,
      "arabic_text": "إِنَّ ٱللَّهَ هُوَ ٱلرَّزَّاقُ ذُو ٱلْقُوَّةِ ٱلْمَتِينُ",
      "urdu_text": "خدا ہی تو رزق دینے والا زور آور اور مضبوط ہے",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4733.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051058.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051058.mp3"
    },
    {
      "ayah_number": 59,
      "global_number": 4734,
      "arabic_text": "فَإِنَّ لِلَّذِينَ ظَلَمُوا۟ ذَنُوبًۭا مِّثْلَ ذَنُوبِ أَصْحَٰبِهِمْ فَلَا يَسْتَعْجِلُونِ",
      "urdu_text": "کچھ شک نہیں کہ ان ظالموں کے لئے بھی (عذاب کی) نوبت مقرر ہے جس طرح ان کے ساتھیوں کی نوبت تھی تو ان کو مجھ سے (عذاب) جلدی نہیں طلب کرنا چاہیئے",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4734.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/051059.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/051059.mp3"
    },
    {
      "ayah_number": 60,
      "global_number": 4735,
      "arabic_text": "فَوَيْلٌۭ لِّلَّذِينَ كَفَرُوا۟ مِن يَوْمِهِمُ ٱلَّذِى يُوعَدُونَ",
      "urdu_text": "جس دن کا ان کافروں سے وعدہ کیا جاتا ہے اس سے ان کے لئے خرابی ہے",
      "juz": 27,
      "page": 523,
