{
  "surah_number": 95,
  "name_arabic": "سُورَةُ التِّينِ",
  "name_english": "At-Tin",
  "name_urdu": "The Fig",
  "revelation_type": "Meccan",
  "total_ayahs": 8,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 6099,
      "arabic_text": "بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلتِّينِ وَٱلزَّيْتُونِ",
      "urdu_text": "انجیر کی قسم اور زیتون کی",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6099.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/095001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/095001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 6100,
      "arabic_text": "وَطُورِ سِينِينَ",
      "urdu_text": "اور طور سینین کی",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6100.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/095002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/095002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 6101,
      "arabic_text": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ",
      "urdu_text": "اور اس امن والے شہر کی",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6101.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/095003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/095003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 6102,
      "arabic_text": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍۢ",
      "urdu_text": "کہ ہم نے انسان کو بہت اچھی صورت میں پیدا کیا ہے",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6102.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/095004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/095004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 6103,
      "arabic_text": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ",
      "urdu_text": "پھر (رفتہ رفتہ) اس (کی حالت) کو (بدل کر) پست سے پست کر دیا",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6103.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/095005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/095005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 6104,
      "arabic_text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۢ",
      "urdu_text": "مگر جو لوگ ایمان لائے اور نیک عمل کرتے رہے انکے لیے بےانتہا اجر ہے",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6104.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/095006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/095006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 6105,
      "arabic_text": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ",
      "urdu_text": "تو (اے آدم زاد) پھر تو جزا کے دن کو کیوں جھٹلاتا ہے؟",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6105.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/095007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/095007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 6106,
      "arabic_text": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ",
      "urdu_text": "کیا خدا سب سے بڑا حاکم نہیں ہے؟",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6106.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/095008.mp3",
