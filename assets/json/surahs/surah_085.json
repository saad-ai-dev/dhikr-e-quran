{
  "surah_number": 85,
  "name_arabic": "سُورَةُ البُرُوجِ",
  "name_english": "Al-Burooj",
  "name_urdu": "The Constellations",
  "revelation_type": "Meccan",
  "total_ayahs": 22,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5910,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ",
      "urdu_text": "آسمان کی قسم جس میں برج ہیں",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5910.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5911,
      "arabic_text": "وَٱلْيَوْمِ ٱلْمَوْعُودِ",
      "urdu_text": "اور اس دن کی جس کا وعدہ ہے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5911.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5912,
      "arabic_text": "وَشَاهِدٍۢ وَمَشْهُودٍۢ",
      "urdu_text": "اور حاضر ہونے والے کی اور جو اس کے پاس حاضر کیا جائے اسکی",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5912.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5913,
      "arabic_text": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ",
      "urdu_text": "کہ خندقوں (کے کھودنے) والے ہلاک کر دیئے گئے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5913.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5914,
      "arabic_text": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ",
      "urdu_text": "(یعنی) آگ (کی خندقیں) جس میں ایندھن (جھونک رکھا) تھا",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5914.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5915,
      "arabic_text": "إِذْ هُمْ عَلَيْهَا قُعُودٌۭ",
      "urdu_text": "جب کہ وہ ان (کے کناروں) پر بیٹھے ہوئے تھے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5915.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5916,
      "arabic_text": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌۭ",
      "urdu_text": "اور جو (سختیاں) اہل ایمان پر کر رہے تھے ان کو سامنے دیکھ رہے تھے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5916.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5917,
      "arabic_text": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ",
      "urdu_text": "ان کو مومنوں کی یہی بات بری لگتی تھی کہ وہ خدا پر ایمان لائے ہوئے تھے جو غالب (اور) قابل ستائش ہے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5917.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5918,
      "arabic_text": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍۢ شَهِيدٌ",
      "urdu_text": "وہی جس کی آسمانوں اور زمین میں بادشاہت ہے۔ اور خدا ہر چیز سے واقف ہے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5918.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5919,
      "arabic_text": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ",
      "urdu_text": "جن لوگوں نے مومن مردوں اور مومن عورتوں کو تکلیفیں دیں اور توبہ نہ کی ان کو دوزخ کا (اور) عذاب بھی ہوگا اور جلنے کا عذاب بھی ہوگا",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5919.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5920,
      "arabic_text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌۭ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ",
      "urdu_text": "(اور) جو لوگ ایمان لائے اور نیک کام کرتے رہے ان کے لیے باغات ہیں جن کے نیچے نہریں بہہ رہی ہیں۔ یہ ہی بڑی کامیابی ہے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5920.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5921,
      "arabic_text": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ",
      "urdu_text": "بےشک تمہارے پروردگار کی پکڑ بڑی سخت ہے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5921.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5922,
      "arabic_text": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ",
      "urdu_text": "وہی پہلی دفعہ پیدا کرتا ہے اور وہی دوبارہ (زندہ) کرے گا",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5922.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5923,
      "arabic_text": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ",
      "urdu_text": "اور وہ بخشنے والا اور محبت کرنے والا ہے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5923.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5924,
      "arabic_text": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ",
      "urdu_text": "عرش کا مالک بڑی شان والا",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5924.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5925,
      "arabic_text": "فَعَّالٌۭ لِّمَا يُرِيدُ",
      "urdu_text": "جو چاہتا ہے کر دیتا ہے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5925.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5926,
      "arabic_text": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ",
      "urdu_text": "بھلا تم کو لشکروں کا حال معلوم ہوا ہے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5926.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5927,
      "arabic_text": "فِرْعَوْنَ وَثَمُودَ",
      "urdu_text": "(یعنی) فرعون اور ثمود کا",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5927.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5928,
      "arabic_text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍۢ",
      "urdu_text": "لیکن کافر (جان بوجھ کر) تکذیب میں (گرفتار) ہیں",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5928.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5929,
      "arabic_text": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ",
      "urdu_text": "اور خدا (بھی) ان کو گردا گرد سے گھیرے ہوئے ہے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5929.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5930,
      "arabic_text": "بَلْ هُوَ قُرْءَانٌۭ مَّجِيدٌۭ",
      "urdu_text": "(یہ کتاب ہزل و بطلان نہیں) بلکہ یہ قرآن عظیم الشان ہے",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5930.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5931,
      "arabic_text": "فِى لَوْحٍۢ مَّحْفُوظٍۭ",
      "urdu_text": "لوح محفوظ میں (لکھا ہوا)",
      "juz": 30,
      "page": 590,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5931.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/085022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/085022.mp3"
    }
  ]
}