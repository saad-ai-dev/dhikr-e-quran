{
  "surah_number": 68,
  "name_arabic": "سُورَةُ القَلَمِ",
  "name_english": "Al-Qalam",
  "name_urdu": "The Pen",
  "revelation_type": "Meccan",
  "total_ayahs": 52,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5272,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ نٓ ۚ وَٱلْقَلَمِ وَمَا يَسْطُرُونَ",
      "urdu_text": "نٓ۔ قلم کی اور جو (اہل قلم) لکھتے ہیں اس کی قسم",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5272.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5273,
      "arabic_text": "مَآ أَنتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍۢ",
      "urdu_text": "کہ (اے محمدﷺ) تم اپنے پروردگار کے فضل سے دیوانے نہیں ہو",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5273.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5274,
      "arabic_text": "وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍۢ",
      "urdu_text": "اور تمہارے لئے بے انتہا اجر ہے",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5274.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5275,
      "arabic_text": "وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍۢ",
      "urdu_text": "اور اخلاق تمہارے بہت (عالی) ہیں",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5275.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5276,
      "arabic_text": "فَسَتُبْصِرُ وَيُبْصِرُونَ",
      "urdu_text": "سو عنقریب تم بھی دیکھ لو گے اور یہ (کافر) بھی دیکھ لیں گے",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5276.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5277,
      "arabic_text": "بِأَييِّكُمُ ٱلْمَفْتُونُ",
      "urdu_text": "کہ تم میں سے کون دیوانہ ہے",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5277.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5278,
      "arabic_text": "إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ",
      "urdu_text": "تمہارا پروردگار اس کو بھی خوب جانتا ہے جو اس کے رستے سے بھٹک گیا اور ان کو بھی خوب جانتا ہے جو سیدھے راستے پر چل رہے ہیں",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5278.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5279,
      "arabic_text": "فَلَا تُطِعِ ٱلْمُكَذِّبِينَ",
      "urdu_text": "تو تم جھٹلانے والوں کا کہا نہ ماننا",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5279.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5280,
      "arabic_text": "وَدُّوا۟ لَوْ تُدْهِنُ فَيُدْهِنُونَ",
      "urdu_text": "یہ لوگ چاہتے ہیں کہ تم نرمی اختیار کرو تو یہ بھی نرم ہوجائیں",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5280.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5281,
      "arabic_text": "وَلَا تُطِعْ كُلَّ حَلَّافٍۢ مَّهِينٍ",
      "urdu_text": "اور کسی ایسے شخص کے کہے میں نہ آجانا جو بہت قسمیں کھانے والا ذلیل اوقات ہے",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5281.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5282,
      "arabic_text": "هَمَّازٍۢ مَّشَّآءٍۭ بِنَمِيمٍۢ",
      "urdu_text": "طعن آمیز اشارتیں کرنے والا چغلیاں لئے پھرنے والا",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5282.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5283,
      "arabic_text": "مَّنَّاعٍۢ لِّلْخَيْرِ مُعْتَدٍ أَثِيمٍ",
      "urdu_text": "مال میں بخل کرنے والا حد سے بڑھا ہوا بدکار",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5283.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5284,
      "arabic_text": "عُتُلٍّۭ بَعْدَ ذَٰلِكَ زَنِيمٍ",
      "urdu_text": "سخت خو اور اس کے علاوہ بدذات ہے",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5284.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5285,
      "arabic_text": "أَن كَانَ ذَا مَالٍۢ وَبَنِينَ",
      "urdu_text": "اس سبب سے کہ مال اور بیٹے رکھتا ہے",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5285.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5286,
      "arabic_text": "إِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا قَالَ أَسَٰطِيرُ ٱلْأَوَّلِينَ",
      "urdu_text": "جب اس کو ہماری آیتیں پڑھ کر سنائی جاتی ہیں تو کہتا ہے کہ یہ اگلے لوگوں کے افسانے ہیں",
      "juz": 29,
      "page": 564,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5286.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5287,
      "arabic_text": "سَنَسِمُهُۥ عَلَى ٱلْخُرْطُومِ",
      "urdu_text": "ہم عنقریب اس کی ناک پر داغ لگائیں گے",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5287.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5288,
      "arabic_text": "إِنَّا بَلَوْنَٰهُمْ كَمَا بَلَوْنَآ أَصْحَٰبَ ٱلْجَنَّةِ إِذْ أَقْسَمُوا۟ لَيَصْرِمُنَّهَا مُصْبِحِينَ",
      "urdu_text": "ہم نے ان لوگوں کی اسی طرح آزمائش کی ہے جس طرح باغ والوں کی آزمائش کی تھی۔ جب انہوں نے قسمیں کھا کھا کر کہا کہ صبح ہوتے ہوتے ہم اس کا میوہ توڑ لیں گے",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5288.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5289,
      "arabic_text": "وَلَا يَسْتَثْنُونَ",
      "urdu_text": "اور انشاء الله نہ کہا",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5289.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5290,
      "arabic_text": "فَطَافَ عَلَيْهَا طَآئِفٌۭ مِّن رَّبِّكَ وَهُمْ نَآئِمُونَ",
      "urdu_text": "سو وہ ابھی سو ہی رہے تھے کہ تمہارے پروردگار کی طرف سے (راتوں رات) اس پر ایک آفت پھر گئی",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5290.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5291,
      "arabic_text": "فَأَصْبَحَتْ كَٱلصَّرِيمِ",
      "urdu_text": "تو وہ ایسا ہوگیا جیسے کٹی ہوئی کھیتی",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5291.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5292,
      "arabic_text": "فَتَنَادَوْا۟ مُصْبِحِينَ",
      "urdu_text": "جب صبح ہوئی تو وہ لوگ ایک دوسرے کو پکارنے لگے",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5292.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5293,
      "arabic_text": "أَنِ ٱغْدُوا۟ عَلَىٰ حَرْثِكُمْ إِن كُنتُمْ صَٰرِمِينَ",
      "urdu_text": "اگر تم کو کاٹنا ہے تو اپنی کھیتی پر سویرے ہی جا پہنچو",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5293.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5294,
      "arabic_text": "فَٱنطَلَقُوا۟ وَهُمْ يَتَخَٰفَتُونَ",
      "urdu_text": "تو وہ چل پڑے اور آپس میں چپکے چپکے کہتے جاتے تھے",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5294.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5295,
      "arabic_text": "أَن لَّا يَدْخُلَنَّهَا ٱلْيَوْمَ عَلَيْكُم مِّسْكِينٌۭ",
      "urdu_text": "آج یہاں تمہارے پاس کوئی فقیر نہ آنے پائے",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5295.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5296,
      "arabic_text": "وَغَدَوْا۟ عَلَىٰ حَرْدٍۢ قَٰدِرِينَ",
      "urdu_text": "اور کوشش کے ساتھ سویرے ہی جا پہنچے (گویا کھیتی پر) قادر ہیں",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5296.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 5297,
      "arabic_text": "فَلَمَّا رَأَوْهَا قَالُوٓا۟ إِنَّا لَضَآلُّونَ",
      "urdu_text": "جب باغ کو دیکھا تو (ویران) کہنے لگے کہ ہم رستہ بھول گئے ہیں",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5297.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 5298,
      "arabic_text": "بَلْ نَحْنُ مَحْرُومُونَ",
      "urdu_text": "نہیں بلکہ ہم (برگشتہ نصیب) بےنصیب ہیں",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5298.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 5299,
      "arabic_text": "قَالَ أَوْسَطُهُمْ أَلَمْ أَقُل لَّكُمْ لَوْلَا تُسَبِّحُونَ",
      "urdu_text": "ایک جو اُن میں فرزانہ تھا بولا کہ کیا میں نے تم سے نہیں کہا تھا کہ تم تسبیح کیوں نہیں کرتے؟",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5299.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 5300,
      "arabic_text": "قَالُوا۟ سُبْحَٰنَ رَبِّنَآ إِنَّا كُنَّا ظَٰلِمِينَ",
      "urdu_text": "(تب) وہ کہنے لگے کہ ہمارا پروردگار پاک ہے بےشک ہم ہی قصوروار تھے",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5300.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 5301,
      "arabic_text": "فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَلَٰوَمُونَ",
      "urdu_text": "پھر لگے ایک دوسرے کو رو در رو ملامت کرنے",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5301.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068030.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068030.mp3"
    },
    {
      "ayah_number": 31,
      "global_number": 5302,
      "arabic_text": "قَالُوا۟ يَٰوَيْلَنَآ إِنَّا كُنَّا طَٰغِينَ",
      "urdu_text": "کہنے لگے ہائے شامت ہم ہی حد سے بڑھ گئے تھے",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5302.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068031.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068031.mp3"
    },
    {
      "ayah_number": 32,
      "global_number": 5303,
      "arabic_text": "عَسَىٰ رَبُّنَآ أَن يُبْدِلَنَا خَيْرًۭا مِّنْهَآ إِنَّآ إِلَىٰ رَبِّنَا رَٰغِبُونَ",
      "urdu_text": "امید ہے کہ ہمارا پروردگار اس کے بدلے میں ہمیں اس سے بہتر باغ عنایت کرے ہم اپنے پروردگار کی طرف سے رجوع لاتے ہیں",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5303.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068032.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068032.mp3"
    },
    {
      "ayah_number": 33,
      "global_number": 5304,
      "arabic_text": "كَذَٰلِكَ ٱلْعَذَابُ ۖ وَلَعَذَابُ ٱلْءَاخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا۟ يَعْلَمُونَ",
      "urdu_text": "(دیکھو) عذاب یوں ہوتا ہے۔ اور آخرت کا عذاب اس سے کہیں بڑھ کر ہے۔ کاش! یہ لوگ جانتے ہوتے",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5304.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068033.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068033.mp3"
    },
    {
      "ayah_number": 34,
      "global_number": 5305,
      "arabic_text": "إِنَّ لِلْمُتَّقِينَ عِندَ رَبِّهِمْ جَنَّٰتِ ٱلنَّعِيمِ",
      "urdu_text": "پرہیزگاروں کے لئے ان کے پروردگار کے ہاں نعمت کے باغ ہیں",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5305.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068034.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068034.mp3"
    },
    {
      "ayah_number": 35,
      "global_number": 5306,
      "arabic_text": "أَفَنَجْعَلُ ٱلْمُسْلِمِينَ كَٱلْمُجْرِمِينَ",
      "urdu_text": "کیا ہم فرمانبرداروں کو نافرمانوں کی طرف (نعمتوں سے) محروم کردیں گے؟",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5306.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068035.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068035.mp3"
    },
    {
      "ayah_number": 36,
      "global_number": 5307,
      "arabic_text": "مَا لَكُمْ كَيْفَ تَحْكُمُونَ",
      "urdu_text": "تمہیں کیا ہوگیا ہے کیسی تجویزیں کرتے ہو؟",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5307.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068036.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068036.mp3"
    },
    {
      "ayah_number": 37,
      "global_number": 5308,
      "arabic_text": "أَمْ لَكُمْ كِتَٰبٌۭ فِيهِ تَدْرُسُونَ",
      "urdu_text": "کیا تمہارے پاس کوئی کتاب ہے جس میں (یہ) پڑھتے ہو",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5308.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068037.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068037.mp3"
    },
    {
      "ayah_number": 38,
      "global_number": 5309,
      "arabic_text": "إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ",
      "urdu_text": "کہ جو چیز تم پسند کرو گے وہ تم کو ضرور ملے گی",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5309.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068038.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068038.mp3"
    },
    {
      "ayah_number": 39,
      "global_number": 5310,
      "arabic_text": "أَمْ لَكُمْ أَيْمَٰنٌ عَلَيْنَا بَٰلِغَةٌ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ",
      "urdu_text": "یا تم نے ہم سے قسمیں لے رکھی ہیں جو قیامت کے دن تک چلی جائیں گی کہ جس شے کا تم حکم کرو گے وہ تمہارے لئے حاضر ہوگی",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5310.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068039.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068039.mp3"
    },
    {
      "ayah_number": 40,
      "global_number": 5311,
      "arabic_text": "سَلْهُمْ أَيُّهُم بِذَٰلِكَ زَعِيمٌ",
      "urdu_text": "ان سے پوچھو کہ ان میں سے اس کا کون ذمہ لیتا ہے؟",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5311.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068040.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068040.mp3"
    },
    {
      "ayah_number": 41,
      "global_number": 5312,
      "arabic_text": "أَمْ لَهُمْ شُرَكَآءُ فَلْيَأْتُوا۟ بِشُرَكَآئِهِمْ إِن كَانُوا۟ صَٰدِقِينَ",
      "urdu_text": "کیا (اس قول میں) ان کے اور بھی شریک ہیں؟ اگر یہ سچے ہیں تو اپنے شریکوں کو لا سامنے کریں",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5312.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068041.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068041.mp3"
    },
    {
      "ayah_number": 42,
      "global_number": 5313,
      "arabic_text": "يَوْمَ يُكْشَفُ عَن سَاقٍۢ وَيُدْعَوْنَ إِلَى ٱلسُّجُودِ فَلَا يَسْتَطِيعُونَ",
      "urdu_text": "جس دن پنڈلی سے کپڑا اٹھا دیا جائے گا اور کفار سجدے کے لئے بلائے جائیں گے تو سجدہ نہ کرسکیں گے",
      "juz": 29,
      "page": 565,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5313.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068042.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068042.mp3"
    },
    {
      "ayah_number": 43,
      "global_number": 5314,
      "arabic_text": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۖ وَقَدْ كَانُوا۟ يُدْعَوْنَ إِلَى ٱلسُّجُودِ وَهُمْ سَٰلِمُونَ",
      "urdu_text": "ان کی آنکھیں جھکی ہوئی ہوں گی اور ان پر ذلت چھا رہی ہوگی حالانکہ پہلے (اُس وقت) سجدے کے لئے بلاتے جاتے تھے جب کہ صحیح وسالم تھے",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5314.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068043.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068043.mp3"
    },
    {
      "ayah_number": 44,
      "global_number": 5315,
      "arabic_text": "فَذَرْنِى وَمَن يُكَذِّبُ بِهَٰذَا ٱلْحَدِيثِ ۖ سَنَسْتَدْرِجُهُم مِّنْ حَيْثُ لَا يَعْلَمُونَ",
      "urdu_text": "تو مجھ کو اس کلام کے جھٹلانے والوں سے سمجھ لینے دو۔ ہم ان کو آہستہ آہستہ ایسے طریق سے پکڑیں گے کہ ان کو خبر بھی نہ ہوگی",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5315.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068044.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068044.mp3"
    },
    {
      "ayah_number": 45,
      "global_number": 5316,
      "arabic_text": "وَأُمْلِى لَهُمْ ۚ إِنَّ كَيْدِى مَتِينٌ",
      "urdu_text": "اور میں ان کو مہلت دیئے جاتا ہوں میری تدبیر قوی ہے",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5316.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068045.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068045.mp3"
    },
    {
      "ayah_number": 46,
      "global_number": 5317,
      "arabic_text": "أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ",
      "urdu_text": "کیا تم ان سے کچھ اجر مانگتے ہو کہ ان پر تاوان کا بوجھ پڑ رہا ہے",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5317.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068046.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068046.mp3"
    },
    {
      "ayah_number": 47,
      "global_number": 5318,
      "arabic_text": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ",
      "urdu_text": "یا ان کے پاس غیب کی خبر ہے کہ (اسے) لکھتے جاتے ہیں",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5318.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068047.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068047.mp3"
    },
    {
      "ayah_number": 48,
      "global_number": 5319,
      "arabic_text": "فَٱصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُن كَصَاحِبِ ٱلْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌۭ",
      "urdu_text": "تو اپنے پروردگار کے حکم کے انتظار میں صبر کئے رہو اور مچھلی (کا لقمہ ہونے) والے یونس کی طرح رہو نا کہ انہوں نے (خدا) کو پکارا اور وہ (غم و) غصے میں بھرے ہوئے تھے",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5319.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068048.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068048.mp3"
    },
    {
      "ayah_number": 49,
      "global_number": 5320,
      "arabic_text": "لَّوْلَآ أَن تَدَٰرَكَهُۥ نِعْمَةٌۭ مِّن رَّبِّهِۦ لَنُبِذَ بِٱلْعَرَآءِ وَهُوَ مَذْمُومٌۭ",
      "urdu_text": "اگر تمہارے پروردگار کی مہربانی ان کی یاوری نہ کرتی تو وہ چٹیل میدان میں ڈال دیئے جاتے اور ان کا حال ابتر ہوجاتا",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5320.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068049.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068049.mp3"
    },
    {
      "ayah_number": 50,
      "global_number": 5321,
      "arabic_text": "فَٱجْتَبَٰهُ رَبُّهُۥ فَجَعَلَهُۥ مِنَ ٱلصَّٰلِحِينَ",
      "urdu_text": "پھر پروردگار نے ان کو برگزیدہ کرکے نیکوکاروں میں کرلیا",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5321.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068050.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068050.mp3"
    },
    {
      "ayah_number": 51,
      "global_number": 5322,
      "arabic_text": "وَإِن يَكَادُ ٱلَّذِينَ كَفَرُوا۟ لَيُزْلِقُونَكَ بِأَبْصَٰرِهِمْ لَمَّا سَمِعُوا۟ ٱلذِّكْرَ وَيَقُولُونَ إِنَّهُۥ لَمَجْنُونٌۭ",
      "urdu_text": "اور کافر جب (یہ) نصیحت (کی کتاب) سنتے ہیں تو یوں لگتے ہیں کہ تم کو اپنی نگاہوں سے پھسلا دیں گے اور کہتے یہ تو دیوانہ ہے",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5322.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/068051.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/068051.mp3"
    },
    {
      "ayah_number": 52,
