{
  "surah_number": 52,
  "name_arabic": "سُورَةُ الطُّورِ",
  "name_english": "At-Tur",
  "name_urdu": "The Mount",
  "revelation_type": "Meccan",
  "total_ayahs": 49,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 4736,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلطُّورِ",
      "urdu_text": "(کوہ) طور کی قسم",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4736.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 4737,
      "arabic_text": "وَكِتَٰبٍۢ مَّسْطُورٍۢ",
      "urdu_text": "اور کتاب کی جو لکھی ہوئی ہے",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4737.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 4738,
      "arabic_text": "فِى رَقٍّۢ مَّنشُورٍۢ",
      "urdu_text": "کشادہ اوراق میں",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4738.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 4739,
      "arabic_text": "وَٱلْبَيْتِ ٱلْمَعْمُورِ",
      "urdu_text": "اور آباد گھر کی",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4739.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 4740,
      "arabic_text": "وَٱلسَّقْفِ ٱلْمَرْفُوعِ",
      "urdu_text": "اور اونچی چھت کی",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4740.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 4741,
      "arabic_text": "وَٱلْبَحْرِ ٱلْمَسْجُورِ",
      "urdu_text": "اور ابلتے ہوئے دریا کی",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4741.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 4742,
      "arabic_text": "إِنَّ عَذَابَ رَبِّكَ لَوَٰقِعٌۭ",
      "urdu_text": "کہ تمہارے پروردگار کا عذاب واقع ہو کر رہے گا",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4742.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 4743,
      "arabic_text": "مَّا لَهُۥ مِن دَافِعٍۢ",
      "urdu_text": "(اور) اس کو کوئی روک نہیں سکے گا",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4743.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 4744,
      "arabic_text": "يَوْمَ تَمُورُ ٱلسَّمَآءُ مَوْرًۭا",
      "urdu_text": "جس دن آسمان لرزنے لگا کپکپا کر",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4744.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 4745,
      "arabic_text": "وَتَسِيرُ ٱلْجِبَالُ سَيْرًۭا",
      "urdu_text": "اور پہاڑ اُڑنے لگے اون ہو کر",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4745.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 4746,
      "arabic_text": "فَوَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "urdu_text": "اس دن جھٹلانے والوں کے لئے خرابی ہے",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4746.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 4747,
      "arabic_text": "ٱلَّذِينَ هُمْ فِى خَوْضٍۢ يَلْعَبُونَ",
      "urdu_text": "جو خوض (باطل) میں پڑے کھیل رہے ہیں",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4747.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 4748,
      "arabic_text": "يَوْمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا",
      "urdu_text": "جس دن ان کو آتش جہنم کی طرف دھکیل دھکیل کر لے جائیں گے",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4748.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 4749,
      "arabic_text": "هَٰذِهِ ٱلنَّارُ ٱلَّتِى كُنتُم بِهَا تُكَذِّبُونَ",
      "urdu_text": "یہی وہ جہنم ہے جس کو تم جھوٹ سمجھتے تھے",
      "juz": 27,
      "page": 523,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4749.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 4750,
      "arabic_text": "أَفَسِحْرٌ هَٰذَآ أَمْ أَنتُمْ لَا تُبْصِرُونَ",
      "urdu_text": "تو کیا یہ جادو ہے یا تم کو نظر ہی نہیں آتا",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4750.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 4751,
      "arabic_text": "ٱصْلَوْهَا فَٱصْبِرُوٓا۟ أَوْ لَا تَصْبِرُوا۟ سَوَآءٌ عَلَيْكُمْ ۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ",
      "urdu_text": "اس میں داخل ہوجاؤ اور صبر کرو یا نہ کرو تمہارے لئے یکساں ہے۔ جو کام تم کیا کرتے تھے (یہ) انہی کا تم کو بدلہ مل رہا ہے",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4751.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 4752,
      "arabic_text": "إِنَّ ٱلْمُتَّقِينَ فِى جَنَّٰتٍۢ وَنَعِيمٍۢ",
      "urdu_text": "جو پرہیزگار ہیں وہ باغوں اور نعتموں میں ہوں گے",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4752.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 4753,
      "arabic_text": "فَٰكِهِينَ بِمَآ ءَاتَىٰهُمْ رَبُّهُمْ وَوَقَىٰهُمْ رَبُّهُمْ عَذَابَ ٱلْجَحِيمِ",
      "urdu_text": "جو کچھ ان کے پروردگار نے ان کو بخشا اس (کی وجہ) سے خوشحال۔ اور ان کے پروردگار نے ان کو دوزخ کے عذاب سے بچا لیا",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4753.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 4754,
      "arabic_text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
      "urdu_text": "اپنے اعمال کے صلے میں مزے سے کھاؤ اور پیو",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4754.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 4755,
      "arabic_text": "مُتَّكِـِٔينَ عَلَىٰ سُرُرٍۢ مَّصْفُوفَةٍۢ ۖ وَزَوَّجْنَٰهُم بِحُورٍ عِينٍۢ",
      "urdu_text": "تختوں پر جو برابر برابر بچھے ہوئے ہیں تکیہ لگائے ہوئے اور بڑی بڑی آنکھوں والی حوروں سے ہم ان کا عقد کر دیں گے",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4755.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 4756,
      "arabic_text": "وَٱلَّذِينَ ءَامَنُوا۟ وَٱتَّبَعَتْهُمْ ذُرِّيَّتُهُم بِإِيمَٰنٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَآ أَلَتْنَٰهُم مِّنْ عَمَلِهِم مِّن شَىْءٍۢ ۚ كُلُّ ٱمْرِئٍۭ بِمَا كَسَبَ رَهِينٌۭ",
      "urdu_text": "اور جو لوگ ایمان لائے اور ان کی اولاد بھی (راہ) ایمان میں ان کے پیچھے چلی۔ ہم ان کی اولاد کو بھی ان (کے درجے) تک پہنچا دیں گے اور ان کے اعمال میں سے کچھ کم نہ کریں گے۔ ہر شخص اپنے اعمال میں پھنسا ہوا ہے",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4756.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 4757,
      "arabic_text": "وَأَمْدَدْنَٰهُم بِفَٰكِهَةٍۢ وَلَحْمٍۢ مِّمَّا يَشْتَهُونَ",
      "urdu_text": "اور جس طرح کے میوے اور گوشت کو ان کا جی چاہے گا ہم ان کو عطا کریں گے",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4757.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 4758,
      "arabic_text": "يَتَنَٰزَعُونَ فِيهَا كَأْسًۭا لَّا لَغْوٌۭ فِيهَا وَلَا تَأْثِيمٌۭ",
      "urdu_text": "وہاں وہ ایک دوسرے سے جام شراب جھپٹ لیا کریں گے جس (کے پینے) سے نہ ہذیان سرائی ہوگی نہ کوئی گناہ کی بات",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4758.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 4759,
      "arabic_text": "۞ وَيَطُوفُ عَلَيْهِمْ غِلْمَانٌۭ لَّهُمْ كَأَنَّهُمْ لُؤْلُؤٌۭ مَّكْنُونٌۭ",
      "urdu_text": "اور نوجوان خدمت گار (جو ایسے ہوں گے) جیسے چھپائے ہوئے موتی ان کے آس پاس پھریں گے",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4759.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 4760,
      "arabic_text": "وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ",
      "urdu_text": "اور ایک دوسرے کی طرف رخ کرکے آپس میں گفتگو کریں گے",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4760.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 4761,
      "arabic_text": "قَالُوٓا۟ إِنَّا كُنَّا قَبْلُ فِىٓ أَهْلِنَا مُشْفِقِينَ",
      "urdu_text": "کہیں گے کہ اس سے پہلے ہم اپنے گھر میں (خدا سے) ڈرتے رہتے تھے",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4761.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 4762,
      "arabic_text": "فَمَنَّ ٱللَّهُ عَلَيْنَا وَوَقَىٰنَا عَذَابَ ٱلسَّمُومِ",
      "urdu_text": "تو خدا نے ہم پر احسان فرمایا اور ہمیں لو کے عذاب سے بچا لیا",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4762.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 4763,
      "arabic_text": "إِنَّا كُنَّا مِن قَبْلُ نَدْعُوهُ ۖ إِنَّهُۥ هُوَ ٱلْبَرُّ ٱلرَّحِيمُ",
      "urdu_text": "اس سے پہلے ہم اس سے دعائیں کیا کرتے تھے۔ بےشک وہ احسان کرنے والا مہربان ہے",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4763.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 4764,
      "arabic_text": "فَذَكِّرْ فَمَآ أَنتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍۢ وَلَا مَجْنُونٍ",
      "urdu_text": "تو (اے پیغمبر) تم نصیحت کرتے رہو تم اپنے پروردگار کے فضل سے نہ تو کاہن ہو اور نہ دیوانے",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4764.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 4765,
      "arabic_text": "أَمْ يَقُولُونَ شَاعِرٌۭ نَّتَرَبَّصُ بِهِۦ رَيْبَ ٱلْمَنُونِ",
      "urdu_text": "کیا کافر کہتے ہیں کہ یہ شاعر ہے (اور) ہم اس کے حق میں زمانے کے حوادث کا انتظار کر رہے ہیں",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4765.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052030.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052030.mp3"
    },
    {
      "ayah_number": 31,
      "global_number": 4766,
      "arabic_text": "قُلْ تَرَبَّصُوا۟ فَإِنِّى مَعَكُم مِّنَ ٱلْمُتَرَبِّصِينَ",
      "urdu_text": "کہہ دو کہ انتظار کئے جاؤ میں بھی تمہارے ساتھ انتظار کرتا ہوں",
      "juz": 27,
      "page": 524,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4766.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052031.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052031.mp3"
    },
    {
      "ayah_number": 32,
      "global_number": 4767,
      "arabic_text": "أَمْ تَأْمُرُهُمْ أَحْلَٰمُهُم بِهَٰذَآ ۚ أَمْ هُمْ قَوْمٌۭ طَاغُونَ",
      "urdu_text": "کیا ان کی عقلیں ان کو یہی سکھاتی ہیں۔ بلکہ یہ لوگ ہیں ہی شریر",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4767.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052032.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052032.mp3"
    },
    {
      "ayah_number": 33,
      "global_number": 4768,
      "arabic_text": "أَمْ يَقُولُونَ تَقَوَّلَهُۥ ۚ بَل لَّا يُؤْمِنُونَ",
      "urdu_text": "کیا (کفار) کہتے ہیں کہ ان پیغمبر نے قرآن از خود بنا لیا ہے بات یہ ہے کہ یہ (خدا پر) ایمان نہیں رکھتے",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4768.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052033.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052033.mp3"
    },
    {
      "ayah_number": 34,
      "global_number": 4769,
      "arabic_text": "فَلْيَأْتُوا۟ بِحَدِيثٍۢ مِّثْلِهِۦٓ إِن كَانُوا۟ صَٰدِقِينَ",
      "urdu_text": "اگر یہ سچے ہیں تو ایسا کلام بنا تو لائیں",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4769.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052034.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052034.mp3"
    },
    {
      "ayah_number": 35,
      "global_number": 4770,
      "arabic_text": "أَمْ خُلِقُوا۟ مِنْ غَيْرِ شَىْءٍ أَمْ هُمُ ٱلْخَٰلِقُونَ",
      "urdu_text": "کیا یہ کسی کے پیدا کئے بغیر ہی پیدا ہوگئے ہیں۔ یا یہ خود (اپنے تئیں) پیدا کرنے والے ہیں",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4770.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052035.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052035.mp3"
    },
    {
      "ayah_number": 36,
      "global_number": 4771,
      "arabic_text": "أَمْ خَلَقُوا۟ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ ۚ بَل لَّا يُوقِنُونَ",
      "urdu_text": "یا انہوں نے آسمانوں اور زمین کو پیدا کیا ہے؟ (نہیں) بلکہ یہ یقین ہی نہیں رکھتے",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4771.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052036.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052036.mp3"
    },
    {
      "ayah_number": 37,
      "global_number": 4772,
      "arabic_text": "أَمْ عِندَهُمْ خَزَآئِنُ رَبِّكَ أَمْ هُمُ ٱلْمُصَۣيْطِرُونَ",
      "urdu_text": "کیا ان کے پاس تمہارے پروردگار کے خزانے ہیں۔ یا یہ (کہیں کے) داروغہ ہیں؟",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4772.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052037.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052037.mp3"
    },
    {
      "ayah_number": 38,
      "global_number": 4773,
      "arabic_text": "أَمْ لَهُمْ سُلَّمٌۭ يَسْتَمِعُونَ فِيهِ ۖ فَلْيَأْتِ مُسْتَمِعُهُم بِسُلْطَٰنٍۢ مُّبِينٍ",
      "urdu_text": "یا ان کے پاس کوئی سیڑھی ہے جس پر (چڑھ کر آسمان سے باتیں) سن آتے ہیں۔ تو جو سن آتا ہے وہ صریح سند دکھائے",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4773.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052038.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052038.mp3"
    },
    {
      "ayah_number": 39,
      "global_number": 4774,
      "arabic_text": "أَمْ لَهُ ٱلْبَنَٰتُ وَلَكُمُ ٱلْبَنُونَ",
      "urdu_text": "کیا خدا کی تو بیٹیاں اور تمہارے بیٹے",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4774.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052039.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052039.mp3"
    },
    {
      "ayah_number": 40,
      "global_number": 4775,
      "arabic_text": "أَمْ تَسْـَٔلُهُمْ أَجْرًۭا فَهُم مِّن مَّغْرَمٍۢ مُّثْقَلُونَ",
      "urdu_text": "(اے پیغمبر) کیا تم ان سے صلہ مانگتے ہو کہ ان پر تاوان کا بوجھ پڑ رہا ہے",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4775.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052040.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052040.mp3"
    },
    {
      "ayah_number": 41,
      "global_number": 4776,
      "arabic_text": "أَمْ عِندَهُمُ ٱلْغَيْبُ فَهُمْ يَكْتُبُونَ",
      "urdu_text": "یا ان کے پاس غیب (کا علم) ہے کہ وہ اسے لکھ لیتے ہیں",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4776.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052041.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052041.mp3"
    },
    {
      "ayah_number": 42,
      "global_number": 4777,
      "arabic_text": "أَمْ يُرِيدُونَ كَيْدًۭا ۖ فَٱلَّذِينَ كَفَرُوا۟ هُمُ ٱلْمَكِيدُونَ",
      "urdu_text": "کیا یہ کوئی داؤں کرنا چاہتے ہیں تو کافر تو خود داؤں میں آنے والے ہیں",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4777.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052042.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052042.mp3"
    },
    {
      "ayah_number": 43,
      "global_number": 4778,
      "arabic_text": "أَمْ لَهُمْ إِلَٰهٌ غَيْرُ ٱللَّهِ ۚ سُبْحَٰنَ ٱللَّهِ عَمَّا يُشْرِكُونَ",
      "urdu_text": "کیا خدا کے سوا ان کا کوئی اور معبود ہے؟ خدا ان کے شریک بنانے سے پاک ہے",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4778.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052043.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052043.mp3"
    },
    {
      "ayah_number": 44,
      "global_number": 4779,
      "arabic_text": "وَإِن يَرَوْا۟ كِسْفًۭا مِّنَ ٱلسَّمَآءِ سَاقِطًۭا يَقُولُوا۟ سَحَابٌۭ مَّرْكُومٌۭ",
      "urdu_text": "اور اگر یہ آسمان سے (عذاب) کا کوئی ٹکڑا گرتا ہوا دیکھیں تو کہیں کہ یہ گاڑھا بادل ہے",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4779.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052044.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052044.mp3"
    },
    {
      "ayah_number": 45,
      "global_number": 4780,
      "arabic_text": "فَذَرْهُمْ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى فِيهِ يُصْعَقُونَ",
      "urdu_text": "پس ان کو چھوڑ دو یہاں تک کہ وہ روز جس میں وہ بےہوش کردیئے جائیں گے، سامنے آجائے",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4780.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052045.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052045.mp3"
    },
    {
      "ayah_number": 46,
      "global_number": 4781,
      "arabic_text": "يَوْمَ لَا يُغْنِى عَنْهُمْ كَيْدُهُمْ شَيْـًۭٔا وَلَا هُمْ يُنصَرُونَ",
      "urdu_text": "جس دن ان کا کوئی داؤں کچھ بھی کام نہ آئے اور نہ ان کو (کہیں سے) مدد ہی ملے",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4781.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052046.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052046.mp3"
    },
    {
      "ayah_number": 47,
      "global_number": 4782,
      "arabic_text": "وَإِنَّ لِلَّذِينَ ظَلَمُوا۟ عَذَابًۭا دُونَ ذَٰلِكَ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ",
      "urdu_text": "اور ظالموں کے لئے اس کے سوا اور عذاب بھی ہے لیکن ان میں کے اکثر نہیں جانتے",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4782.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052047.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052047.mp3"
    },
    {
      "ayah_number": 48,
      "global_number": 4783,
      "arabic_text": "وَٱصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا ۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُومُ",
      "urdu_text": "اور تم اپنے پروردگار کے حکم کے انتظار میں صبر کئے رہو۔ تم تو ہماری آنکھوں کے سامنے ہو اور جب اُٹھا کرو تو اپنے پروردگار کی تعریف کے ساتھ تسبیح کیا کرو",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4783.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052048.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052048.mp3"
    },
    {
      "ayah_number": 49,
      "global_number": 4784,
      "arabic_text": "وَمِنَ ٱلَّيْلِ فَسَبِّحْهُ وَإِدْبَٰرَ ٱلنُّجُومِ",
      "urdu_text": "اور رات کے بعض اوقات میں بھی اور ستاروں کے غروب ہونے کے بعد بھی اس کی تنزیہ کیا کرو",
      "juz": 27,
      "page": 525,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4784.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/052049.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/052049.mp3"
    }
  ]
}