{
  "surah_number": 89,
  "name_arabic": "سُورَةُ الفَجۡرِ",
  "name_english": "Al-Fajr",
  "name_urdu": "The Dawn",
  "revelation_type": "Meccan",
  "total_ayahs": 30,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5994,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْفَجْرِ",
      "urdu_text": "فجر کی قسم",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5994.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5995,
      "arabic_text": "وَلَيَالٍ عَشْرٍۢ",
      "urdu_text": "اور دس راتوں کی",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5995.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5996,
      "arabic_text": "وَٱلشَّفْعِ وَٱلْوَتْرِ",
      "urdu_text": "اور جفت اور طاق کی",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5996.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5997,
      "arabic_text": "وَٱلَّيْلِ إِذَا يَسْرِ",
      "urdu_text": "اور رات کی جب جانے لگے",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5997.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5998,
      "arabic_text": "هَلْ فِى ذَٰلِكَ قَسَمٌۭ لِّذِى حِجْرٍ",
      "urdu_text": "اور بے شک یہ چیزیں عقلمندوں کے نزدیک قسم کھانے کے لائق ہیں کہ (کافروں کو ضرور عذاب ہو گا)",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5998.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5999,
      "arabic_text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ",
      "urdu_text": "کیا تم نے نہیں دیکھا کہ تمہارے پروردگار نے عاد کے ساتھ کیا کیا",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5999.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 6000,
      "arabic_text": "إِرَمَ ذَاتِ ٱلْعِمَادِ",
      "urdu_text": "(جو) ارم (کہلاتے تھے اتنے) دراز قد",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6000.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 6001,
      "arabic_text": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ",
      "urdu_text": "کہ تمام ملک میں ایسے پیدا نہیں ہوئے تھے",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6001.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 6002,
      "arabic_text": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ",
      "urdu_text": "اور ثمود کے ساتھ (کیا کیا) جو وادئِ (قریٰ) میں پتھر تراشتے تھے (اور گھر بناتے) تھے",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6002.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 6003,
      "arabic_text": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ",
      "urdu_text": "اور فرعون کے ساتھ (کیا کیا) جو خیمے اور میخیں رکھتا تھا",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6003.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 6004,
      "arabic_text": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ",
      "urdu_text": "یہ لوگ ملکوں میں سرکش ہو رہے تھے",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6004.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 6005,
      "arabic_text": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ",
      "urdu_text": "اور ان میں بہت سی خرابیاں کرتے تھے",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6005.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 6006,
      "arabic_text": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ",
      "urdu_text": "تو تمہارے پروردگار نے ان پر عذاب کا کوڑا نازل کیا",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6006.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 6007,
      "arabic_text": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ",
      "urdu_text": "بے شک تمہارا پروردگار تاک میں ہے",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6007.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 6008,
      "arabic_text": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ",
      "urdu_text": "مگر انسان (عجیب مخلوق ہے کہ) جب اس کا پروردگار اس کو آزماتا ہے تو اسے عزت دیتا اور نعمت بخشتا ہے۔ تو کہتا ہے کہ (آہا) میرے پروردگار نے مجھے عزت بخشی",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6008.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 6009,
      "arabic_text": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ",
      "urdu_text": "اور جب (دوسری طرح) آزماتا ہے کہ اس پر روزی تنگ کر دیتا ہے تو کہتا ہے کہ (ہائے) میرے پروردگار نے مجھے ذلیل کیا",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6009.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 6010,
      "arabic_text": "كَلَّا ۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ",
      "urdu_text": "نہیں بلکہ تم لوگ یتیم کی خاطر نہیں کرتے",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6010.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 6011,
      "arabic_text": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "urdu_text": "اور نہ مسکین کو کھانا کھلانے کی ترغیب دیتے ہو",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6011.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 6012,
      "arabic_text": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًۭا لَّمًّۭا",
      "urdu_text": "اور میراث کے مال سمیٹ کر کھا جاتے ہو",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6012.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 6013,
      "arabic_text": "وَتُحِبُّونَ ٱلْمَالَ حُبًّۭا جَمًّۭا",
      "urdu_text": "اور مال کو بہت ہی عزیز رکھتے ہو",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6013.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 6014,
      "arabic_text": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّۭا دَكًّۭا",
      "urdu_text": "تو جب زمین کی بلندی کوٹ کوٹ کو پست کر دی جائے گی",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6014.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 6015,
      "arabic_text": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّۭا صَفًّۭا",
      "urdu_text": "اور تمہارا پروردگار (جلوہ فرما ہو گا) اور فرشتے قطار باندھ باندھ کر آ موجود ہوں گے",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6015.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 6016,
      "arabic_text": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَ ۚ يَوْمَئِذٍۢ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ",
      "urdu_text": "اور دوزخ اس دن حاضر کی جائے گی تو انسان اس دن متنبہ ہو گا مگر تنبہ (سے) اسے (فائدہ) کہاں (مل سکے گا)",
      "juz": 30,
      "page": 593,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6016.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 6017,
      "arabic_text": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
      "urdu_text": "کہے گا کاش میں نے اپنی زندگی (جاودانی کے لیے) کچھ آگے بھیجا ہوتا",
      "juz": 30,
      "page": 594,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6017.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 6018,
      "arabic_text": "فَيَوْمَئِذٍۢ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌۭ",
      "urdu_text": "تو اس دن نہ کوئی خدا کے عذاب کی طرح کا (کسی کو) عذاب دے گا",
      "juz": 30,
      "page": 594,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6018.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 6019,
      "arabic_text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌۭ",
      "urdu_text": "اور نہ کوئی ویسا جکڑنا جکڑے گا",
      "juz": 30,
      "page": 594,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6019.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 6020,
      "arabic_text": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",
      "urdu_text": "اے اطمینان پانے والی روح!",
      "juz": 30,
      "page": 594,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6020.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/089027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/089027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 6021,
      "arabic_text": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةًۭ مَّرْضِيَّةًۭ",
      "urdu_text": "اپنے پروردگار کی طرف لوٹ چل۔ تو اس سے راضی وہ تجھ سے راضی",
      "juz": 30,
      "page": 594,
