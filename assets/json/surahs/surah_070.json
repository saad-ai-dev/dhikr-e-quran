{
  "surah_number": 70,
  "name_arabic": "سُورَةُ المَعَارِجِ",
  "name_english": "Al-Ma'aarij",
  "name_urdu": "The Ascending Stairways",
  "revelation_type": "Meccan",
  "total_ayahs": 44,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5376,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ سَأَلَ سَآئِلٌۢ بِعَذَابٍۢ وَاقِعٍۢ",
      "urdu_text": "ایک طلب کرنے والے نے عذاب طلب کیا جو نازل ہو کر رہے گا",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5376.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5377,
      "arabic_text": "لِّلْكَٰفِرِينَ لَيْسَ لَهُۥ دَافِعٌۭ",
      "urdu_text": "(یعنی) کافروں پر (اور) کوئی اس کو ٹال نہ سکے گا",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5377.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5378,
      "arabic_text": "مِّنَ ٱللَّهِ ذِى ٱلْمَعَارِجِ",
      "urdu_text": "(اور وہ) خدائے صاحب درجات کی طرف سے (نازل ہوگا)",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5378.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5379,
      "arabic_text": "تَعْرُجُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيْهِ فِى يَوْمٍۢ كَانَ مِقْدَارُهُۥ خَمْسِينَ أَلْفَ سَنَةٍۢ",
      "urdu_text": "جس کی طرف روح (الامین) اور فرشتے پڑھتے ہیں (اور) اس روز (نازل ہوگا) جس کا اندازہ پچاس ہزار برس کا ہوگا",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5379.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5380,
      "arabic_text": "فَٱصْبِرْ صَبْرًۭا جَمِيلًا",
      "urdu_text": "(تو تم کافروں کی باتوں کو) قوت کے ساتھ برداشت کرتے رہو",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5380.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5381,
      "arabic_text": "إِنَّهُمْ يَرَوْنَهُۥ بَعِيدًۭا",
      "urdu_text": "وہ ان لوگوں کی نگاہ میں دور ہے",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5381.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5382,
      "arabic_text": "وَنَرَىٰهُ قَرِيبًۭا",
      "urdu_text": "اور ہماری نظر میں نزدیک",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5382.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5383,
      "arabic_text": "يَوْمَ تَكُونُ ٱلسَّمَآءُ كَٱلْمُهْلِ",
      "urdu_text": "جس دن آسمان ایسا ہو جائے گا جیسے پگھلا ہوا تانبا",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5383.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5384,
      "arabic_text": "وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ",
      "urdu_text": "اور پہاڑ (ایسے) جیسے (دھنکی ہوئی) رنگین اون",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5384.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5385,
      "arabic_text": "وَلَا يَسْـَٔلُ حَمِيمٌ حَمِيمًۭا",
      "urdu_text": "اور کوئی دوست کسی دوست کا پرسان نہ ہوگا",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5385.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5386,
      "arabic_text": "يُبَصَّرُونَهُمْ ۚ يَوَدُّ ٱلْمُجْرِمُ لَوْ يَفْتَدِى مِنْ عَذَابِ يَوْمِئِذٍۭ بِبَنِيهِ",
      "urdu_text": "ایک دوسرے کو سامنے دیکھ رہے ہوں گے (اس روز) گنہگار خواہش کرے گا کہ کسی طرح اس دن کے عذاب کے بدلے میں (سب کچھ) دے دے یعنی اپنے بیٹے",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5386.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5387,
      "arabic_text": "وَصَٰحِبَتِهِۦ وَأَخِيهِ",
      "urdu_text": "اور اپنی بیوی اور اپنے بھائی",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5387.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5388,
      "arabic_text": "وَفَصِيلَتِهِ ٱلَّتِى تُـْٔوِيهِ",
      "urdu_text": "اور اپنا خاندان جس میں وہ رہتا تھا",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5388.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5389,
      "arabic_text": "وَمَن فِى ٱلْأَرْضِ جَمِيعًۭا ثُمَّ يُنجِيهِ",
      "urdu_text": "اور جتنے آدمی زمین میں ہیں (غرض) سب (کچھ دے دے) اور اپنے تئیں عذاب سے چھڑا لے",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5389.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5390,
      "arabic_text": "كَلَّآ ۖ إِنَّهَا لَظَىٰ",
      "urdu_text": "(لیکن) ایسا ہرگز نہیں ہوگا وہ بھڑکتی ہوئی آگ ہے",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5390.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5391,
      "arabic_text": "نَزَّاعَةًۭ لِّلشَّوَىٰ",
      "urdu_text": "کھال ادھیڑ ڈالنے والی",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5391.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5392,
      "arabic_text": "تَدْعُوا۟ مَنْ أَدْبَرَ وَتَوَلَّىٰ",
      "urdu_text": "ان لوگوں کو اپنی طرف بلائے گی جنہوں نے (دین حق سے) اعراض کیا",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5392.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5393,
      "arabic_text": "وَجَمَعَ فَأَوْعَىٰٓ",
      "urdu_text": "اور (مال) جمع کیا اور بند کر رکھا",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5393.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5394,
      "arabic_text": "۞ إِنَّ ٱلْإِنسَٰنَ خُلِقَ هَلُوعًا",
      "urdu_text": "کچھ شک نہیں کہ انسان کم حوصلہ پیدا ہوا ہے",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5394.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5395,
      "arabic_text": "إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعًۭا",
      "urdu_text": "جب اسے تکلیف پہنچتی ہے تو گھبرا اٹھتا ہے",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5395.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5396,
      "arabic_text": "وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا",
      "urdu_text": "اور جب آسائش حاصل ہوتی ہے تو بخیل بن جاتا ہے",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5396.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5397,
      "arabic_text": "إِلَّا ٱلْمُصَلِّينَ",
      "urdu_text": "مگر نماز گزار",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5397.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5398,
      "arabic_text": "ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ",
      "urdu_text": "جو نماز کا التزام رکھتے (اور بلاناغہ پڑھتے) ہیں",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5398.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5399,
      "arabic_text": "وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّۭ مَّعْلُومٌۭ",
      "urdu_text": "اور جن کے مال میں حصہ مقرر ہے",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5399.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5400,
      "arabic_text": "لِّلسَّآئِلِ وَٱلْمَحْرُومِ",
      "urdu_text": "(یعنی) مانگنے والے کا۔ اور نہ مانگے والے والا کا",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5400.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 5401,
      "arabic_text": "وَٱلَّذِينَ يُصَدِّقُونَ بِيَوْمِ ٱلدِّينِ",
      "urdu_text": "اور جو روز جزا کو سچ سمجھتے ہیں",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5401.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 5402,
      "arabic_text": "وَٱلَّذِينَ هُم مِّنْ عَذَابِ رَبِّهِم مُّشْفِقُونَ",
      "urdu_text": "اور جو اپنے پروردگار کے عذاب سے خوف رکھتے ہیں",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5402.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 5403,
      "arabic_text": "إِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍۢ",
      "urdu_text": "بےشک ان کے پروردگار کا عذاب ہے ہی ایسا کہ اس سے بےخوف نہ ہوا جائے",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5403.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 5404,
      "arabic_text": "وَٱلَّذِينَ هُمْ لِفُرُوجِهِمْ حَٰفِظُونَ",
      "urdu_text": "اور جو اپنی شرمگاہوں کی حفاظت کرتے ہیں",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5404.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 5405,
      "arabic_text": "إِلَّا عَلَىٰٓ أَزْوَٰجِهِمْ أَوْ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَإِنَّهُمْ غَيْرُ مَلُومِينَ",
      "urdu_text": "مگر اپنی بیویوں یا لونڈیوں سے کہ (ان کے پاس جانے پر) انہیں کچھ ملامت نہیں",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5405.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070030.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070030.mp3"
    },
    {
      "ayah_number": 31,
      "global_number": 5406,
      "arabic_text": "فَمَنِ ٱبْتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُو۟لَٰٓئِكَ هُمُ ٱلْعَادُونَ",
      "urdu_text": "اور جو لوگ ان کے سوا اور کے خواستگار ہوں وہ حد سے نکل جانے والے ہیں",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5406.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070031.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070031.mp3"
    },
    {
      "ayah_number": 32,
      "global_number": 5407,
      "arabic_text": "وَٱلَّذِينَ هُمْ لِأَمَٰنَٰتِهِمْ وَعَهْدِهِمْ رَٰعُونَ",
      "urdu_text": "اور جو اپنی امانتوں اور اقراروں کا پاس کرتے ہیں",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5407.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070032.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070032.mp3"
    },
    {
      "ayah_number": 33,
      "global_number": 5408,
      "arabic_text": "وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمْ قَآئِمُونَ",
      "urdu_text": "اور جو اپنی شہادتوں پر قائم رہتے ہیں",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5408.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070033.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070033.mp3"
    },
    {
      "ayah_number": 34,
      "global_number": 5409,
      "arabic_text": "وَٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ",
      "urdu_text": "اور جو اپنی نماز کی خبر رکھتے ہیں",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5409.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070034.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070034.mp3"
    },
    {
      "ayah_number": 35,
      "global_number": 5410,
      "arabic_text": "أُو۟لَٰٓئِكَ فِى جَنَّٰتٍۢ مُّكْرَمُونَ",
      "urdu_text": "یہی لوگ باغہائے بہشت میں عزت واکرام سے ہوں گے",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5410.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070035.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070035.mp3"
    },
    {
      "ayah_number": 36,
      "global_number": 5411,
      "arabic_text": "فَمَالِ ٱلَّذِينَ كَفَرُوا۟ قِبَلَكَ مُهْطِعِينَ",
      "urdu_text": "تو ان کافروں کو کیا ہوا ہے کہ تمہاری طرف دوڑے چلے آتے ہیں",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5411.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070036.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070036.mp3"
    },
    {
      "ayah_number": 37,
      "global_number": 5412,
      "arabic_text": "عَنِ ٱلْيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ",
      "urdu_text": "اور) دائیں بائیں سے گروہ گروہ ہو کر (جمع ہوتے جاتے ہیں)",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5412.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070037.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070037.mp3"
    },
    {
      "ayah_number": 38,
      "global_number": 5413,
      "arabic_text": "أَيَطْمَعُ كُلُّ ٱمْرِئٍۢ مِّنْهُمْ أَن يُدْخَلَ جَنَّةَ نَعِيمٍۢ",
      "urdu_text": "کیا ان میں سے ہر شخص یہ توقع رکھتا ہے کہ نعمت کے باغ میں داخل کیا جائے گا",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5413.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070038.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070038.mp3"
    },
    {
      "ayah_number": 39,
      "global_number": 5414,
      "arabic_text": "كَلَّآ ۖ إِنَّا خَلَقْنَٰهُم مِّمَّا يَعْلَمُونَ",
      "urdu_text": "ہرگز نہیں۔ ہم نے ان کو اس چیز سے پیدا کیا ہے جسے وہ جانتے ہیں",
      "juz": 29,
      "page": 569,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5414.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070039.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070039.mp3"
    },
    {
      "ayah_number": 40,
      "global_number": 5415,
      "arabic_text": "فَلَآ أُقْسِمُ بِرَبِّ ٱلْمَشَٰرِقِ وَٱلْمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ",
      "urdu_text": "ہمیں مشرقوں اور مغربوں کے مالک کی قسم کہ ہم طاقت رکھتے ہیں",
      "juz": 29,
      "page": 570,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5415.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070040.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070040.mp3"
    },
    {
      "ayah_number": 41,
      "global_number": 5416,
      "arabic_text": "عَلَىٰٓ أَن نُّبَدِّلَ خَيْرًۭا مِّنْهُمْ وَمَا نَحْنُ بِمَسْبُوقِينَ",
      "urdu_text": "(یعنی) اس بات پر (قادر ہیں) کہ ان سے بہتر لوگ بدل لائیں اور ہم عاجز نہیں ہیں",
      "juz": 29,
      "page": 570,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5416.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070041.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070041.mp3"
    },
    {
      "ayah_number": 42,
      "global_number": 5417,
      "arabic_text": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ",
      "urdu_text": "تو (اے پیغمبر) ان کو باطل میں پڑے رہنے اور کھیل لینے دو یہاں تک کہ جس دن کا ان سے وعدہ کیا جاتا ہے وہ ان کے سامنے آ موجود ہو",
      "juz": 29,
      "page": 570,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5417.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070042.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070042.mp3"
    },
    {
      "ayah_number": 43,
      "global_number": 5418,
      "arabic_text": "يَوْمَ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ سِرَاعًۭا كَأَنَّهُمْ إِلَىٰ نُصُبٍۢ يُوفِضُونَ",
      "urdu_text": "اس دن یہ قبر سے نکل کر (اس طرح) دوڑیں گے جیسے (شکاری) شکار کے جال کی طرف دوڑتے ہیں",
      "juz": 29,
      "page": 570,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5418.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070043.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070043.mp3"
    },
    {
      "ayah_number": 44,
      "global_number": 5419,
      "arabic_text": "خَٰشِعَةً أَبْصَٰرُهُمْ تَرْهَقُهُمْ ذِلَّةٌۭ ۚ ذَٰلِكَ ٱلْيَوْمُ ٱلَّذِى كَانُوا۟ يُوعَدُونَ",
      "urdu_text": "ان کی آنکھیں جھک رہی ہوں گی اور ذلت ان پر چھا رہی ہوگی۔ یہی وہ دن ہے جس کا ان سے وعدہ کیا جاتا تھا",
      "juz": 29,
      "page": 570,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5419.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/070044.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/070044.mp3"
    }
  ]
