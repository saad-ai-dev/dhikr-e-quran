{
  "surah_number": 100,
  "name_arabic": "سُورَةُ العَادِيَاتِ",
  "name_english": "Al-Aadiyaat",
  "name_urdu": "The Chargers",
  "revelation_type": "Meccan",
  "total_ayahs": 11,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 6147,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْعَٰدِيَٰتِ ضَبْحًۭا",
      "urdu_text": "ان سرپٹ دوڑنے والے گھوڑوں کی قسم جو ہانپ اٹھتےہیں",
      "juz": 30,
      "page": 599,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6147.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/100001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/100001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 6148,
      "arabic_text": "فَٱلْمُورِيَٰتِ قَدْحًۭا",
      "urdu_text": "پھر (پتھروں پر نعل) مار کر آگ نکالتے ہیں",
      "juz": 30,
      "page": 599,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6148.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/100002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/100002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 6149,
      "arabic_text": "فَٱلْمُغِيرَٰتِ صُبْحًۭا",
      "urdu_text": "پھر صبح کو چھاپہ مارتے ہیں",
      "juz": 30,
      "page": 599,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6149.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/100003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/100003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 6150,
      "arabic_text": "فَأَثَرْنَ بِهِۦ نَقْعًۭا",
      "urdu_text": "پھر اس میں گرد اٹھاتے ہیں",
      "juz": 30,
      "page": 599,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6150.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/100004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/100004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 6151,
      "arabic_text": "فَوَسَطْنَ بِهِۦ جَمْعًا",
      "urdu_text": "پھر اس وقت دشمن کی فوج میں جا گھستے ہیں",
      "juz": 30,
      "page": 599,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6151.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/100005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/100005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 6152,
      "arabic_text": "إِنَّ ٱلْإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٌۭ",
      "urdu_text": "کہ انسان اپنے پروردگار کا احسان ناشناس (اور ناشکرا) ہے",
      "juz": 30,
      "page": 599,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6152.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/100006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/100006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 6153,
      "arabic_text": "وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٌۭ",
      "urdu_text": "اور وہ اس سے آگاہ بھی ہے",
      "juz": 30,
      "page": 599,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6153.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/100007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/100007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 6154,
      "arabic_text": "وَإِنَّهُۥ لِحُبِّ ٱلْخَيْرِ لَشَدِيدٌ",
      "urdu_text": "وہ تو مال سے سخت محبت کرنے والا ہے",
      "juz": 30,
      "page": 599,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6154.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/100008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/100008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 6155,
      "arabic_text": "۞ أَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِى ٱلْقُبُورِ",
      "urdu_text": "کیا وہ اس وقت کو نہیں جانتا کہ جو (مردے) قبروں میں ہیں وہ باہر نکال لیے جائیں گے",
      "juz": 30,
      "page": 599,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6155.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/100009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/100009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 6156,
      "arabic_text": "وَحُصِّلَ مَا فِى ٱلصُّدُورِ",
      "urdu_text": "اور جو (بھید) دلوں میں ہیں وہ ظاہر کر دیئے جائیں گے",
      "juz": 30,
      "page": 600,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6156.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/100010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/100010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 6157,
      "arabic_text": "إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٍۢ لَّخَبِيرٌۢ",
      "urdu_text": "بےشک ان کا پروردگار اس روز ان سے خوب واقف ہوگا",
