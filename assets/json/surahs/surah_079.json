{
  "surah_number": 79,
  "name_arabic": "سُورَةُ النَّازِعَاتِ",
  "name_english": "An-Naazi'aat",
  "name_urdu": "Those who drag forth",
  "revelation_type": "Meccan",
  "total_ayahs": 46,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5713,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلنَّٰزِعَٰتِ غَرْقًۭا",
      "urdu_text": "ان (فرشتوں) کی قسم جو ڈوب کر کھینچ لیتے ہیں",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5713.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5714,
      "arabic_text": "وَٱلنَّٰشِطَٰتِ نَشْطًۭا",
      "urdu_text": "اور ان کی جو آسانی سے کھول دیتے ہیں",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5714.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5715,
      "arabic_text": "وَٱلسَّٰبِحَٰتِ سَبْحًۭا",
      "urdu_text": "اور ان کی جو تیرتے پھرتے ہیں",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5715.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5716,
      "arabic_text": "فَٱلسَّٰبِقَٰتِ سَبْقًۭا",
      "urdu_text": "پھر لپک کر آگے بڑھتے ہیں",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5716.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5717,
      "arabic_text": "فَٱلْمُدَبِّرَٰتِ أَمْرًۭا",
      "urdu_text": "پھر (دنیا کے) کاموں کا انتظام کرتے ہیں",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5717.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5718,
      "arabic_text": "يَوْمَ تَرْجُفُ ٱلرَّاجِفَةُ",
      "urdu_text": "(کہ وہ دن آ کر رہے گا) جس دن زمین کو بھونچال آئے گا",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5718.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5719,
      "arabic_text": "تَتْبَعُهَا ٱلرَّادِفَةُ",
      "urdu_text": "پھر اس کے پیچھے اور (بھونچال) آئے گا",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5719.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5720,
      "arabic_text": "قُلُوبٌۭ يَوْمَئِذٍۢ وَاجِفَةٌ",
      "urdu_text": "اس دن (لوگوں) کے دل خائف ہو رہے ہوں گے",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5720.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5721,
      "arabic_text": "أَبْصَٰرُهَا خَٰشِعَةٌۭ",
      "urdu_text": "اور آنکھیں جھکی ہوئی",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5721.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5722,
      "arabic_text": "يَقُولُونَ أَءِنَّا لَمَرْدُودُونَ فِى ٱلْحَافِرَةِ",
      "urdu_text": "(کافر) کہتے ہیں کیا ہم الٹے پاؤں پھر لوٹ جائیں گے",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5722.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5723,
      "arabic_text": "أَءِذَا كُنَّا عِظَٰمًۭا نَّخِرَةًۭ",
      "urdu_text": "بھلا جب ہم کھوکھلی ہڈیاں ہو جائیں گے (تو پھر زندہ کئے جائیں گے)",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5723.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5724,
      "arabic_text": "قَالُوا۟ تِلْكَ إِذًۭا كَرَّةٌ خَاسِرَةٌۭ",
      "urdu_text": "کہتے ہیں کہ یہ لوٹنا تو (موجب) زیاں ہے",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5724.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5725,
      "arabic_text": "فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ",
      "urdu_text": "وہ تو صرف ایک ڈانٹ ہوگی",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5725.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5726,
      "arabic_text": "فَإِذَا هُم بِٱلسَّاهِرَةِ",
      "urdu_text": "اس وقت وہ (سب) میدان (حشر) میں آ جمع ہوں گے",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5726.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5727,
      "arabic_text": "هَلْ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ",
      "urdu_text": "بھلا تم کو موسیٰ کی حکایت پہنچی ہے",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5727.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5728,
      "arabic_text": "إِذْ نَادَىٰهُ رَبُّهُۥ بِٱلْوَادِ ٱلْمُقَدَّسِ طُوًى",
      "urdu_text": "جب اُن کے پروردگار نے ان کو پاک میدان (یعنی) طویٰ میں پکارا",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5728.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5729,
      "arabic_text": "ٱذْهَبْ إِلَىٰ فِرْعَوْنَ إِنَّهُۥ طَغَىٰ",
      "urdu_text": "(اور حکم دیا) کہ فرعون کے پاس جاؤ وہ سرکش ہو رہا ہے",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5729.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5730,
      "arabic_text": "فَقُلْ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ",
      "urdu_text": "اور (اس سے) کہو کہ کیا تو چاہتا ہے کہ پاک ہو جائے؟",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5730.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5731,
      "arabic_text": "وَأَهْدِيَكَ إِلَىٰ رَبِّكَ فَتَخْشَىٰ",
      "urdu_text": "اور میں تجھے تیرے پروردگار کا رستہ بتاؤں تاکہ تجھ کو خوف (پیدا) ہو",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5731.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5732,
      "arabic_text": "فَأَرَىٰهُ ٱلْءَايَةَ ٱلْكُبْرَىٰ",
      "urdu_text": "غرض انہوں نے اس کو بڑی نشانی دکھائی",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5732.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5733,
      "arabic_text": "فَكَذَّبَ وَعَصَىٰ",
      "urdu_text": "مگر اس نے جھٹلایا اور نہ مانا",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5733.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5734,
      "arabic_text": "ثُمَّ أَدْبَرَ يَسْعَىٰ",
      "urdu_text": "پھر لوٹ گیا اور تدبیریں کرنے لگا",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5734.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5735,
      "arabic_text": "فَحَشَرَ فَنَادَىٰ",
      "urdu_text": "اور (لوگوں کو) اکٹھا کیا اور پکارا",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5735.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5736,
      "arabic_text": "فَقَالَ أَنَا۠ رَبُّكُمُ ٱلْأَعْلَىٰ",
      "urdu_text": "کہنے لگا کہ تمہارا سب سے بڑا مالک میں ہوں",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5736.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5737,
      "arabic_text": "فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلْءَاخِرَةِ وَٱلْأُولَىٰٓ",
      "urdu_text": "تو خدا نے اس کو دنیا اور آخرت (دونوں) کے عذاب میں پکڑ لیا",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5737.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 5738,
      "arabic_text": "إِنَّ فِى ذَٰلِكَ لَعِبْرَةًۭ لِّمَن يَخْشَىٰٓ",
      "urdu_text": "جو شخص (خدا سے) ڈر رکھتا ہے اس کے لیے اس (قصے) میں عبرت ہے",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5738.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 5739,
      "arabic_text": "ءَأَنتُمْ أَشَدُّ خَلْقًا أَمِ ٱلسَّمَآءُ ۚ بَنَىٰهَا",
      "urdu_text": "بھلا تمہارا بنانا آسان ہے یا آسمان کا؟ اسی نے اس کو بنایا",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5739.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 5740,
      "arabic_text": "رَفَعَ سَمْكَهَا فَسَوَّىٰهَا",
      "urdu_text": "اس کی چھت کو اونچا کیا اور پھر اسے برابر کر دیا",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5740.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 5741,
      "arabic_text": "وَأَغْطَشَ لَيْلَهَا وَأَخْرَجَ ضُحَىٰهَا",
      "urdu_text": "اور اسی نے رات کو تاریک بنایا اور (دن کو) دھوپ نکالی",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5741.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/079029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/079029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 5742,
      "arabic_text": "وَٱلْأَرْضَ بَعْدَ ذَٰلِكَ دَحَىٰهَآ",
      "urdu_text": "اور اس کے بعد زمین کو پھیلا دیا",
      "juz": 30,
      "page": 584,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5742.mp3",
