{
  "surah_number": 104,
  "name_arabic": "سُورَةُ الهُمَزَةِ",
  "name_english": "Al-Humaza",
  "name_urdu": "The Traducer",
  "revelation_type": "Meccan",
  "total_ayahs": 9,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 6180,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ",
      "urdu_text": "ہر طعن آمیز اشارتیں کرنے والے چغل خور کی خرابی ہے",
      "juz": 30,
      "page": 601,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6180.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/104001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/104001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 6181,
      "arabic_text": "ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ",
      "urdu_text": "جو مال جمع کرتا اور اس کو گن گن کر رکھتا ہے",
      "juz": 30,
      "page": 601,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6181.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/104002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/104002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 6182,
      "arabic_text": "يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",
      "urdu_text": "(اور) خیال کرتا ہے کہ اس کا مال اس کی ہمیشہ کی زندگی کا موجب ہو گا",
      "juz": 30,
      "page": 601,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6182.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/104003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/104003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 6183,
      "arabic_text": "كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",
      "urdu_text": "ہر گز نہیں وہ ضرور حطمہ میں ڈالا جائے گا",
      "juz": 30,
      "page": 601,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6183.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/104004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/104004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 6184,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",
      "urdu_text": "اور تم کیا سمجھے حطمہ کیا ہے؟",
      "juz": 30,
      "page": 601,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6184.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/104005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/104005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 6185,
      "arabic_text": "نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",
      "urdu_text": "وہ خدا کی بھڑکائی ہوئی آگ ہے",
      "juz": 30,
      "page": 601,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6185.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/104006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/104006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 6186,
      "arabic_text": "ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",
      "urdu_text": "جو دلوں پر جا لپٹے گی",
      "juz": 30,
      "page": 601,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6186.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/104007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/104007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 6187,
      "arabic_text": "إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ",
      "urdu_text": "(اور) وہ اس میں بند کر دیئے جائیں گے",
      "juz": 30,
      "page": 601,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6187.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/104008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/104008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 6188,
      "arabic_text": "فِى عَمَدٍۢ مُّمَدَّدَةٍۭ",
      "urdu_text": "(یعنی آگ کے) لمبے لمبے ستونوں میں",
      "juz": 30,
