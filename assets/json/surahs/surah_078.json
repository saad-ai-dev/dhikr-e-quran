    },
    {
      "ayah_number": 38,
      "global_number": 5710,
      "arabic_text": "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّۭا ۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًۭا",
      "urdu_text": "جس دن روح (الامین) اور فرشتے صف باندھ کر کھڑے ہوں گے تو کوئی بول نہ سکے گا مگر جس کو (خدائے رحمٰن) اجازت بخشے اور اس نے بات بھی درست کہی ہو",
      "juz": 30,
      "page": 583,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5710.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078038.mp3",
