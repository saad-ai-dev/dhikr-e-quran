{
  "surah_number": 78,
  "name_arabic": "سُورَةُ النَّبَإِ",
  "name_english": "An-Naba",
  "name_urdu": "The Announcement",
  "revelation_type": "Meccan",
  "total_ayahs": 40,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5673,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَمَّ يَتَسَآءَلُونَ",
      "urdu_text": "(یہ) لوگ کس چیز کی نسبت پوچھتے ہیں؟",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5673.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5674,
      "arabic_text": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ",
      "urdu_text": "(کیا) بڑی خبر کی نسبت؟",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5674.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5675,
      "arabic_text": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ",
      "urdu_text": "جس میں یہ اختلاف کر رہے ہیں",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5675.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5676,
      "arabic_text": "كَلَّا سَيَعْلَمُونَ",
      "urdu_text": "دیکھو یہ عنقریب جان لیں گے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5676.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5677,
      "arabic_text": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
      "urdu_text": "پھر دیکھو یہ عنقریب جان لیں گے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5677.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5678,
      "arabic_text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَٰدًۭا",
      "urdu_text": "کیا ہم نے زمین کو بچھونا نہیں بنایا",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5678.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5679,
      "arabic_text": "وَٱلْجِبَالَ أَوْتَادًۭا",
      "urdu_text": "اور پہاڑوں کو (ا س کی) میخیں (نہیں ٹھہرایا؟)",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5679.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5680,
      "arabic_text": "وَخَلَقْنَٰكُمْ أَزْوَٰجًۭا",
      "urdu_text": "(بے شک بنایا) اور تم کو جوڑا جوڑابھی پیدا کیا",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5680.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5681,
      "arabic_text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًۭا",
      "urdu_text": "اور نیند کو تمہارے لیے (موجب) آرام بنایا",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5681.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5682,
      "arabic_text": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًۭا",
      "urdu_text": "اور رات کو پردہ مقرر کیا",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5682.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5683,
      "arabic_text": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًۭا",
      "urdu_text": "اور دن کو معاش (کا وقت) قرار دیا",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5683.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5684,
      "arabic_text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًۭا شِدَادًۭا",
      "urdu_text": "اور تمہارے اوپر سات مضبوط (آسمان) بنائے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5684.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5685,
      "arabic_text": "وَجَعَلْنَا سِرَاجًۭا وَهَّاجًۭا",
      "urdu_text": "اور (آفتاب کا) روشن چراغ بنایا",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5685.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5686,
      "arabic_text": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءًۭ ثَجَّاجًۭا",
      "urdu_text": "اور نچڑتے بادلوں سے موسلا دھار مینہ برسایا",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5686.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5687,
      "arabic_text": "لِّنُخْرِجَ بِهِۦ حَبًّۭا وَنَبَاتًۭا",
      "urdu_text": "تاکہ اس سے اناج اور سبزہ پیدا کریں",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5687.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5688,
      "arabic_text": "وَجَنَّٰتٍ أَلْفَافًا",
      "urdu_text": "اور گھنے گھنے باغ",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5688.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5689,
      "arabic_text": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَٰتًۭا",
      "urdu_text": "بےشک فیصلہ کا دن مقرر ہے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5689.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5690,
      "arabic_text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًۭا",
      "urdu_text": "جس دن صور پھونکا جائے گا تو تم لوگ غٹ کے غٹ آ موجود ہو گے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5690.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5691,
      "arabic_text": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًۭا",
      "urdu_text": "اور آسمان کھولا جائے گا تو (اس میں) دروازے ہو جائیں گے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5691.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5692,
      "arabic_text": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
      "urdu_text": "اور پہاڑ چلائے جائیں گے تو وہ ریت ہو کر رہ جائیں گے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5692.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5693,
      "arabic_text": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًۭا",
      "urdu_text": "بےشک دوزخ گھات میں ہے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5693.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5694,
      "arabic_text": "لِّلطَّٰغِينَ مَـَٔابًۭا",
      "urdu_text": "(یعنی) سرکشوں کا وہی ٹھکانہ ہے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5694.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5695,
      "arabic_text": "لَّٰبِثِينَ فِيهَآ أَحْقَابًۭا",
      "urdu_text": "اس میں وہ مدتوں پڑے رہیں گے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5695.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5696,
      "arabic_text": "لَّا يَذُوقُونَ فِيهَا بَرْدًۭا وَلَا شَرَابًا",
      "urdu_text": "وہاں نہ ٹھنڈک کا مزہ چکھیں گے۔ نہ (کچھ) پینا (نصیب ہو گا)",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5696.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5697,
      "arabic_text": "إِلَّا حَمِيمًۭا وَغَسَّاقًۭا",
      "urdu_text": "مگر گرم پانی اور بہتی پیپ",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5697.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 5698,
      "arabic_text": "جَزَآءًۭ وِفَاقًا",
      "urdu_text": "(یہ) بدلہ ہے پورا پورا",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5698.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 5699,
      "arabic_text": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًۭا",
      "urdu_text": "یہ لوگ حساب (آخرت) کی امید ہی نہیں رکھتے تھے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5699.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 5700,
      "arabic_text": "وَكَذَّبُوا۟ بِـَٔايَٰتِنَا كِذَّابًۭا",
      "urdu_text": "اور ہماری آیتوں کو جھوٹ سمجھ کر جھٹلاتے رہتے تھے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5700.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 5701,
      "arabic_text": "وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ كِتَٰبًۭا",
      "urdu_text": "اور ہم نے ہر چیز کو لکھ کر ضبط کر رکھا ہے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5701.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 5702,
      "arabic_text": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
      "urdu_text": "سو (اب) مزہ چکھو۔ ہم تم پر عذاب ہی بڑھاتے جائیں گے",
      "juz": 30,
      "page": 582,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5702.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/078030.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/078030.mp3"
    },
    {
      "ayah_number": 31,
      "global_number": 5703,
      "arabic_text": "إِنَّ لِلْمُتَّقِينَ مَفَازًا",
      "urdu_text": "بے شک پرہیز گاروں کے لیے کامیابی ہے",
      "juz": 30,
      "page": 583,
