{
  "surah_number": 55,
  "name_arabic": "سُورَةُ الرَّحۡمَٰن",
  "name_english": "Ar-Rahmaan",
  "name_urdu": "The Beneficent",
  "revelation_type": "Medinan",
  "total_ayahs": 78,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 4902,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلرَّحْمَٰنُ",
      "urdu_text": "(خدا جو) نہایت مہربان",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4902.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 4903,
      "arabic_text": "عَلَّمَ ٱلْقُرْءَانَ",
      "urdu_text": "اسی نے قرآن کی تعلیم فرمائی",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4903.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 4904,
      "arabic_text": "خَلَقَ ٱلْإِنسَٰنَ",
      "urdu_text": "اسی نے انسان کو پیدا کیا",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4904.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 4905,
      "arabic_text": "عَلَّمَهُ ٱلْبَيَانَ",
      "urdu_text": "اسی نے اس کو بولنا سکھایا",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4905.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 4906,
      "arabic_text": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍۢ",
      "urdu_text": "سورج اور چاند ایک حساب مقرر سے چل رہے ہیں",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4906.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 4907,
      "arabic_text": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ",
      "urdu_text": "اور بوٹیاں اور درخت سجدہ کر رہے ہیں",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4907.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 4908,
      "arabic_text": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ",
      "urdu_text": "اور اسی نے آسمان کو بلند کیا اور ترازو قائم کی",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4908.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 4909,
      "arabic_text": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ",
      "urdu_text": "کہ ترازو (سے تولنے) میں حد سے تجاوز نہ کرو",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4909.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 4910,
      "arabic_text": "وَأَقِيمُوا۟ ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ",
      "urdu_text": "اور انصاف کے ساتھ ٹھیک تولو۔ اور تول کم مت کرو",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4910.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 4911,
      "arabic_text": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ",
      "urdu_text": "اور اسی نے خلقت کے لئے زمین بچھائی",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4911.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 4912,
      "arabic_text": "فِيهَا فَٰكِهَةٌۭ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ",
      "urdu_text": "اس میں میوے اور کھجور کے درخت ہیں جن کے خوشوں پر غلاف ہوتے ہیں",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4912.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 4913,
      "arabic_text": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ",
      "urdu_text": "اور اناج جس کے ساتھ بھس ہوتا ہے اور خوشبودار پھول",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4913.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 4914,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "urdu_text": "تو (اے گروہ جن وانس) تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4914.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 4915,
      "arabic_text": "خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍۢ كَٱلْفَخَّارِ",
      "urdu_text": "اسی نے انسان کو ٹھیکرے کی طرح کھنکھناتی مٹی سے بنایا",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4915.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 4916,
      "arabic_text": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍۢ مِّن نَّارٍۢ",
      "urdu_text": "اور جنات کو آگ کے شعلے سے پیدا کیا",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4916.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 4917,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "urdu_text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟",
      "juz": 27,
      "page": 531,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4917.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 4918,
      "arabic_text": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ",
      "urdu_text": "وہی دونوں مشرقوں اور دونوں مغربوں کا مالک (ہے)",
      "juz": 27,
      "page": 532,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4918.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 4919,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "urdu_text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟",
      "juz": 27,
      "page": 532,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4919.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 4920,
      "arabic_text": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ",
      "urdu_text": "اسی نے دو دریا رواں کئے جو آپس میں ملتے ہیں",
      "juz": 27,
      "page": 532,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4920.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 4921,
      "arabic_text": "بَيْنَهُمَا بَرْزَخٌۭ لَّا يَبْغِيَانِ",
      "urdu_text": "دونوں میں ایک آڑ ہے کہ (اس سے) تجاوز نہیں کرسکتے",
      "juz": 27,
      "page": 532,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4921.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 4922,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "urdu_text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟",
      "juz": 27,
      "page": 532,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4922.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 4923,
      "arabic_text": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ",
      "urdu_text": "دونوں دریاؤں سے موتی اور مونگے نکلتے ہیں",
      "juz": 27,
      "page": 532,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4923.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 4924,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "urdu_text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟",
      "juz": 27,
      "page": 532,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4924.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 4925,
      "arabic_text": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ",
      "urdu_text": "اور جہاز بھی اسی کے ہیں جو دریا میں پہاڑوں کی طرح اونچے کھڑے ہوتے ہیں",
      "juz": 27,
      "page": 532,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4925.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 4926,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "urdu_text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟",
      "juz": 27,
      "page": 532,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4926.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 4927,
      "arabic_text": "كُلُّ مَنْ عَلَيْهَا فَانٍۢ",
      "urdu_text": "جو (مخلوق) زمین پر ہے سب کو فنا ہونا ہے",
      "juz": 27,
      "page": 532,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4927.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 4928,
      "arabic_text": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ",
      "urdu_text": "اور تمہارے پروردگار ہی کی ذات (بابرکات) جو صاحب جلال وعظمت ہے باقی رہے گی",
      "juz": 27,
      "page": 532,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4928.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 4929,
      "arabic_text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ",
      "urdu_text": "تو تم اپنے پروردگار کی کون کون سی نعمت کو جھٹلاؤ گے؟",
      "juz": 27,
      "page": 532,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4929.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/055028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/055028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 4930,
      "arabic_text": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍۢ",
      "urdu_text": "آسمان اور زمین میں جتنے لوگ ہیں سب اسی سے مانگتے ہیں۔ وہ ہر روز کام میں مصروف رہتا ہے",
      "juz": 27,
