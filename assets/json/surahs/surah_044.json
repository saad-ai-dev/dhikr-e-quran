{
  "surah_number": 44,
  "name_arabic": "سُورَةُ الدُّخَانِ",
  "name_english": "Ad-Dukhaan",
  "name_urdu": "The Smoke",
  "revelation_type": "Meccan",
  "total_ayahs": 59,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 4415,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ حمٓ",
      "urdu_text": "حٰم",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4415.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 4416,
      "arabic_text": "وَٱلْكِتَٰبِ ٱلْمُبِينِ",
      "urdu_text": "اس کتاب روشن کی قسم",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4416.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 4417,
      "arabic_text": "إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةٍۢ مُّبَٰرَكَةٍ ۚ إِنَّا كُنَّا مُنذِرِينَ",
      "urdu_text": "کہ ہم نے اس کو مبارک رات میں نازل فرمایا ہم تو رستہ دکھانے والے ہیں",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4417.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 4418,
      "arabic_text": "فِيهَا يُفْرَقُ كُلُّ أَمْرٍ حَكِيمٍ",
      "urdu_text": "اسی رات میں تمام حکمت کے کام فیصل کئے جاتے ہیں",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4418.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 4419,
      "arabic_text": "أَمْرًۭا مِّنْ عِندِنَآ ۚ إِنَّا كُنَّا مُرْسِلِينَ",
      "urdu_text": "(یعنی) ہمارے ہاں سے حکم ہو کر۔ بےشک ہم ہی (پیغمبر کو) بھیجتے ہیں",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4419.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 4420,
      "arabic_text": "رَحْمَةًۭ مِّن رَّبِّكَ ۚ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ",
      "urdu_text": "(یہ) تمہارے پروردگار کی رحمت ہے۔ وہ تو سننے والا جاننے والا ہے",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4420.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 4421,
      "arabic_text": "رَبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَآ ۖ إِن كُنتُم مُّوقِنِينَ",
      "urdu_text": "آسمانوں اور زمین کا اور جو کچھ ان دونوں میں ہے سب کا مالک۔ بشرطیکہ تم لوگ یقین کرنے والے ہو",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4421.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 4422,
      "arabic_text": "لَآ إِلَٰهَ إِلَّا هُوَ يُحْىِۦ وَيُمِيتُ ۖ رَبُّكُمْ وَرَبُّ ءَابَآئِكُمُ ٱلْأَوَّلِينَ",
      "urdu_text": "اس کے سوا کوئی معبود نہیں۔ (وہی) جِلاتا ہے اور (وہی) مارتا ہے۔ وہی تمہارا اور تمہارے باپ دادا کا پروردگار ہے",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4422.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 4423,
      "arabic_text": "بَلْ هُمْ فِى شَكٍّۢ يَلْعَبُونَ",
      "urdu_text": "لیکن یہ لوگ شک میں کھیل رہے ہیں",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4423.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 4424,
      "arabic_text": "فَٱرْتَقِبْ يَوْمَ تَأْتِى ٱلسَّمَآءُ بِدُخَانٍۢ مُّبِينٍۢ",
      "urdu_text": "تو اس دن کا انتظار کرو کہ آسمان سے صریح دھواں نکلے گا",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4424.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 4425,
      "arabic_text": "يَغْشَى ٱلنَّاسَ ۖ هَٰذَا عَذَابٌ أَلِيمٌۭ",
      "urdu_text": "جو لوگوں پر چھا جائے گا۔ یہ درد دینے والا عذاب ہے",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4425.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 4426,
      "arabic_text": "رَّبَّنَا ٱكْشِفْ عَنَّا ٱلْعَذَابَ إِنَّا مُؤْمِنُونَ",
      "urdu_text": "اے پروردگار ہم سے اس عذاب کو دور کر ہم ایمان لاتے ہیں",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4426.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 4427,
      "arabic_text": "أَنَّىٰ لَهُمُ ٱلذِّكْرَىٰ وَقَدْ جَآءَهُمْ رَسُولٌۭ مُّبِينٌۭ",
      "urdu_text": "(اس وقت) ان کو نصیحت کہاں مفید ہوگی جب کہ ان کے پاس پیغمبر آچکے جو کھول کھول کر بیان کر دیتے ہیں",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4427.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 4428,
      "arabic_text": "ثُمَّ تَوَلَّوْا۟ عَنْهُ وَقَالُوا۟ مُعَلَّمٌۭ مَّجْنُونٌ",
      "urdu_text": "پھر انہوں نے ان سے منہ پھیر لیا اور کہنے لگے (یہ تو) پڑھایا ہوا (اور) دیوانہ ہے",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4428.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 4429,
      "arabic_text": "إِنَّا كَاشِفُوا۟ ٱلْعَذَابِ قَلِيلًا ۚ إِنَّكُمْ عَآئِدُونَ",
      "urdu_text": "ہم تو تھوڑے دنوں عذاب ٹال دیتے ہیں (مگر) تم پھر کفر کرنے لگتے ہو",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4429.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 4430,
      "arabic_text": "يَوْمَ نَبْطِشُ ٱلْبَطْشَةَ ٱلْكُبْرَىٰٓ إِنَّا مُنتَقِمُونَ",
      "urdu_text": "جس دن ہم بڑی سخت پکڑ پکڑیں گے تو بےشک انتقام لے کر چھوڑیں گے",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4430.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 4431,
      "arabic_text": "۞ وَلَقَدْ فَتَنَّا قَبْلَهُمْ قَوْمَ فِرْعَوْنَ وَجَآءَهُمْ رَسُولٌۭ كَرِيمٌ",
      "urdu_text": "اور ان سے پہلے ہم نے قوم فرعون کی آزمائش کی اور ان کے پاس ایک عالی قدر پیغمبر آئے",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4431.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 4432,
      "arabic_text": "أَنْ أَدُّوٓا۟ إِلَىَّ عِبَادَ ٱللَّهِ ۖ إِنِّى لَكُمْ رَسُولٌ أَمِينٌۭ",
      "urdu_text": "(جنہوں نے) یہ (کہا) کہ خدا کے بندوں (یعنی بنی اسرائیل) کو میرے حوالے کردو میں تمہارا امانت دار پیغمبر ہوں",
      "juz": 25,
      "page": 496,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4432.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 4433,
      "arabic_text": "وَأَن لَّا تَعْلُوا۟ عَلَى ٱللَّهِ ۖ إِنِّىٓ ءَاتِيكُم بِسُلْطَٰنٍۢ مُّبِينٍۢ",
      "urdu_text": "اور خدا کے سامنے سرکشی نہ کرو۔ میں تمہارے پاس کھلی دلیل لے کر آیا ہوں",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4433.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 4434,
      "arabic_text": "وَإِنِّى عُذْتُ بِرَبِّى وَرَبِّكُمْ أَن تَرْجُمُونِ",
      "urdu_text": "اور اس (بات) سے کہ تم مجھے سنگسار کرو اپنے اور تمہارے پروردگار کی پناہ مانگتا ہوں",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4434.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 4435,
      "arabic_text": "وَإِن لَّمْ تُؤْمِنُوا۟ لِى فَٱعْتَزِلُونِ",
      "urdu_text": "اور اگر تم مجھ پر ایمان نہیں لاتے تو مجھ سے الگ ہو جاؤ",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4435.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 4436,
      "arabic_text": "فَدَعَا رَبَّهُۥٓ أَنَّ هَٰٓؤُلَآءِ قَوْمٌۭ مُّجْرِمُونَ",
      "urdu_text": "تب موسیٰ نے اپنے پروردگار سے دعا کی کہ یہ نافرمان لوگ ہیں",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4436.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 4437,
      "arabic_text": "فَأَسْرِ بِعِبَادِى لَيْلًا إِنَّكُم مُّتَّبَعُونَ",
      "urdu_text": "(خدا نے فرمایا کہ) میرے بندوں کو راتوں رات لے کر چلے جاؤ اور (فرعونی) ضرور تمہارا تعاقب کریں گے",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4437.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 4438,
      "arabic_text": "وَٱتْرُكِ ٱلْبَحْرَ رَهْوًا ۖ إِنَّهُمْ جُندٌۭ مُّغْرَقُونَ",
      "urdu_text": "اور دریا سے (کہ) خشک (ہو رہا ہوگا) پار ہو جاؤ (تمہارے بعد) ان کا تمام لشکر ڈبو دیا جائے گا",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4438.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 4439,
      "arabic_text": "كَمْ تَرَكُوا۟ مِن جَنَّٰتٍۢ وَعُيُونٍۢ",
      "urdu_text": "وہ لوگ بہت سے باغ اور چشمے چھوڑ گئے",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4439.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 4440,
      "arabic_text": "وَزُرُوعٍۢ وَمَقَامٍۢ كَرِيمٍۢ",
      "urdu_text": "اور کھیتیاں اور نفیس مکان",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4440.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 4441,
      "arabic_text": "وَنَعْمَةٍۢ كَانُوا۟ فِيهَا فَٰكِهِينَ",
      "urdu_text": "اور آرام کی چیزیں جن میں عیش کیا کرتے تھے",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4441.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 4442,
      "arabic_text": "كَذَٰلِكَ ۖ وَأَوْرَثْنَٰهَا قَوْمًا ءَاخَرِينَ",
      "urdu_text": "اسی طرح (ہوا) اور ہم نے دوسرے لوگوں کو ان چیزوں کا مالک بنا دیا",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4442.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 4443,
      "arabic_text": "فَمَا بَكَتْ عَلَيْهِمُ ٱلسَّمَآءُ وَٱلْأَرْضُ وَمَا كَانُوا۟ مُنظَرِينَ",
      "urdu_text": "پھر ان پر نہ تو آسمان کو اور زمین کو رونا آیا اور نہ ان کو مہلت ہی دی گئی",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4443.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 4444,
      "arabic_text": "وَلَقَدْ نَجَّيْنَا بَنِىٓ إِسْرَٰٓءِيلَ مِنَ ٱلْعَذَابِ ٱلْمُهِينِ",
      "urdu_text": "اور ہم نے بنی اسرائیل کو ذلت کے عذاب سے نجات دی",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4444.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044030.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044030.mp3"
    },
    {
      "ayah_number": 31,
      "global_number": 4445,
      "arabic_text": "مِن فِرْعَوْنَ ۚ إِنَّهُۥ كَانَ عَالِيًۭا مِّنَ ٱلْمُسْرِفِينَ",
      "urdu_text": "(یعنی) فرعون سے۔ بےشک وہ سرکش (اور) حد سے نکلا ہوا تھا",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4445.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044031.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044031.mp3"
    },
    {
      "ayah_number": 32,
      "global_number": 4446,
      "arabic_text": "وَلَقَدِ ٱخْتَرْنَٰهُمْ عَلَىٰ عِلْمٍ عَلَى ٱلْعَٰلَمِينَ",
      "urdu_text": "اور ہم نے بنی اسرائیل کو اہل عالم سے دانستہ منتخب کیا تھا",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4446.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044032.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044032.mp3"
    },
    {
      "ayah_number": 33,
      "global_number": 4447,
      "arabic_text": "وَءَاتَيْنَٰهُم مِّنَ ٱلْءَايَٰتِ مَا فِيهِ بَلَٰٓؤٌۭا۟ مُّبِينٌ",
      "urdu_text": "اور ان کو ایسی نشانیاں دی تھیں جن میں صریح آزمائش تھی",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4447.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044033.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044033.mp3"
    },
    {
      "ayah_number": 34,
      "global_number": 4448,
      "arabic_text": "إِنَّ هَٰٓؤُلَآءِ لَيَقُولُونَ",
      "urdu_text": "یہ لوگ یہ کہتے ہیں",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4448.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044034.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044034.mp3"
    },
    {
      "ayah_number": 35,
      "global_number": 4449,
      "arabic_text": "إِنْ هِىَ إِلَّا مَوْتَتُنَا ٱلْأُولَىٰ وَمَا نَحْنُ بِمُنشَرِينَ",
      "urdu_text": "کہ ہمیں صرف پہلی دفعہ (یعنی ایک بار) مرنا ہے اور (پھر) اُٹھنا نہیں",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4449.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044035.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044035.mp3"
    },
    {
      "ayah_number": 36,
      "global_number": 4450,
      "arabic_text": "فَأْتُوا۟ بِـَٔابَآئِنَآ إِن كُنتُمْ صَٰدِقِينَ",
      "urdu_text": "پس اگر تم سچے ہو تو ہمارے باپ دادا کو (زندہ کر) لاؤ",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4450.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044036.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044036.mp3"
    },
    {
      "ayah_number": 37,
      "global_number": 4451,
      "arabic_text": "أَهُمْ خَيْرٌ أَمْ قَوْمُ تُبَّعٍۢ وَٱلَّذِينَ مِن قَبْلِهِمْ ۚ أَهْلَكْنَٰهُمْ ۖ إِنَّهُمْ كَانُوا۟ مُجْرِمِينَ",
      "urdu_text": "بھلا یہ اچھے ہیں یا تُبّع کی قوم اور وہ لوگ جو تم سے پہلے ہوچکے ہیں۔ ہم نے ان (سب) کو ہلاک کردیا۔ بےشک وہ گنہگار تھے",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4451.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044037.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044037.mp3"
    },
    {
      "ayah_number": 38,
      "global_number": 4452,
      "arabic_text": "وَمَا خَلَقْنَا ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا لَٰعِبِينَ",
      "urdu_text": "اور ہم نے آسمانوں اور زمین کو اور جو کچھ ان میں ہے ان کو کھیلتے ہوئے نہیں بنایا",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4452.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044038.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044038.mp3"
    },
    {
      "ayah_number": 39,
      "global_number": 4453,
      "arabic_text": "مَا خَلَقْنَٰهُمَآ إِلَّا بِٱلْحَقِّ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ",
      "urdu_text": "ان کو ہم نے تدبیر سے پیدا کیا ہے لیکن اکثر لوگ نہیں جانتے",
      "juz": 25,
      "page": 497,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4453.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044039.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044039.mp3"
    },
    {
      "ayah_number": 40,
      "global_number": 4454,
      "arabic_text": "إِنَّ يَوْمَ ٱلْفَصْلِ مِيقَٰتُهُمْ أَجْمَعِينَ",
      "urdu_text": "کچھ شک نہیں کہ فیصلے کا دن ان سب (کے اُٹھنے) کا وقت ہے",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4454.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044040.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044040.mp3"
    },
    {
      "ayah_number": 41,
      "global_number": 4455,
      "arabic_text": "يَوْمَ لَا يُغْنِى مَوْلًى عَن مَّوْلًۭى شَيْـًۭٔا وَلَا هُمْ يُنصَرُونَ",
      "urdu_text": "جس دن کوئی دوست کسی دوست کے کچھ کام نہ آئے گا اور نہ ان کو مدد ملے گی",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4455.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044041.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044041.mp3"
    },
    {
      "ayah_number": 42,
      "global_number": 4456,
      "arabic_text": "إِلَّا مَن رَّحِمَ ٱللَّهُ ۚ إِنَّهُۥ هُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ",
      "urdu_text": "مگر جس پر خدا مہربانی کرے۔ وہ تو غالب اور مہربان ہے",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4456.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044042.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044042.mp3"
    },
    {
      "ayah_number": 43,
      "global_number": 4457,
      "arabic_text": "إِنَّ شَجَرَتَ ٱلزَّقُّومِ",
      "urdu_text": "بلاشبہ تھوہر کا درخت",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4457.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044043.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044043.mp3"
    },
    {
      "ayah_number": 44,
      "global_number": 4458,
      "arabic_text": "طَعَامُ ٱلْأَثِيمِ",
      "urdu_text": "گنہگار کا کھانا ہے",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4458.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044044.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044044.mp3"
    },
    {
      "ayah_number": 45,
      "global_number": 4459,
      "arabic_text": "كَٱلْمُهْلِ يَغْلِى فِى ٱلْبُطُونِ",
      "urdu_text": "جیسے پگھلا ہوا تانبا۔ پیٹوں میں (اس طرح) کھولے گا",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4459.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044045.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044045.mp3"
    },
    {
      "ayah_number": 46,
      "global_number": 4460,
      "arabic_text": "كَغَلْىِ ٱلْحَمِيمِ",
      "urdu_text": "جس طرح گرم پانی کھولتا ہے",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4460.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044046.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044046.mp3"
    },
    {
      "ayah_number": 47,
      "global_number": 4461,
      "arabic_text": "خُذُوهُ فَٱعْتِلُوهُ إِلَىٰ سَوَآءِ ٱلْجَحِيمِ",
      "urdu_text": "(حکم دیا جائے گا کہ) اس کو پکڑ لو اور کھینچتے ہوئے دوزخ کے بیچوں بیچ لے جاؤ",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4461.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044047.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044047.mp3"
    },
    {
      "ayah_number": 48,
      "global_number": 4462,
      "arabic_text": "ثُمَّ صُبُّوا۟ فَوْقَ رَأْسِهِۦ مِنْ عَذَابِ ٱلْحَمِيمِ",
      "urdu_text": "پھر اس کے سر پر کھولتا ہوا پانی انڈیل دو (کہ عذاب پر) عذاب (ہو)",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4462.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044048.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044048.mp3"
    },
    {
      "ayah_number": 49,
      "global_number": 4463,
      "arabic_text": "ذُقْ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْكَرِيمُ",
      "urdu_text": "(اب) مزہ چکھ۔ تو بڑی عزت والا (اور) سردار ہے",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4463.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044049.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044049.mp3"
    },
    {
      "ayah_number": 50,
      "global_number": 4464,
      "arabic_text": "إِنَّ هَٰذَا مَا كُنتُم بِهِۦ تَمْتَرُونَ",
      "urdu_text": "یہ وہی (دوزخ) ہے جس میں تم لوگ شک کیا کرتے تھے",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4464.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044050.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044050.mp3"
    },
    {
      "ayah_number": 51,
      "global_number": 4465,
      "arabic_text": "إِنَّ ٱلْمُتَّقِينَ فِى مَقَامٍ أَمِينٍۢ",
      "urdu_text": "بےشک پرہیزگار لوگ امن کے مقام میں ہوں گے",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4465.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044051.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044051.mp3"
    },
    {
      "ayah_number": 52,
      "global_number": 4466,
      "arabic_text": "فِى جَنَّٰتٍۢ وَعُيُونٍۢ",
      "urdu_text": "(یعنی) باغوں اور چشموں میں",
      "juz": 25,
      "page": 498,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4466.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/044052.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/044052.mp3"
    },
    {
      "ayah_number": 53,
      "global_number": 4467,
      "arabic_text": "يَلْبَسُونَ مِن سُندُسٍۢ وَإِسْتَبْرَقٍۢ مُّتَقَٰبِلِينَ",
      "urdu_text": "حریر کا باریک اور دبیز لباس پہن کر ایک دوسرے کے سامنے بیٹھے ہوں گے",
      "juz": 25,
