{
  "surah_number": 88,
  "name_arabic": "سُورَةُ الغَاشِيَةِ",
  "name_english": "Al-Ghaashiya",
  "name_urdu": "The Overwhelming",
  "revelation_type": "Meccan",
  "total_ayahs": 26,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5968,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَٰشِيَةِ",
      "urdu_text": "بھلا تم کو ڈھانپ لینے والی (یعنی قیامت کا) حال معلوم ہوا ہے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5968.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5969,
      "arabic_text": "وُجُوهٌۭ يَوْمَئِذٍ خَٰشِعَةٌ",
      "urdu_text": "اس روز بہت سے منہ (والے) ذلیل ہوں گے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5969.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5970,
      "arabic_text": "عَامِلَةٌۭ نَّاصِبَةٌۭ",
      "urdu_text": "سخت محنت کرنے والے تھکے ماندے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5970.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5971,
      "arabic_text": "تَصْلَىٰ نَارًا حَامِيَةًۭ",
      "urdu_text": "دہکتی آگ میں داخل ہوں گے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5971.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5972,
      "arabic_text": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍۢ",
      "urdu_text": "ایک کھولتے ہوئے چشمے کا ان کو پانی پلایا جائے گا",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5972.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5973,
      "arabic_text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍۢ",
      "urdu_text": "اور خار دار جھاڑ کے سوا ان کے لیے کوئی کھانا نہیں (ہو گا)",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5973.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5974,
      "arabic_text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍۢ",
      "urdu_text": "جو نہ فربہی لائے اور نہ بھوک میں کچھ کام آئے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5974.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5975,
      "arabic_text": "وُجُوهٌۭ يَوْمَئِذٍۢ نَّاعِمَةٌۭ",
      "urdu_text": "اور بہت سے منہ (والے) اس روز شادماں ہوں گے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5975.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5976,
      "arabic_text": "لِّسَعْيِهَا رَاضِيَةٌۭ",
      "urdu_text": "اپنے اعمال (کی جزا) سے خوش دل",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5976.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5977,
      "arabic_text": "فِى جَنَّةٍ عَالِيَةٍۢ",
      "urdu_text": "بہشت بریں میں",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5977.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5978,
      "arabic_text": "لَّا تَسْمَعُ فِيهَا لَٰغِيَةًۭ",
      "urdu_text": "وہاں کسی طرح کی بکواس نہیں سنیں گے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5978.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5979,
      "arabic_text": "فِيهَا عَيْنٌۭ جَارِيَةٌۭ",
      "urdu_text": "اس میں چشمے بہ رہے ہوں گے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5979.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5980,
      "arabic_text": "فِيهَا سُرُرٌۭ مَّرْفُوعَةٌۭ",
      "urdu_text": "وہاں تخت ہوں گے اونچے بچھے ہوئے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5980.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5981,
      "arabic_text": "وَأَكْوَابٌۭ مَّوْضُوعَةٌۭ",
      "urdu_text": "اور آبخورے (قرینے سے) رکھے ہوئے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5981.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5982,
      "arabic_text": "وَنَمَارِقُ مَصْفُوفَةٌۭ",
      "urdu_text": "اور گاؤ تکیے قطار کی قطار لگے ہوئے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5982.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5983,
      "arabic_text": "وَزَرَابِىُّ مَبْثُوثَةٌ",
      "urdu_text": "اور نفیس مسندیں بچھی ہوئی",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5983.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5984,
      "arabic_text": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
      "urdu_text": "یہ لوگ اونٹوں کی طرف نہیں دیکھتے کہ کیسے (عجیب) پیدا کیے گئے ہیں",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5984.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5985,
      "arabic_text": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
      "urdu_text": "اور آسمان کی طرف کہ کیسا بلند کیا گیا ہے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5985.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5986,
      "arabic_text": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
      "urdu_text": "اور پہاڑوں کی طرف کہ کس طرح کھڑے کیے گئے ہیں",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5986.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5987,
      "arabic_text": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
      "urdu_text": "اور زمین کی طرف کہ کس طرح بچھائی گئی",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5987.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5988,
      "arabic_text": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌۭ",
      "urdu_text": "تو تم نصیحت کرتے رہو کہ تم نصیحت کرنے والے ہی ہو",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5988.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5989,
      "arabic_text": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
      "urdu_text": "تم ان پر داروغہ نہیں ہو",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5989.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5990,
      "arabic_text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "urdu_text": "ہاں جس نے منہ پھیرا اور نہ مانا",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5990.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5991,
      "arabic_text": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
      "urdu_text": "تو خدا اس کو بڑا عذاب دے گا",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5991.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5992,
      "arabic_text": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
      "urdu_text": "بےشک ان کو ہمارے پاس لوٹ کر آنا ہے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5992.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 5993,
      "arabic_text": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
      "urdu_text": "پھر ہم ہی کو ان سے حساب لینا ہے",
      "juz": 30,
      "page": 592,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5993.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/088026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/088026.mp3"
    }
  ]
}