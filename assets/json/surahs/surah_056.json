{
  "surah_number": 56,
  "name_arabic": "سُورَةُ الوَاقِعَةِ",
  "name_english": "Al-Waaqia",
  "name_urdu": "The Inevitable",
  "revelation_type": "Meccan",
  "total_ayahs": 96,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 4980,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا وَقَعَتِ ٱلْوَاقِعَةُ",
      "urdu_text": "جب واقع ہونے والی واقع ہوجائے",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4980.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 4981,
      "arabic_text": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
      "urdu_text": "اس کے واقع ہونے میں کچھ جھوٹ نہیں",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4981.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 4982,
      "arabic_text": "خَافِضَةٌۭ رَّافِعَةٌ",
      "urdu_text": "کسی کو پست کرے کسی کو بلند",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4982.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 4983,
      "arabic_text": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّۭا",
      "urdu_text": "جب زمین بھونچال سے لرزنے لگے",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4983.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 4984,
      "arabic_text": "وَبُسَّتِ ٱلْجِبَالُ بَسًّۭا",
      "urdu_text": "اور پہاڑ ٹوٹ کر ریزہ ریزہ ہوجائیں",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4984.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 4985,
      "arabic_text": "فَكَانَتْ هَبَآءًۭ مُّنۢبَثًّۭا",
      "urdu_text": "پھر غبار ہو کر اُڑنے لگیں",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4985.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 4986,
      "arabic_text": "وَكُنتُمْ أَزْوَٰجًۭا ثَلَٰثَةًۭ",
      "urdu_text": "اور تم لوگ تین قسم ہوجاؤ",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4986.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 4987,
      "arabic_text": "فَأَصْحَٰبُ ٱلْمَيْمَنَةِ مَآ أَصْحَٰبُ ٱلْمَيْمَنَةِ",
      "urdu_text": "تو داہنے ہاتھ والے (سبحان الله) داہنے ہاتھ والے کیا (ہی چین میں) ہیں",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4987.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 4988,
      "arabic_text": "وَأَصْحَٰبُ ٱلْمَشْـَٔمَةِ مَآ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ",
      "urdu_text": "اور بائیں ہاتھ والے (افسوس) بائیں ہاتھ والے کیا (گرفتار عذاب) ہیں",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4988.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 4989,
      "arabic_text": "وَٱلسَّٰبِقُونَ ٱلسَّٰبِقُونَ",
      "urdu_text": "اور جو آگے بڑھنے والے ہیں (ان کا کیا کہنا) وہ آگے ہی بڑھنے والے ہیں",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4989.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 4990,
      "arabic_text": "أُو۟لَٰٓئِكَ ٱلْمُقَرَّبُونَ",
      "urdu_text": "وہی (خدا کے) مقرب ہیں",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4990.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 4991,
      "arabic_text": "فِى جَنَّٰتِ ٱلنَّعِيمِ",
      "urdu_text": "نعمت کے بہشتوں میں",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4991.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 4992,
      "arabic_text": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ",
      "urdu_text": "وہ بہت سے تو اگلے لوگوں میں سے ہوں گے",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4992.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 4993,
      "arabic_text": "وَقَلِيلٌۭ مِّنَ ٱلْءَاخِرِينَ",
      "urdu_text": "اور تھوڑے سے پچھلوں میں سے",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4993.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 4994,
      "arabic_text": "عَلَىٰ سُرُرٍۢ مَّوْضُونَةٍۢ",
      "urdu_text": "(لعل و یاقوت وغیرہ سے) جڑے ہوئے تختوں پر",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4994.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 4995,
      "arabic_text": "مُّتَّكِـِٔينَ عَلَيْهَا مُتَقَٰبِلِينَ",
      "urdu_text": "آمنے سامنے تکیہ لگائے ہوئے",
      "juz": 27,
      "page": 534,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4995.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 4996,
      "arabic_text": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌۭ مُّخَلَّدُونَ",
      "urdu_text": "نوجوان خدمت گزار جو ہمیشہ (ایک ہی حالت میں) رہیں گے ان کے آس پاس پھریں گے",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4996.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 4997,
      "arabic_text": "بِأَكْوَابٍۢ وَأَبَارِيقَ وَكَأْسٍۢ مِّن مَّعِينٍۢ",
      "urdu_text": "یعنی آبخورے اور آفتابے اور صاف شراب کے گلاس لے لے کر",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4997.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 4998,
      "arabic_text": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ",
      "urdu_text": "اس سے نہ تو سر میں درد ہوگا اور نہ ان کی عقلیں زائل ہوں گی",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4998.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 4999,
      "arabic_text": "وَفَٰكِهَةٍۢ مِّمَّا يَتَخَيَّرُونَ",
      "urdu_text": "اور میوے جس طرح کے ان کو پسند ہوں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/4999.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5000,
      "arabic_text": "وَلَحْمِ طَيْرٍۢ مِّمَّا يَشْتَهُونَ",
      "urdu_text": "اور پرندوں کا گوشت جس قسم کا ان کا جی چاہے",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5000.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5001,
      "arabic_text": "وَحُورٌ عِينٌۭ",
      "urdu_text": "اور بڑی بڑی آنکھوں والی حوریں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5001.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5002,
      "arabic_text": "كَأَمْثَٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ",
      "urdu_text": "جیسے (حفاظت سے) تہہ کئے ہوئے (آب دار) موتی",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5002.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5003,
      "arabic_text": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ",
      "urdu_text": "یہ ان اعمال کا بدلہ ہے جو وہ کرتے تھے",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5003.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5004,
      "arabic_text": "لَا يَسْمَعُونَ فِيهَا لَغْوًۭا وَلَا تَأْثِيمًا",
      "urdu_text": "وہاں نہ بیہودہ بات سنیں گے اور نہ گالی گلوچ",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5004.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 5005,
      "arabic_text": "إِلَّا قِيلًۭا سَلَٰمًۭا سَلَٰمًۭا",
      "urdu_text": "ہاں ان کا کلام سلام سلام (ہوگا)",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5005.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 5006,
      "arabic_text": "وَأَصْحَٰبُ ٱلْيَمِينِ مَآ أَصْحَٰبُ ٱلْيَمِينِ",
      "urdu_text": "اور داہنے ہاتھ والے (سبحان الله) داہنے ہاتھ والے کیا (ہی عیش میں) ہیں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5006.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 5007,
      "arabic_text": "فِى سِدْرٍۢ مَّخْضُودٍۢ",
      "urdu_text": "(یعنی) بےخار کی بیریوں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5007.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 5008,
      "arabic_text": "وَطَلْحٍۢ مَّنضُودٍۢ",
      "urdu_text": "اور تہہ بہ تہہ کیلوں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5008.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 5009,
      "arabic_text": "وَظِلٍّۢ مَّمْدُودٍۢ",
      "urdu_text": "اور لمبے لمبے سایوں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5009.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056030.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056030.mp3"
    },
    {
      "ayah_number": 31,
      "global_number": 5010,
      "arabic_text": "وَمَآءٍۢ مَّسْكُوبٍۢ",
      "urdu_text": "اور پانی کے جھرنوں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5010.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056031.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056031.mp3"
    },
    {
      "ayah_number": 32,
      "global_number": 5011,
      "arabic_text": "وَفَٰكِهَةٍۢ كَثِيرَةٍۢ",
      "urdu_text": "اور میوہ ہائے کثیرہ (کے باغوں) میں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5011.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056032.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056032.mp3"
    },
    {
      "ayah_number": 33,
      "global_number": 5012,
      "arabic_text": "لَّا مَقْطُوعَةٍۢ وَلَا مَمْنُوعَةٍۢ",
      "urdu_text": "جو نہ کبھی ختم ہوں اور نہ ان سے کوئی روکے",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5012.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056033.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056033.mp3"
    },
    {
      "ayah_number": 34,
      "global_number": 5013,
      "arabic_text": "وَفُرُشٍۢ مَّرْفُوعَةٍ",
      "urdu_text": "اور اونچے اونچے فرشوں میں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5013.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056034.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056034.mp3"
    },
    {
      "ayah_number": 35,
      "global_number": 5014,
      "arabic_text": "إِنَّآ أَنشَأْنَٰهُنَّ إِنشَآءًۭ",
      "urdu_text": "ہم نے ان (حوروں) کو پیدا کیا",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5014.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056035.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056035.mp3"
    },
    {
      "ayah_number": 36,
      "global_number": 5015,
      "arabic_text": "فَجَعَلْنَٰهُنَّ أَبْكَارًا",
      "urdu_text": "تو ان کو کنواریاں بنایا",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5015.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056036.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056036.mp3"
    },
    {
      "ayah_number": 37,
      "global_number": 5016,
      "arabic_text": "عُرُبًا أَتْرَابًۭا",
      "urdu_text": "(اور شوہروں کی) پیاریاں اور ہم عمر",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5016.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056037.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056037.mp3"
    },
    {
      "ayah_number": 38,
      "global_number": 5017,
      "arabic_text": "لِّأَصْحَٰبِ ٱلْيَمِينِ",
      "urdu_text": "یعنی داہنے ہاتھ والوں کے لئے",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5017.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056038.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056038.mp3"
    },
    {
      "ayah_number": 39,
      "global_number": 5018,
      "arabic_text": "ثُلَّةٌۭ مِّنَ ٱلْأَوَّلِينَ",
      "urdu_text": "(یہ) بہت سے اگلے لوگوں میں سے ہیں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5018.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056039.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056039.mp3"
    },
    {
      "ayah_number": 40,
      "global_number": 5019,
      "arabic_text": "وَثُلَّةٌۭ مِّنَ ٱلْءَاخِرِينَ",
      "urdu_text": "اور بہت سے پچھلوں میں سے",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5019.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056040.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056040.mp3"
    },
    {
      "ayah_number": 41,
      "global_number": 5020,
      "arabic_text": "وَأَصْحَٰبُ ٱلشِّمَالِ مَآ أَصْحَٰبُ ٱلشِّمَالِ",
      "urdu_text": "اور بائیں ہاتھ والے (افسوس) بائیں ہاتھ والے کیا (ہی عذاب میں) ہیں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5020.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056041.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056041.mp3"
    },
    {
      "ayah_number": 42,
      "global_number": 5021,
      "arabic_text": "فِى سَمُومٍۢ وَحَمِيمٍۢ",
      "urdu_text": "(یعنی دوزخ کی) لپٹ اور کھولتے ہوئے پانی میں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5021.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056042.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056042.mp3"
    },
    {
      "ayah_number": 43,
      "global_number": 5022,
      "arabic_text": "وَظِلٍّۢ مِّن يَحْمُومٍۢ",
      "urdu_text": "اور سیاہ دھوئیں کے سائے میں",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5022.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056043.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056043.mp3"
    },
    {
      "ayah_number": 44,
      "global_number": 5023,
      "arabic_text": "لَّا بَارِدٍۢ وَلَا كَرِيمٍ",
      "urdu_text": "(جو) نہ ٹھنڈا (ہے) نہ خوشنما",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5023.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056044.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056044.mp3"
    },
    {
      "ayah_number": 45,
      "global_number": 5024,
      "arabic_text": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ",
      "urdu_text": "یہ لوگ اس سے پہلے عیشِ نعیم میں پڑے ہوئے تھے",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5024.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056045.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056045.mp3"
    },
    {
      "ayah_number": 46,
      "global_number": 5025,
      "arabic_text": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ",
      "urdu_text": "اور گناہ عظیم پر اڑے ہوئے تھے",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5025.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056046.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056046.mp3"
    },
    {
      "ayah_number": 47,
      "global_number": 5026,
      "arabic_text": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ",
      "urdu_text": "اور کہا کرتے تھے کہ بھلا جب ہم مرگئے اور مٹی ہوگئے اور ہڈیاں (ہی ہڈیاں رہ گئے) تو کیا ہمیں پھر اُٹھنا ہوگا؟",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5026.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056047.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056047.mp3"
    },
    {
      "ayah_number": 48,
      "global_number": 5027,
      "arabic_text": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
      "urdu_text": "اور کیا ہمارے باپ دادا کو بھی؟",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5027.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056048.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056048.mp3"
    },
    {
      "ayah_number": 49,
      "global_number": 5028,
      "arabic_text": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ",
      "urdu_text": "کہہ دو کہ بےشک پہلے اور پچھلے",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5028.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056049.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056049.mp3"
    },
    {
      "ayah_number": 50,
      "global_number": 5029,
      "arabic_text": "لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍۢ مَّعْلُومٍۢ",
      "urdu_text": "(سب) ایک روز مقرر کے وقت پر جمع کئے جائیں گے",
      "juz": 27,
      "page": 535,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5029.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056050.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056050.mp3"
    },
    {
      "ayah_number": 51,
      "global_number": 5030,
      "arabic_text": "ثُمَّ إِنَّكُمْ أَيُّهَا ٱلضَّآلُّونَ ٱلْمُكَذِّبُونَ",
      "urdu_text": "پھر تم اے جھٹلانے والے گمرا ہو!",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5030.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056051.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056051.mp3"
    },
    {
      "ayah_number": 52,
      "global_number": 5031,
      "arabic_text": "لَءَاكِلُونَ مِن شَجَرٍۢ مِّن زَقُّومٍۢ",
      "urdu_text": "تھوہر کے درخت کھاؤ گے",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5031.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056052.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056052.mp3"
    },
    {
      "ayah_number": 53,
      "global_number": 5032,
      "arabic_text": "فَمَالِـُٔونَ مِنْهَا ٱلْبُطُونَ",
      "urdu_text": "اور اسی سے پیٹ بھرو گے",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5032.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056053.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056053.mp3"
    },
    {
      "ayah_number": 54,
      "global_number": 5033,
      "arabic_text": "فَشَٰرِبُونَ عَلَيْهِ مِنَ ٱلْحَمِيمِ",
      "urdu_text": "اور اس پر کھولتا ہوا پانی پیو گے",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5033.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056054.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056054.mp3"
    },
    {
      "ayah_number": 55,
      "global_number": 5034,
      "arabic_text": "فَشَٰرِبُونَ شُرْبَ ٱلْهِيمِ",
      "urdu_text": "اور پیو گے بھی تو اس طرح جیسے پیاسے اونٹ پیتے ہیں",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5034.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056055.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056055.mp3"
    },
    {
      "ayah_number": 56,
      "global_number": 5035,
      "arabic_text": "هَٰذَا نُزُلُهُمْ يَوْمَ ٱلدِّينِ",
      "urdu_text": "جزا کے دن یہ ان کی ضیافت ہوگی",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5035.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056056.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056056.mp3"
    },
    {
      "ayah_number": 57,
      "global_number": 5036,
      "arabic_text": "نَحْنُ خَلَقْنَٰكُمْ فَلَوْلَا تُصَدِّقُونَ",
      "urdu_text": "ہم نے تم کو (پہلی بار بھی تو) پیدا کیا ہے تو تم (دوبارہ اُٹھنے کو) کیوں سچ نہیں سمجھتے؟",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5036.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056057.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056057.mp3"
    },
    {
      "ayah_number": 58,
      "global_number": 5037,
      "arabic_text": "أَفَرَءَيْتُم مَّا تُمْنُونَ",
      "urdu_text": "دیکھو تو کہ جس (نطفے) کو تم (عورتوں کے رحم میں) ڈالتے ہو",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5037.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056058.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056058.mp3"
    },
    {
      "ayah_number": 59,
      "global_number": 5038,
      "arabic_text": "ءَأَنتُمْ تَخْلُقُونَهُۥٓ أَمْ نَحْنُ ٱلْخَٰلِقُونَ",
      "urdu_text": "کیا تم اس (سے انسان) کو بناتے ہو یا ہم بناتے ہیں؟",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5038.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056059.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056059.mp3"
    },
    {
      "ayah_number": 60,
      "global_number": 5039,
      "arabic_text": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ ٱلْمَوْتَ وَمَا نَحْنُ بِمَسْبُوقِينَ",
      "urdu_text": "ہم نے تم میں مرنا ٹھہرا دیا ہے اور ہم اس (بات) سے عاجز نہیں",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5039.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056060.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056060.mp3"
    },
    {
      "ayah_number": 61,
      "global_number": 5040,
      "arabic_text": "عَلَىٰٓ أَن نُّبَدِّلَ أَمْثَٰلَكُمْ وَنُنشِئَكُمْ فِى مَا لَا تَعْلَمُونَ",
      "urdu_text": "کہ تمہاری طرح کے اور لوگ تمہاری جگہ لے آئیں اور تم کو ایسے جہان میں جس کو تم نہیں جانتے پیدا کر دیں",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5040.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056061.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056061.mp3"
    },
    {
      "ayah_number": 62,
      "global_number": 5041,
      "arabic_text": "وَلَقَدْ عَلِمْتُمُ ٱلنَّشْأَةَ ٱلْأُولَىٰ فَلَوْلَا تَذَكَّرُونَ",
      "urdu_text": "اور تم نے پہلی پیدائش تو جان ہی لی ہے۔ پھر تم سوچتے کیوں نہیں؟",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5041.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056062.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056062.mp3"
    },
    {
      "ayah_number": 63,
      "global_number": 5042,
      "arabic_text": "أَفَرَءَيْتُم مَّا تَحْرُثُونَ",
      "urdu_text": "بھلا دیکھو تو کہ جو کچھ تم بوتے ہو",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5042.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056063.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056063.mp3"
    },
    {
      "ayah_number": 64,
      "global_number": 5043,
      "arabic_text": "ءَأَنتُمْ تَزْرَعُونَهُۥٓ أَمْ نَحْنُ ٱلزَّٰرِعُونَ",
      "urdu_text": "تو کیا تم اسے اُگاتے ہو یا ہم اُگاتے ہیں؟",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5043.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056064.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056064.mp3"
    },
    {
      "ayah_number": 65,
      "global_number": 5044,
      "arabic_text": "لَوْ نَشَآءُ لَجَعَلْنَٰهُ حُطَٰمًۭا فَظَلْتُمْ تَفَكَّهُونَ",
      "urdu_text": "اگر ہم چاہیں تو اسے چورا چورا کردیں اور تم باتیں بناتے رہ جاؤ",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5044.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056065.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056065.mp3"
    },
    {
      "ayah_number": 66,
      "global_number": 5045,
      "arabic_text": "إِنَّا لَمُغْرَمُونَ",
      "urdu_text": "(کہ ہائے) ہم تو مفت تاوان میں پھنس گئے",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5045.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056066.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056066.mp3"
    },
    {
      "ayah_number": 67,
      "global_number": 5046,
      "arabic_text": "بَلْ نَحْنُ مَحْرُومُونَ",
      "urdu_text": "بلکہ ہم ہیں ہی بےنصیب",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5046.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056067.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056067.mp3"
    },
    {
      "ayah_number": 68,
      "global_number": 5047,
      "arabic_text": "أَفَرَءَيْتُمُ ٱلْمَآءَ ٱلَّذِى تَشْرَبُونَ",
      "urdu_text": "بھلا دیکھو تو کہ جو پانی تم پیتے ہو",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5047.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056068.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056068.mp3"
    },
    {
      "ayah_number": 69,
      "global_number": 5048,
      "arabic_text": "ءَأَنتُمْ أَنزَلْتُمُوهُ مِنَ ٱلْمُزْنِ أَمْ نَحْنُ ٱلْمُنزِلُونَ",
      "urdu_text": "کیا تم نے اس کو بادل سے نازل کیا ہے یا ہم نازل کرتے ہیں؟",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5048.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056069.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056069.mp3"
    },
    {
      "ayah_number": 70,
      "global_number": 5049,
      "arabic_text": "لَوْ نَشَآءُ جَعَلْنَٰهُ أُجَاجًۭا فَلَوْلَا تَشْكُرُونَ",
      "urdu_text": "اگر ہم چاہیں تو ہم اسے کھاری کردیں پھر تم شکر کیوں نہیں کرتے؟",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5049.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056070.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056070.mp3"
    },
    {
      "ayah_number": 71,
      "global_number": 5050,
      "arabic_text": "أَفَرَءَيْتُمُ ٱلنَّارَ ٱلَّتِى تُورُونَ",
      "urdu_text": "بھلا دیکھو تو جو آگ تم درخت سے نکالتے ہو",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5050.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056071.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056071.mp3"
    },
    {
      "ayah_number": 72,
      "global_number": 5051,
      "arabic_text": "ءَأَنتُمْ أَنشَأْتُمْ شَجَرَتَهَآ أَمْ نَحْنُ ٱلْمُنشِـُٔونَ",
      "urdu_text": "کیا تم نے اس کے درخت کو پیدا کیا ہے یا ہم پیدا کرتے ہیں؟",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5051.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056072.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056072.mp3"
    },
    {
      "ayah_number": 73,
      "global_number": 5052,
      "arabic_text": "نَحْنُ جَعَلْنَٰهَا تَذْكِرَةًۭ وَمَتَٰعًۭا لِّلْمُقْوِينَ",
      "urdu_text": "ہم نے اسے یاد دلانے اور مسافروں کے برتنے کو بنایا ہے",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5052.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056073.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056073.mp3"
    },
    {
      "ayah_number": 74,
      "global_number": 5053,
      "arabic_text": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
      "urdu_text": "تو تم اپنے پروردگار بزرگ کے نام کی تسبیح کرو",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5053.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056074.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056074.mp3"
    },
    {
      "ayah_number": 75,
      "global_number": 5054,
      "arabic_text": "۞ فَلَآ أُقْسِمُ بِمَوَٰقِعِ ٱلنُّجُومِ",
      "urdu_text": "ہمیں تاروں کی منزلوں کی قسم",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5054.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056075.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056075.mp3"
    },
    {
      "ayah_number": 76,
      "global_number": 5055,
      "arabic_text": "وَإِنَّهُۥ لَقَسَمٌۭ لَّوْ تَعْلَمُونَ عَظِيمٌ",
      "urdu_text": "اور اگر تم سمجھو تو یہ بڑی قسم ہے",
      "juz": 27,
      "page": 536,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5055.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056076.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056076.mp3"
    },
    {
      "ayah_number": 77,
      "global_number": 5056,
      "arabic_text": "إِنَّهُۥ لَقُرْءَانٌۭ كَرِيمٌۭ",
      "urdu_text": "کہ یہ بڑے رتبے کا قرآن ہے",
      "juz": 27,
      "page": 537,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5056.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056077.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056077.mp3"
    },
    {
      "ayah_number": 78,
      "global_number": 5057,
      "arabic_text": "فِى كِتَٰبٍۢ مَّكْنُونٍۢ",
      "urdu_text": "(جو) کتاب محفوظ میں (لکھا ہوا ہے)",
      "juz": 27,
      "page": 537,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5057.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056078.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056078.mp3"
    },
    {
      "ayah_number": 79,
      "global_number": 5058,
      "arabic_text": "لَّا يَمَسُّهُۥٓ إِلَّا ٱلْمُطَهَّرُونَ",
      "urdu_text": "اس کو وہی ہاتھ لگاتے ہیں جو پاک ہیں",
      "juz": 27,
      "page": 537,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5058.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056079.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056079.mp3"
    },
    {
      "ayah_number": 80,
      "global_number": 5059,
      "arabic_text": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ",
      "urdu_text": "پروردگار عالم کی طرف سے اُتارا گیا ہے",
      "juz": 27,
      "page": 537,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5059.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056080.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056080.mp3"
    },
    {
      "ayah_number": 81,
      "global_number": 5060,
      "arabic_text": "أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ",
      "urdu_text": "کیا تم اس کلام سے انکار کرتے ہو؟",
      "juz": 27,
      "page": 537,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5060.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056081.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056081.mp3"
    },
    {
      "ayah_number": 82,
      "global_number": 5061,
      "arabic_text": "وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ",
      "urdu_text": "اور اپنا وظیفہ یہ بناتے ہو کہ (اسے) جھٹلاتے ہو",
      "juz": 27,
      "page": 537,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5061.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056082.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056082.mp3"
    },
    {
      "ayah_number": 83,
      "global_number": 5062,
      "arabic_text": "فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ",
      "urdu_text": "بھلا جب روح گلے میں آ پہنچتی ہے",
      "juz": 27,
      "page": 537,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5062.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056083.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056083.mp3"
    },
    {
      "ayah_number": 84,
      "global_number": 5063,
      "arabic_text": "وَأَنتُمْ حِينَئِذٍۢ تَنظُرُونَ",
      "urdu_text": "اور تم اس وقت کی (حالت کو) دیکھا کرتے ہو",
      "juz": 27,
      "page": 537,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5063.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056084.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056084.mp3"
    },
    {
      "ayah_number": 85,
      "global_number": 5064,
      "arabic_text": "وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ",
      "urdu_text": "اور ہم اس (مرنے والے) سے تم سے بھی زیادہ نزدیک ہوتے ہیں لیکن تم کو نظر نہیں آتے",
      "juz": 27,
      "page": 537,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5064.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056085.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056085.mp3"
    },
    {
      "ayah_number": 86,
      "global_number": 5065,
      "arabic_text": "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ",
      "urdu_text": "پس اگر تم کسی کے بس میں نہیں ہو",
      "juz": 27,
      "page": 537,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5065.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056086.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056086.mp3"
    },
    {
      "ayah_number": 87,
      "global_number": 5066,
      "arabic_text": "تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ",
      "urdu_text": "تو اگر سچے ہو تو روح کو پھیر کیوں نہیں لیتے؟",
      "juz": 27,
      "page": 537,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5066.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056087.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056087.mp3"
    },
    {
      "ayah_number": 88,
      "global_number": 5067,
      "arabic_text": "فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ",
      "urdu_text": "پھر اگر وہ (خدا کے) مقربوں میں سے ہے",
      "juz": 27,
      "page": 537,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5067.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/056088.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/056088.mp3"
    },
    {
      "ayah_number": 89,
      "global_number": 5068,
