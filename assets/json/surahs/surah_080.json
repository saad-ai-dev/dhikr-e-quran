{
  "surah_number": 80,
  "name_arabic": "سُورَةُ عَبَسَ",
  "name_english": "Abasa",
  "name_urdu": "He frowned",
  "revelation_type": "Meccan",
  "total_ayahs": 42,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5759,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ",
      "urdu_text": "(محمد مصطفٰےﷺ) ترش رُو ہوئے اور منہ پھیر بیٹھے",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5759.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5760,
      "arabic_text": "أَن جَآءَهُ ٱلْأَعْمَىٰ",
      "urdu_text": "کہ ان کے پاس ایک نابینا آیا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5760.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5761,
      "arabic_text": "وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",
      "urdu_text": "اور تم کو کیا خبر شاید وہ پاکیزگی حاصل کرتا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5761.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5762,
      "arabic_text": "أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",
      "urdu_text": "یا سوچتا تو سمجھانا اسے فائدہ دیتا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5762.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5763,
      "arabic_text": "أَمَّا مَنِ ٱسْتَغْنَىٰ",
      "urdu_text": "جو پروا نہیں کرتا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5763.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5764,
      "arabic_text": "فَأَنتَ لَهُۥ تَصَدَّىٰ",
      "urdu_text": "اس کی طرف تو تم توجہ کرتے ہو",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5764.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5765,
      "arabic_text": "وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",
      "urdu_text": "حالانکہ اگر وہ نہ سنورے تو تم پر کچھ (الزام) نہیں",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5765.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5766,
      "arabic_text": "وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",
      "urdu_text": "اور جو تمہارے پاس دوڑتا ہوا آیا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5766.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5767,
      "arabic_text": "وَهُوَ يَخْشَىٰ",
      "urdu_text": "اور (خدا سے) ڈرتا ہے",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5767.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5768,
      "arabic_text": "فَأَنتَ عَنْهُ تَلَهَّىٰ",
      "urdu_text": "اس سے تم بےرخی کرتے ہو",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5768.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5769,
      "arabic_text": "كَلَّآ إِنَّهَا تَذْكِرَةٌۭ",
      "urdu_text": "دیکھو یہ (قرآن) نصیحت ہے",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5769.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5770,
      "arabic_text": "فَمَن شَآءَ ذَكَرَهُۥ",
      "urdu_text": "پس جو چاہے اسے یاد رکھے",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5770.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5771,
      "arabic_text": "فِى صُحُفٍۢ مُّكَرَّمَةٍۢ",
      "urdu_text": "قابل ادب ورقوں میں (لکھا ہوا)",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5771.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5772,
      "arabic_text": "مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ",
      "urdu_text": "جو بلند مقام پر رکھے ہوئے (اور) پاک ہیں",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5772.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5773,
      "arabic_text": "بِأَيْدِى سَفَرَةٍۢ",
      "urdu_text": "لکھنے والوں کے ہاتھوں میں",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5773.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5774,
      "arabic_text": "كِرَامٍۭ بَرَرَةٍۢ",
      "urdu_text": "جو سردار اور نیکو کار ہیں",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5774.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5775,
      "arabic_text": "قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ",
      "urdu_text": "انسان ہلاک ہو جائے کیسا ناشکرا ہے",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5775.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5776,
      "arabic_text": "مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",
      "urdu_text": "اُسے (خدا نے) کس چیز سے بنایا؟",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5776.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5777,
      "arabic_text": "مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",
      "urdu_text": "نطفے سے بنایا پھر اس کا اندازہ مقرر کیا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5777.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5778,
      "arabic_text": "ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",
      "urdu_text": "پھر اس کے لیے رستہ آسان کر دیا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5778.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5779,
      "arabic_text": "ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",
      "urdu_text": "پھر اس کو موت دی پھر قبر میں دفن کرایا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5779.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5780,
      "arabic_text": "ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",
      "urdu_text": "پھر جب چاہے گا اسے اٹھا کھڑا کرے گا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5780.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5781,
      "arabic_text": "كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",
      "urdu_text": "کچھ شک نہیں کہ خدا نے اسے جو حکم دیا اس نے اس پر عمل نہ کیا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5781.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5782,
      "arabic_text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",
      "urdu_text": "تو انسان کو چاہیئے کہ اپنے کھانے کی طرف نظر کرے",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5782.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5783,
      "arabic_text": "أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا",
      "urdu_text": "بے شک ہم ہی نے پانی برسایا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5783.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 5784,
      "arabic_text": "ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا",
      "urdu_text": "پھر ہم ہی نے زمین کو چیرا پھاڑا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5784.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 5785,
      "arabic_text": "فَأَنۢبَتْنَا فِيهَا حَبًّۭا",
      "urdu_text": "پھر ہم ہی نے اس میں اناج اگایا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5785.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 5786,
      "arabic_text": "وَعِنَبًۭا وَقَضْبًۭا",
      "urdu_text": "اور انگور اور ترکاری",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5786.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 5787,
      "arabic_text": "وَزَيْتُونًۭا وَنَخْلًۭا",
      "urdu_text": "اور زیتون اور کھجوریں",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5787.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 5788,
      "arabic_text": "وَحَدَآئِقَ غُلْبًۭا",
      "urdu_text": "اور گھنے گھنے باغ",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5788.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080030.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080030.mp3"
    },
    {
      "ayah_number": 31,
      "global_number": 5789,
      "arabic_text": "وَفَٰكِهَةًۭ وَأَبًّۭا",
      "urdu_text": "اور میوے اور چارا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5789.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080031.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080031.mp3"
    },
    {
      "ayah_number": 32,
      "global_number": 5790,
      "arabic_text": "مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ",
      "urdu_text": "(یہ سب کچھ) تمہارے اور تمہارے چارپایوں کے لیے بنایا",
      "juz": 30,
      "page": 585,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5790.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/080032.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/080032.mp3"
    },
    {
