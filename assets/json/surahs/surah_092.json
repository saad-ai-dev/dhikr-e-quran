{
  "surah_number": 92,
  "name_arabic": "سُورَةُ اللَّيۡلِ",
  "name_english": "Al-Lail",
  "name_urdu": "The Night",
  "revelation_type": "Meccan",
  "total_ayahs": 21,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 6059,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ",
      "urdu_text": "رات کی قسم جب (دن کو) چھپالے",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6059.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 6060,
      "arabic_text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "urdu_text": "اور دن کی قسم جب چمک اٹھے",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6060.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 6061,
      "arabic_text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "urdu_text": "اور اس (ذات) کی قسم جس نے نر اور مادہ پیدا کیے",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6061.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 6062,
      "arabic_text": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
      "urdu_text": "کہ تم لوگوں کی کوششں طرح طرح کی ہے",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6062.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 6063,
      "arabic_text": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
      "urdu_text": "تو جس نے (خدا کے رستے میں مال) دیا اور پرہیز گاری کی",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6063.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 6064,
      "arabic_text": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
      "urdu_text": "اور نیک بات کو سچ جانا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6064.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 6065,
      "arabic_text": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
      "urdu_text": "اس کو ہم آسان طریقے کی توفیق دیں گے",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6065.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 6066,
      "arabic_text": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
      "urdu_text": "اور جس نے بخل کیا اور بےپروا بنا رہا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6066.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 6067,
      "arabic_text": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
      "urdu_text": "اور نیک بات کو جھوٹ سمجھا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6067.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 6068,
      "arabic_text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "urdu_text": "اسے سختی میں پہنچائیں گے",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6068.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 6069,
      "arabic_text": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "urdu_text": "اور جب وہ (دوزخ کے گڑھے میں) گرے گا تو اس کا مال اس کے کچھ کام نہ آئے گا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6069.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 6070,
      "arabic_text": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "urdu_text": "ہمیں تو راہ دکھا دینا ہے",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6070.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 6071,
      "arabic_text": "وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ",
      "urdu_text": "اور آخرت او ردنیا ہماری ہی چیزیں ہیں",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6071.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 6072,
      "arabic_text": "فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ",
      "urdu_text": "سو میں نے تم کو بھڑکتی آگ سے متنبہ کر دیا",
      "juz": 30,
      "page": 595,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6072.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 6073,
      "arabic_text": "لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",
      "urdu_text": "اس میں وہی داخل ہو گا جو بڑا بدبخت ہے",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6073.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 6074,
      "arabic_text": "ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",
      "urdu_text": "جس نے جھٹلایا اور منہ پھیرا",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6074.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 6075,
      "arabic_text": "وَسَيُجَنَّبُهَا ٱلْأَتْقَى",
      "urdu_text": "اور جو بڑا پرہیزگار ہے وہ (اس سے) بچا لیا جائے گا",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6075.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 6076,
      "arabic_text": "ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",
      "urdu_text": "جو مال دیتا ہے تاکہ پاک ہو",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6076.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 6077,
      "arabic_text": "وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ",
      "urdu_text": "اور (اس لیے) نہیں (دیتا کہ) اس پر کسی کا احسان (ہے) جس کا وہ بدلہ اتارتا ہے",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6077.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 6078,
      "arabic_text": "إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",
      "urdu_text": "بلکہ اپنے خداوند اعلیٰ کی رضامندی حاصل کرنے کے لیے دیتا ہے",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6078.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 6079,
      "arabic_text": "وَلَسَوْفَ يَرْضَىٰ",
      "urdu_text": "اور وہ عنقریب خوش ہو جائے گا",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6079.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/092021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/092021.mp3"
    }
  ]
}