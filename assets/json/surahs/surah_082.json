{
  "surah_number": 82,
  "name_arabic": "سُورَةُ الانفِطَارِ",
  "name_english": "Al-Infitaar",
  "name_urdu": "The Cleaving",
  "revelation_type": "Meccan",
  "total_ayahs": 19,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5830,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",
      "urdu_text": "جب آسمان پھٹ جائے گا",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5830.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5831,
      "arabic_text": "وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",
      "urdu_text": "اور جب تارے جھڑ پڑیں گے",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5831.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5832,
      "arabic_text": "وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",
      "urdu_text": "اور جب دریا بہہ (کر ایک دوسرے سے مل) جائیں گے",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5832.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5833,
      "arabic_text": "وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",
      "urdu_text": "اور جب قبریں اکھیڑ دی جائیں گی",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5833.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5834,
      "arabic_text": "عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ",
      "urdu_text": "تب ہر شخص معلوم کرلے گا کہ اس نے آگے کیا بھیجا تھا اور پیچھے کیا چھوڑا تھا",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5834.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5835,
      "arabic_text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",
      "urdu_text": "اے انسان تجھ کو اپنے پروردگار کرم گستر کے باب میں کس چیز نے دھوکا دیا",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5835.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5836,
      "arabic_text": "ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",
      "urdu_text": "(وہی تو ہے) جس نے تجھے بنایا اور (تیرے اعضا کو) ٹھیک کیا اور (تیرے قامت کو) معتدل رکھا",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5836.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5837,
      "arabic_text": "فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ",
      "urdu_text": "اور جس صورت میں چاہا تجھے جوڑ دیا",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5837.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5838,
      "arabic_text": "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",
      "urdu_text": "مگر ہیہات تم لوگ جزا کو جھٹلاتے ہو",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5838.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5839,
      "arabic_text": "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ",
      "urdu_text": "حالانکہ تم پر نگہبان مقرر ہیں",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5839.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5840,
      "arabic_text": "كِرَامًۭا كَٰتِبِينَ",
      "urdu_text": "عالی قدر (تمہاری باتوں کے) لکھنے والے",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5840.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5841,
      "arabic_text": "يَعْلَمُونَ مَا تَفْعَلُونَ",
      "urdu_text": "جو تم کرتے ہو وہ اسے جانتے ہیں",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5841.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5842,
      "arabic_text": "إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ",
      "urdu_text": "بے شک نیکوکار نعمتوں (کی بہشت) میں ہوں گے۔",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5842.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5843,
      "arabic_text": "وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ",
      "urdu_text": "اور بدکردار دوزخ میں",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5843.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5844,
      "arabic_text": "يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ",
      "urdu_text": "(یعنی) جزا کے دن اس میں داخل ہوں گے",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5844.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5845,
      "arabic_text": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَ",
      "urdu_text": "اور اس سے چھپ نہیں سکیں گے",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5845.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5846,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "urdu_text": "اور تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5846.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5847,
      "arabic_text": "ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",
      "urdu_text": "پھر تمہیں کیا معلوم کہ جزا کا دن کیسا ہے؟",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5847.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5848,
      "arabic_text": "يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ",
      "urdu_text": "جس روز کوئی کسی کا بھلا نہ کر سکے گا اور حکم اس روز خدا ہی کا ہو گا",
      "juz": 30,
      "page": 587,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5848.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/082019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/082019.mp3"
    }
  ]
}