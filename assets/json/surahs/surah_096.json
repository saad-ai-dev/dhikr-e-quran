{
  "surah_number": 96,
  "name_arabic": "سُورَةُ العَلَقِ",
  "name_english": "Al-Alaq",
  "name_urdu": "The Clot",
  "revelation_type": "Meccan",
  "total_ayahs": 19,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 6107,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",
      "urdu_text": "(اے محمدﷺ) اپنے پروردگار کا نام لے کر پڑھو جس نے (عالم کو) پیدا کیا",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6107.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 6108,
      "arabic_text": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ",
      "urdu_text": "جس نے انسان کو خون کی پھٹکی سے بنایا",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6108.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 6109,
      "arabic_text": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",
      "urdu_text": "پڑھو اور تمہارا پروردگار بڑا کریم ہے",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6109.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 6110,
      "arabic_text": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",
      "urdu_text": "جس نے قلم کے ذریعے سے علم سکھایا",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6110.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 6111,
      "arabic_text": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ",
      "urdu_text": "اور انسان کو وہ باتیں سکھائیں جس کا اس کو علم نہ تھا",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6111.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 6112,
      "arabic_text": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ",
      "urdu_text": "مگر انسان سرکش ہو جاتا ہے",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6112.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 6113,
      "arabic_text": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",
      "urdu_text": "جب کہ اپنے تیئں غنی دیکھتا ہے",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6113.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 6114,
      "arabic_text": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",
      "urdu_text": "کچھ شک نہیں کہ (اس کو) تمہارے پروردگار ہی کی طرف لوٹ کر جانا ہے",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6114.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 6115,
      "arabic_text": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",
      "urdu_text": "بھلا تم نے اس شخص کو دیکھا جو منع کرتا ہے",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6115.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 6116,
      "arabic_text": "عَبْدًا إِذَا صَلَّىٰٓ",
      "urdu_text": "(یعنی) ایک بندے کو جب وہ نماز پڑھنے لگتا ہے",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6116.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 6117,
      "arabic_text": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",
      "urdu_text": "بھلا دیکھو تو اگر یہ راہِ راست پر ہو",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6117.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 6118,
      "arabic_text": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",
      "urdu_text": "یا پرہیز گاری کا حکم کرے (تو منع کرنا کیسا)",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6118.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 6119,
      "arabic_text": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",
      "urdu_text": "اور دیکھو تو اگر اس نے دین حق کو جھٹلایا اور اس سے منہ موڑا (تو کیا ہوا)",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6119.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 6120,
      "arabic_text": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",
      "urdu_text": "کیااس کو معلوم نہیں کہ خدا دیکھ رہا ہے",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6120.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 6121,
      "arabic_text": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",
      "urdu_text": "دیکھو اگر وہ باز نہ آئے گا تو ہم (اس کی) پیشانی کے بال پکڑ گھسیٹیں گے",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6121.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 6122,
      "arabic_text": "نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ",
      "urdu_text": "یعنی اس جھوٹے خطاکار کی پیشانی کے بال",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6122.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 6123,
      "arabic_text": "فَلْيَدْعُ نَادِيَهُۥ",
      "urdu_text": "تو وہ اپنے یاروں کی مجلس کو بلالے",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6123.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 6124,
      "arabic_text": "سَنَدْعُ ٱلزَّبَانِيَةَ",
      "urdu_text": "ہم بھی اپنے موکلانِ دوزخ کو بلا لیں گے",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6124.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 6125,
      "arabic_text": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",
      "urdu_text": "دیکھو اس کا کہا نہ ماننا اور قربِ (خدا) حاصل کرتے رہنا",
      "juz": 30,
      "page": 597,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6125.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/096019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/096019.mp3"
    }
  ]
}