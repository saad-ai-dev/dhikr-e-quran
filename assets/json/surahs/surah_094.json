    },
    {
      "ayah_number": 4,
      "global_number": 6094,
      "arabic_text": "وَرَفَعْنَا لَكَ ذِكْرَكَ",
      "urdu_text": "اور تمہارا ذکر بلند کیا",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6094.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/094004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/094004.mp3"
    },
    {
      "ayah_number": 5,
