    },
    {
      "ayah_number": 3,
      "global_number": 6093,
      "arabic_text": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ",
      "urdu_text": "جس نے تمہاری پیٹھ توڑ رکھی تھی",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6093.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/094003.mp3",
