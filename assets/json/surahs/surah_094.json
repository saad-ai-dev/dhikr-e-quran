  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 6091,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ",
      "urdu_text": "(اے محمدﷺ) کیا ہم نے تمہارا سینہ کھول نہیں دیا؟ (بےشک کھول دیا)",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6091.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/094001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/094001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 6092,
      "arabic_text": "وَوَضَعْنَا عَنكَ وِزْرَكَ",
      "urdu_text": "اور تم پر سے بوجھ بھی اتار دیا",
      "juz": 30,
      "page": 596,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/6092.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/094002.mp3",
