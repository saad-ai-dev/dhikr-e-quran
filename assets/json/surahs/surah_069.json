{
  "surah_number": 69,
  "name_arabic": "سُورَةُ الحَاقَّةِ",
  "name_english": "Al-Haaqqa",
  "name_urdu": "The Reality",
  "revelation_type": "Meccan",
  "total_ayahs": 52,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5324,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْحَآقَّةُ",
      "urdu_text": "سچ مچ ہونے والی",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5324.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5325,
      "arabic_text": "مَا ٱلْحَآقَّةُ",
      "urdu_text": "وہ سچ مچ ہونے والی کیا ہے؟",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5325.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5326,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ",
      "urdu_text": "اور تم کو کیا معلوم ہے کہ سچ مچ ہونے والی کیا ہے؟",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5326.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5327,
      "arabic_text": "كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ",
      "urdu_text": "کھڑکھڑانے والی (جس) کو ثمود اور عاد (دونوں) نے جھٹلایا",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5327.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5328,
      "arabic_text": "فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ",
      "urdu_text": "سو ثمود تو کڑک سے ہلاک کردیئے گئے",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5328.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5329,
      "arabic_text": "وَأَمَّا عَادٌۭ فَأُهْلِكُوا۟ بِرِيحٍۢ صَرْصَرٍ عَاتِيَةٍۢ",
      "urdu_text": "رہے عاد تو ان کا نہایت تیز آندھی سے ستیاناس کردیا گیا",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5329.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5330,
      "arabic_text": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍۢ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًۭا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍۢ",
      "urdu_text": "خدا نے اس کو سات رات اور آٹھ دن لگاتار ان پر چلائے رکھا تو (اے مخاطب) تو لوگوں کو اس میں (اس طرح) ڈھئے (اور مرے) پڑے دیکھے جیسے کھجوروں کے کھوکھلے تنے",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5330.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5331,
      "arabic_text": "فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍۢ",
      "urdu_text": "بھلا تو ان میں سے کسی کو بھی باقی دیکھتا ہے؟",
      "juz": 29,
      "page": 566,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5331.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5332,
      "arabic_text": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ",
      "urdu_text": "اور فرعون اور جو لوگ اس سے پہلے تھے اور وہ جو الٹی بستیوں میں رہتے تھے سب گناہ کے کام کرتے تھے",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5332.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5333,
      "arabic_text": "فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةًۭ رَّابِيَةً",
      "urdu_text": "انہوں نے اپنے پروردگار کے پیغمبر کی نافرمانی کی تو خدا نے بھی ان کو بڑا سخت پکڑا",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5333.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5334,
      "arabic_text": "إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ",
      "urdu_text": "جب پانی طغیانی پر آیا تو ہم نے تم (لوگوں) کو کشتی میں سوار کرلیا",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5334.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5335,
      "arabic_text": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةًۭ وَتَعِيَهَآ أُذُنٌۭ وَٰعِيَةٌۭ",
      "urdu_text": "تاکہ اس کو تمہارے لئے یادگار بنائیں اور یاد رکھنے والے کان اسے یاد رکھیں",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5335.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5336,
      "arabic_text": "فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌۭ وَٰحِدَةٌۭ",
      "urdu_text": "تو جب صور میں ایک (بار) پھونک مار دی جائے گی",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5336.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5337,
      "arabic_text": "وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةًۭ وَٰحِدَةًۭ",
      "urdu_text": "اور زمین اور پہاڑ دونوں اٹھا لئے جائیں گے۔ پھر ایک بارگی توڑ پھوڑ کر برابر کردیئے جائیں گے",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5337.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5338,
      "arabic_text": "فَيَوْمَئِذٍۢ وَقَعَتِ ٱلْوَاقِعَةُ",
      "urdu_text": "تو اس روز ہو پڑنے والی (یعنی قیامت) ہو پڑے گی",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5338.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5339,
      "arabic_text": "وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍۢ وَاهِيَةٌۭ",
      "urdu_text": "اور آسمان پھٹ جائے گا تو وہ اس دن کمزور ہوگا",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5339.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5340,
      "arabic_text": "وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍۢ ثَمَٰنِيَةٌۭ",
      "urdu_text": "اور فرشتے اس کے کناروں پر (اُتر آئیں گے) اور تمہارے پروردگار کے عرش کو اس روز آٹھ فرشتے اپنے سروں پر اُٹھائے ہوں گے",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5340.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5341,
      "arabic_text": "يَوْمَئِذٍۢ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌۭ",
      "urdu_text": "اس روز تم (سب لوگوں کے سامنے) پیش کئے جاؤ گے اور تمہاری کوئی پوشیدہ بات چھپی نہ رہے گی",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5341.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5342,
      "arabic_text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَٰبِيَهْ",
      "urdu_text": "تو جس کا (اعمال) نامہ اس کے داہنے ہاتھ میں دیا جائے گا وہ (دوسروں سے) کہے گا کہ لیجیئے میرا نامہ (اعمال) پڑھیئے",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5342.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5343,
      "arabic_text": "إِنِّى ظَنَنتُ أَنِّى مُلَٰقٍ حِسَابِيَهْ",
      "urdu_text": "مجھے یقین تھا کہ مجھ کو میرا حساب (کتاب) ضرور ملے گا",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5343.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5344,
      "arabic_text": "فَهُوَ فِى عِيشَةٍۢ رَّاضِيَةٍۢ",
      "urdu_text": "پس وہ (شخص) من مانے عیش میں ہوگا",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5344.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5345,
      "arabic_text": "فِى جَنَّةٍ عَالِيَةٍۢ",
      "urdu_text": "(یعنی) اونچے (اونچے محلوں) کے باغ میں",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5345.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5346,
      "arabic_text": "قُطُوفُهَا دَانِيَةٌۭ",
      "urdu_text": "جن کے میوے جھکے ہوئے ہوں گے",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5346.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5347,
      "arabic_text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ",
      "urdu_text": "جو (عمل) تم ایام گزشتہ میں آگے بھیج چکے ہو اس کے صلے میں مزے سے کھاؤ اور پیو",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5347.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5348,
      "arabic_text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِى لَمْ أُوتَ كِتَٰبِيَهْ",
      "urdu_text": "اور جس کا نامہ (اعمال) اس کے بائیں ہاتھ میں یاد جائے گا وہ کہے گا اے کاش مجھ کو میرا (اعمال) نامہ نہ دیا جاتا",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5348.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 5349,
      "arabic_text": "وَلَمْ أَدْرِ مَا حِسَابِيَهْ",
      "urdu_text": "اور مجھے معلوم نہ ہو کہ میرا حساب کیا ہے",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5349.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 5350,
      "arabic_text": "يَٰلَيْتَهَا كَانَتِ ٱلْقَاضِيَةَ",
      "urdu_text": "اے کاش موت (ابد الاآباد کے لئے میرا کام) تمام کرچکی ہوتی",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5350.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 5351,
      "arabic_text": "مَآ أَغْنَىٰ عَنِّى مَالِيَهْ ۜ",
      "urdu_text": "آج) میرا مال میرے کچھ بھی کام بھی نہ آیا",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5351.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 5352,
      "arabic_text": "هَلَكَ عَنِّى سُلْطَٰنِيَهْ",
      "urdu_text": "(ہائے) میری سلطنت خاک میں مل گئی",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5352.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 5353,
      "arabic_text": "خُذُوهُ فَغُلُّوهُ",
      "urdu_text": "(حکم ہوگا کہ) اسے پکڑ لو اور طوق پہنا دو",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5353.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069030.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069030.mp3"
    },
    {
      "ayah_number": 31,
      "global_number": 5354,
      "arabic_text": "ثُمَّ ٱلْجَحِيمَ صَلُّوهُ",
      "urdu_text": "پھر دوزخ کی آگ میں جھونک دو",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5354.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069031.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069031.mp3"
    },
    {
      "ayah_number": 32,
      "global_number": 5355,
      "arabic_text": "ثُمَّ فِى سِلْسِلَةٍۢ ذَرْعُهَا سَبْعُونَ ذِرَاعًۭا فَٱسْلُكُوهُ",
      "urdu_text": "پھر زنجیر سے جس کی ناپ ستر گز ہے جکڑ دو",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5355.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069032.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069032.mp3"
    },
    {
      "ayah_number": 33,
      "global_number": 5356,
      "arabic_text": "إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ",
      "urdu_text": "یہ نہ تو خدائے جل شانہ پر ایمان لاتا تھا",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5356.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069033.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069033.mp3"
    },
    {
      "ayah_number": 34,
      "global_number": 5357,
      "arabic_text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "urdu_text": "اور نہ فقیر کے کھانا کھلانے پر آمادہ کرتا تھا",
      "juz": 29,
      "page": 567,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5357.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069034.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069034.mp3"
    },
    {
      "ayah_number": 35,
      "global_number": 5358,
      "arabic_text": "فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌۭ",
      "urdu_text": "سو آج اس کا بھی یہاں کوئی دوستدار نہیں",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5358.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069035.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069035.mp3"
    },
    {
      "ayah_number": 36,
      "global_number": 5359,
      "arabic_text": "وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍۢ",
      "urdu_text": "اور نہ پیپ کے سوا (اس کے لئے) کھانا ہے",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5359.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069036.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069036.mp3"
    },
    {
      "ayah_number": 37,
      "global_number": 5360,
      "arabic_text": "لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ",
      "urdu_text": "جس کو گنہگاروں کے سوا کوئی نہیں کھائے گا",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5360.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069037.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069037.mp3"
    },
    {
      "ayah_number": 38,
      "global_number": 5361,
      "arabic_text": "فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ",
      "urdu_text": "تو ہم کو ان چیزوں کی قسم جو تم کو نظر آتی ہیں",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5361.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069038.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069038.mp3"
    },
    {
      "ayah_number": 39,
      "global_number": 5362,
      "arabic_text": "وَمَا لَا تُبْصِرُونَ",
      "urdu_text": "اور ان کی جو نظر میں نہیں آتیں",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5362.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069039.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069039.mp3"
    },
    {
      "ayah_number": 40,
      "global_number": 5363,
      "arabic_text": "إِنَّهُۥ لَقَوْلُ رَسُولٍۢ كَرِيمٍۢ",
      "urdu_text": "کہ یہ (قرآن) فرشتہٴ عالی مقام کی زبان کا پیغام ہے",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5363.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069040.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069040.mp3"
    },
    {
      "ayah_number": 41,
      "global_number": 5364,
      "arabic_text": "وَمَا هُوَ بِقَوْلِ شَاعِرٍۢ ۚ قَلِيلًۭا مَّا تُؤْمِنُونَ",
      "urdu_text": "اور یہ کسی شاعر کا کلام نہیں۔ مگر تم لوگ بہت ہی کم ایمان لاتے ہو",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5364.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069041.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069041.mp3"
    },
    {
      "ayah_number": 42,
      "global_number": 5365,
      "arabic_text": "وَلَا بِقَوْلِ كَاهِنٍۢ ۚ قَلِيلًۭا مَّا تَذَكَّرُونَ",
      "urdu_text": "اور نہ کسی کاہن کے مزخرفات ہیں۔ لیکن تم لوگ بہت ہی کم فکر کرتے ہو",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5365.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069042.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069042.mp3"
    },
    {
      "ayah_number": 43,
      "global_number": 5366,
      "arabic_text": "تَنزِيلٌۭ مِّن رَّبِّ ٱلْعَٰلَمِينَ",
      "urdu_text": "یہ تو) پروردگار عالم کا اُتارا (ہوا) ہے",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5366.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069043.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069043.mp3"
    },
    {
      "ayah_number": 44,
      "global_number": 5367,
      "arabic_text": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ",
      "urdu_text": "اگر یہ پیغمبر ہماری نسبت کوئی بات جھوٹ بنا لاتے",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5367.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069044.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069044.mp3"
    },
    {
      "ayah_number": 45,
      "global_number": 5368,
      "arabic_text": "لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ",
      "urdu_text": "تو ہم ان کا داہنا ہاتھ پکڑ لیتے",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5368.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069045.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069045.mp3"
    },
    {
      "ayah_number": 46,
      "global_number": 5369,
      "arabic_text": "ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ",
      "urdu_text": "پھر ان کی رگ گردن کاٹ ڈالتے",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5369.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069046.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069046.mp3"
    },
    {
      "ayah_number": 47,
      "global_number": 5370,
      "arabic_text": "فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ",
      "urdu_text": "پھر تم میں سے کوئی (ہمیں) اس سے روکنے والا نہ ہوتا",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5370.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069047.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069047.mp3"
    },
    {
      "ayah_number": 48,
      "global_number": 5371,
      "arabic_text": "وَإِنَّهُۥ لَتَذْكِرَةٌۭ لِّلْمُتَّقِينَ",
      "urdu_text": "اور یہ (کتاب) تو پرہیزگاروں کے لئے نصیحت ہے",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5371.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069048.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069048.mp3"
    },
    {
      "ayah_number": 49,
      "global_number": 5372,
      "arabic_text": "وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ",
      "urdu_text": "اور ہم جانتے ہیں کہ تم میں سے بعض اس کو جھٹلانے والے ہیں",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5372.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069049.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069049.mp3"
    },
    {
      "ayah_number": 50,
      "global_number": 5373,
      "arabic_text": "وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ",
      "urdu_text": "نیز یہ کافروں کے لئے (موجب) حسرت ہے",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5373.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069050.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069050.mp3"
    },
    {
      "ayah_number": 51,
      "global_number": 5374,
      "arabic_text": "وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ",
      "urdu_text": "اور کچھ شک نہیں کہ یہ برحق قابل یقین ہے",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5374.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069051.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069051.mp3"
    },
    {
      "ayah_number": 52,
      "global_number": 5375,
      "arabic_text": "فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ",
      "urdu_text": "سو تم اپنے پروردگار عزوجل کے نام کی تنزیہ کرتے رہو",
      "juz": 29,
      "page": 568,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5375.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/069052.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/069052.mp3"
    }
