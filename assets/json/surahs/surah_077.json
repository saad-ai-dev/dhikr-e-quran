    },
    {
      "ayah_number": 35,
      "global_number": 5657,
      "arabic_text": "هَٰذَا يَوْمُ لَا يَنطِقُونَ",
      "urdu_text": "یہ وہ دن ہے کہ (لوگ) لب تک نہ ہلا سکیں گے",
