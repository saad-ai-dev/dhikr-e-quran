    },
    {
      "ayah_number": 39,
      "global_number": 5661,
      "arabic_text": "فَإِن كَانَ لَكُمْ كَيْدٌۭ فَكِيدُونِ",
      "urdu_text": "اگر تم کو کوئی داؤں آتا ہو تو مجھ سے کر لو",
      "juz": 29,
