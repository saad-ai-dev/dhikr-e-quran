{
  "surah_number": 77,
  "name_arabic": "سُورَةُ المُرۡسَلَاتِ",
  "name_english": "Al-Mursalaat",
  "name_urdu": "The Emissaries",
  "revelation_type": "Meccan",
  "total_ayahs": 50,
  "ayahs": [
    {
      "ayah_number": 1,
      "global_number": 5623,
      "arabic_text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلْمُرْسَلَٰتِ عُرْفًۭا",
      "urdu_text": "ہواؤں کی قسم جو نرم نرم چلتی ہیں",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5623.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077001.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077001.mp3"
    },
    {
      "ayah_number": 2,
      "global_number": 5624,
      "arabic_text": "فَٱلْعَٰصِفَٰتِ عَصْفًۭا",
      "urdu_text": "پھر زور پکڑ کر جھکڑ ہو جاتی ہیں",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5624.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077002.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077002.mp3"
    },
    {
      "ayah_number": 3,
      "global_number": 5625,
      "arabic_text": "وَٱلنَّٰشِرَٰتِ نَشْرًۭا",
      "urdu_text": "اور (بادلوں کو) پھاڑ کر پھیلا دیتی ہیں",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5625.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077003.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077003.mp3"
    },
    {
      "ayah_number": 4,
      "global_number": 5626,
      "arabic_text": "فَٱلْفَٰرِقَٰتِ فَرْقًۭا",
      "urdu_text": "پھر ان کو پھاڑ کر جدا جدا کر دیتی ہیں",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5626.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077004.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077004.mp3"
    },
    {
      "ayah_number": 5,
      "global_number": 5627,
      "arabic_text": "فَٱلْمُلْقِيَٰتِ ذِكْرًا",
      "urdu_text": "پھر فرشتوں کی قسم جو وحی لاتے ہیں",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5627.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077005.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077005.mp3"
    },
    {
      "ayah_number": 6,
      "global_number": 5628,
      "arabic_text": "عُذْرًا أَوْ نُذْرًا",
      "urdu_text": "تاکہ عذر (رفع) کردیا جائے یا ڈر سنا دیا جائے",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5628.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077006.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077006.mp3"
    },
    {
      "ayah_number": 7,
      "global_number": 5629,
      "arabic_text": "إِنَّمَا تُوعَدُونَ لَوَٰقِعٌۭ",
      "urdu_text": "کہ جس بات کا تم سے وعدہ کیا جاتا ہے وہ ہو کر رہے گی",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5629.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077007.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077007.mp3"
    },
    {
      "ayah_number": 8,
      "global_number": 5630,
      "arabic_text": "فَإِذَا ٱلنُّجُومُ طُمِسَتْ",
      "urdu_text": "جب تاروں کی چمک جاتی رہے",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5630.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077008.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077008.mp3"
    },
    {
      "ayah_number": 9,
      "global_number": 5631,
      "arabic_text": "وَإِذَا ٱلسَّمَآءُ فُرِجَتْ",
      "urdu_text": "اور جب آسمان پھٹ جائے",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5631.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077009.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077009.mp3"
    },
    {
      "ayah_number": 10,
      "global_number": 5632,
      "arabic_text": "وَإِذَا ٱلْجِبَالُ نُسِفَتْ",
      "urdu_text": "اور جب پہاڑ اُڑے اُڑے پھریں",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5632.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077010.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077010.mp3"
    },
    {
      "ayah_number": 11,
      "global_number": 5633,
      "arabic_text": "وَإِذَا ٱلرُّسُلُ أُقِّتَتْ",
      "urdu_text": "اور جب پیغمبر فراہم کئے جائیں",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5633.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077011.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077011.mp3"
    },
    {
      "ayah_number": 12,
      "global_number": 5634,
      "arabic_text": "لِأَىِّ يَوْمٍ أُجِّلَتْ",
      "urdu_text": "بھلا (ان امور میں) تاخیر کس دن کے لئے کی گئی؟",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5634.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077012.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077012.mp3"
    },
    {
      "ayah_number": 13,
      "global_number": 5635,
      "arabic_text": "لِيَوْمِ ٱلْفَصْلِ",
      "urdu_text": "فیصلے کے دن کے لئے",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5635.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077013.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077013.mp3"
    },
    {
      "ayah_number": 14,
      "global_number": 5636,
      "arabic_text": "وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلْفَصْلِ",
      "urdu_text": "اور تمہیں کیا خبر کہ فیصلے کا دن کیا ہے؟",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5636.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077014.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077014.mp3"
    },
    {
      "ayah_number": 15,
      "global_number": 5637,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "urdu_text": "اس دن جھٹلانے والوں کے لئے خرابی ہے",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5637.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077015.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077015.mp3"
    },
    {
      "ayah_number": 16,
      "global_number": 5638,
      "arabic_text": "أَلَمْ نُهْلِكِ ٱلْأَوَّلِينَ",
      "urdu_text": "کیا ہم نے پہلے لوگوں کو ہلاک نہیں کر ڈالا",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5638.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077016.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077016.mp3"
    },
    {
      "ayah_number": 17,
      "global_number": 5639,
      "arabic_text": "ثُمَّ نُتْبِعُهُمُ ٱلْءَاخِرِينَ",
      "urdu_text": "پھر ان پچھلوں کو بھی ان کے پیچھے بھیج دیتے ہیں",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5639.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077017.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077017.mp3"
    },
    {
      "ayah_number": 18,
      "global_number": 5640,
      "arabic_text": "كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",
      "urdu_text": "ہم گنہگاروں کے ساتھ ایسا ہی کیا کرتے ہیں",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5640.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077018.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077018.mp3"
    },
    {
      "ayah_number": 19,
      "global_number": 5641,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "urdu_text": "اس دن جھٹلانے والوں کی خرابی ہے",
      "juz": 29,
      "page": 580,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5641.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077019.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077019.mp3"
    },
    {
      "ayah_number": 20,
      "global_number": 5642,
      "arabic_text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍۢ مَّهِينٍۢ",
      "urdu_text": "کیا ہم نے تم کو حقیر پانی سے نہیں پیدا کیا؟",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5642.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077020.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077020.mp3"
    },
    {
      "ayah_number": 21,
      "global_number": 5643,
      "arabic_text": "فَجَعَلْنَٰهُ فِى قَرَارٍۢ مَّكِينٍ",
      "urdu_text": "اس کو ایک محفوظ جگہ میں رکھا",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5643.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077021.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077021.mp3"
    },
    {
      "ayah_number": 22,
      "global_number": 5644,
      "arabic_text": "إِلَىٰ قَدَرٍۢ مَّعْلُومٍۢ",
      "urdu_text": "ایک وقت معین تک",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5644.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077022.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077022.mp3"
    },
    {
      "ayah_number": 23,
      "global_number": 5645,
      "arabic_text": "فَقَدَرْنَا فَنِعْمَ ٱلْقَٰدِرُونَ",
      "urdu_text": "پھر اندازہ مقرر کیا اور ہم کیا ہی خوب اندازہ مقرر کرنے والے ہیں",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5645.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077023.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077023.mp3"
    },
    {
      "ayah_number": 24,
      "global_number": 5646,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "urdu_text": "اس دن جھٹلانے والوں کی خرابی ہے",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5646.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077024.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077024.mp3"
    },
    {
      "ayah_number": 25,
      "global_number": 5647,
      "arabic_text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
      "urdu_text": "کیا ہم نے زمین کو سمیٹنے والی نہیں بنایا",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5647.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077025.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077025.mp3"
    },
    {
      "ayah_number": 26,
      "global_number": 5648,
      "arabic_text": "أَحْيَآءًۭ وَأَمْوَٰتًۭا",
      "urdu_text": "یعنی) زندوں اور مردوں کو",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5648.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077026.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077026.mp3"
    },
    {
      "ayah_number": 27,
      "global_number": 5649,
      "arabic_text": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَٰمِخَٰتٍۢ وَأَسْقَيْنَٰكُم مَّآءًۭ فُرَاتًۭا",
      "urdu_text": "(بنایا) اور اس پر اونچے اونچے پہاڑ رکھ دیئے اور تم لوگوں کو میٹھا پانی پلایا",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5649.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077027.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077027.mp3"
    },
    {
      "ayah_number": 28,
      "global_number": 5650,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "urdu_text": "اس دن جھٹلانے والوں کی خرابی ہے",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5650.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077028.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077028.mp3"
    },
    {
      "ayah_number": 29,
      "global_number": 5651,
      "arabic_text": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
      "urdu_text": "جس چیز کو تم جھٹلایا کرتے تھے۔ (اب) اس کی طرف چلو",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5651.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077029.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077029.mp3"
    },
    {
      "ayah_number": 30,
      "global_number": 5652,
      "arabic_text": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّۢ ذِى ثَلَٰثِ شُعَبٍۢ",
      "urdu_text": "(یعنی) اس سائے کی طرف چلو جس کی تین شاخیں ہیں",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5652.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077030.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077030.mp3"
    },
    {
      "ayah_number": 31,
      "global_number": 5653,
      "arabic_text": "لَّا ظَلِيلٍۢ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
      "urdu_text": "نہ ٹھنڈی چھاؤں اور نہ لپٹ سے بچاؤ",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5653.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077031.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077031.mp3"
    },
    {
      "ayah_number": 32,
      "global_number": 5654,
