      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5657.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077035.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077035.mp3"
    },
    {
      "ayah_number": 36,
