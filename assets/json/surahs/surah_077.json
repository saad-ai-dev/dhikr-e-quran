      "urdu_text": "اس سے (آگ کی اتنی اتنی بڑی) چنگاریاں اُڑتی ہیں جیسے محل",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5654.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077032.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077032.mp3"
    },
    {
      "ayah_number": 33,
      "global_number": 5655,
      "arabic_text": "كَأَنَّهُۥ جِمَٰلَتٌۭ صُفْرٌۭ",
      "urdu_text": "گویا زرد رنگ کے اونٹ ہیں",
      "juz": 29,
      "page": 581,
      "audio_primary": "https://cdn.islamic.network/quran/audio/128/ar.alafasy/5655.mp3",
      "audio_fallback": "https://everyayah.com/data/Alafasy_128kbps/077033.mp3",
      "urdu_audio": "https://everyayah.com/data/translations/urdu_shamshad_ali_khan_46kbps/077033.mp3"
    },
    {
      "ayah_number": 34,
      "global_number": 5656,
      "arabic_text": "وَيْلٌۭ يَوْمَئِذٍۢ لِّلْمُكَذِّبِينَ",
      "urdu_text": "اس دن جھٹلانے والوں کی خرابی ہے",
